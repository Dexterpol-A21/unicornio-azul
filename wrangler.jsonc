{
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "account_id": "ab94a1ceb1cd8997bd32af567ef187bd",
  "name": "unicornio-azul",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "SESSION", "id": "4c18e006083a476ca26d55a607c00e3d" }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  }
}
