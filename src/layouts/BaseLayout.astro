---
import SEO from '@components/global/SEO.astro';
import Header from '@components/global/Header.astro';
import '../styles/global.css';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  showHeader?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  showHeader = false,
  noindex = false,
} = Astro.props;
const locale = getLangFromUrl(Astro.url);
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <SEO {title} {description} {image} {imageAlt} {noindex} lang={locale} url={Astro.url} />
</head>
<body class:list={[{ "has-header": showHeader }]}>
  {showHeader && <Header lang={locale} />}
  <main>
    <slot />
  </main>
</body>
</html>
