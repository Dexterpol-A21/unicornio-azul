---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { type Lang } from '../../i18n/ui';
import { getAltLangUrl, useTranslations } from '../../i18n/utils';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  lang: Lang;
  url: URL;
  noindex?: boolean;
  altUrl?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  section?: string;
}

const {
  title,
  description,
  image = '/images/og-default.jpg',
  imageAlt,
  lang,
  url,
  noindex = false,
  altUrl,
  type = 'website',
  publishedTime,
  section,
} = Astro.props;

const { t } = useTranslations(lang);
const siteName = t('seo.site_name');
const ogLocale = t('seo.og_locale');
const siteOrigin = Astro.site?.origin ?? url.origin;

const altLocale: Lang = lang === 'es' ? 'en' : 'es';
const currentPath = url.pathname.replace(/^\/(es|en)(\/|$)/, '/$2').replace(/^\/\//, '/') || '/';
const canonicalPath = getRelativeLocaleUrl(lang, currentPath);

const toAbs = (path: string) => new URL(path, siteOrigin).href;
const canonicalHref = toAbs(canonicalPath);
const alternateHref = altUrl ? toAbs(altUrl) : toAbs(getAltLangUrl(url, altLocale));
const xDefaultHref = altUrl && lang === 'en' ? toAbs(altUrl) : (lang === 'es' ? canonicalHref : toAbs(getAltLangUrl(url, 'es')));
const imageHref = toAbs(image);
const resolvedImageAlt = imageAlt ?? title;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta charset="UTF-8" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0F2548" media="(prefers-color-scheme: dark)" />
<meta name="color-scheme" content="light" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content={siteName} />
<meta name="format-detection" content="telephone=no" />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:url" content={canonicalHref} />
{type === 'article' && publishedTime && (
  <>
    <meta property="article:published_time" content={publishedTime} />
    <meta property="article:modified_time" content={publishedTime} />
    {section && <meta property="article:section" content={section} />}
  </>
)}

<!-- Canonical -->
<link rel="canonical" href={canonicalHref} />

<!-- hreflang — usa ROUTE_MAP (rutas traducidas reales) -->
<link rel="alternate" hreflang={lang} href={canonicalHref} />
<link rel="alternate" hreflang={altLocale} href={alternateHref} />
<link rel="alternate" hreflang="x-default" href={xDefaultHref} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageHref} />

<!-- OG Image -->
<meta property="og:image" content={imageHref} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={resolvedImageAlt} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Brand fonts (self-hosted) -->
<link rel="preload" href="/fonts/satoshi/satoshi-400.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/satoshi/satoshi-700.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/space-grotesk/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />

<!-- Secondary fonts (proposals / occasional use only) -->
<link rel="preconnect" href="https://api.fontshare.com" crossorigin />
<link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@400,500,700,800&f[]=switzer@400,500,600,700&display=swap" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&family=Space+Mono:wght@400;700&display=swap"
/>
