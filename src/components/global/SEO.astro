---
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import { type Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props {
  title: string;
  description: string;
  image?: string;
  lang: Lang;
  url: URL;
}

const {
  title,
  description,
  image = '/images/og-default.jpg',
  lang,
  url,
} = Astro.props;

const { t } = useTranslations(lang);
const siteName = t('seo.site_name');
const ogLocale = t('seo.og_locale');

const altLocale: Lang = lang === 'es' ? 'en' : 'es';
const currentPath = url.pathname.replace(/^\/(es|en)(\/|$)/, '/$2').replace(/^\/\//, '/') || '/';
const canonicalPath = getRelativeLocaleUrl(lang, currentPath);
const alternatePath = getAbsoluteLocaleUrl(altLocale, currentPath);
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta charset="UTF-8" />

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={ogLocale} />

<!-- Canonical -->
<link rel="canonical" href={new URL(canonicalPath, Astro.url.origin).href} />

<!-- hreflang -->
<link rel="alternate" hreflang={lang} href={new URL(canonicalPath, Astro.url.origin).href} />
<link rel="alternate" hreflang={altLocale} href={alternatePath} />
<link rel="alternate" hreflang="x-default" href={new URL(getRelativeLocaleUrl('es', currentPath), Astro.url.origin).href} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.url.origin).href} />

<!-- OG Image -->
<meta property="og:image" content={new URL(image, Astro.url.origin).href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Brand fonts (self-hosted) -->
<link rel="preload" href="/fonts/satoshi/satoshi-400.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/satoshi/satoshi-700.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/space-grotesk/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />

<!-- Secondary fonts (proposals / occasional use only) -->
<link rel="preconnect" href="https://api.fontshare.com" crossorigin />
<link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@400,500,700,800&f[]=switzer@400,500,600,700&display=swap" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&family=Space+Mono:wght@400;700&display=swap"
/>
