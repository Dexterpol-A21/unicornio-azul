<style>
  .shadow-float {
    box-shadow:
      0 2px 16px -4px rgba(0,0,0,0.06),
      0 4px 32px -8px rgba(0,0,0,0.04);
  }

  .nav-link {
    color: #163667;
    transition: color 0.25s ease, background-color 0.25s ease;
  }
  .nav-link:hover {
    background-color: #163667;
    color: #ffffff;
  }

  .nav-link-trigger {
    color: #163667;
    background-color: transparent;
    transition: color 0.25s ease, background-color 0.35s ease;
  }
  .group\/qh:hover .nav-link-trigger,
  .group\/ct:hover .nav-link-trigger,
  .group\/sn:hover .nav-link-trigger {
    background-color: #163667;
    color: #ffffff;
  }

  .mega-panel {
    transform: translateX(-50%) scaleY(0);
    transform-origin: top center;
    transition: opacity 0.35s ease, pointer-events 0s 0.35s, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .group\/qh:hover .mega-panel {
    transform: translateX(-50%) scaleY(1);
    transition: opacity 0.25s ease, pointer-events 0s 0s, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .medium-panel {
    transform: translateX(-50%) scaleY(0);
    transform-origin: top center;
    transition: opacity 0.35s ease, pointer-events 0s 0.35s, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .group\/ct:hover .medium-panel,
  .group\/sn:hover .medium-panel {
    transform: translateX(-50%) scaleY(1);
    transition: opacity 0.25s ease, pointer-events 0s 0s, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mega-card {
    box-shadow: 0 0 0 0 transparent;
    transition: box-shadow 0.35s ease, background-color 0.35s ease;
  }
  .mega-card:hover {
    box-shadow: 0 6px 20px -6px rgba(22,54,103,0.15);
    background-color: rgb(var(--card-r), var(--card-g), var(--card-b));
  }
  .mega-card.ct-proceso:hover {
    background: linear-gradient(to right, #0F2548 0%, #0F2548 20%, #163667 20%, #163667 40%, #0B4F7A 40%, #0B4F7A 60%, #00698D 60%, #00698D 80%, #0088B3 80%, #0088B3 100%);
  }
  .mega-card.ct-sorie:hover {
    background: linear-gradient(135deg, #0F2548, #163667, #0B4F7A, #00698D, #0088B3);
  }
  /* Base colours via custom properties */
  .mega-title { color: var(--mc); transition: color 0.35s ease; }
  .mega-desc  { color: var(--mdc); transition: color 0.35s ease; }
  /* Hover */
  .mega-card:hover .mega-title { color: #ffffff; }
  .mega-card:hover .mega-desc  { color: rgba(255,255,255,0.75); }
  .mega-card:hover .mega-icon {
    background-color: rgba(255,255,255,0.15) !important;
  }
  .mega-card:hover .mega-icon svg {
    fill: #ffffff !important;
  }
  .mega-card:hover .mega-icon svg * {
    fill: #ffffff !important;
    opacity: 1 !important;
  }
  .mega-card:hover img:not(.no-hover-invert) {
    filter: brightness(0) invert(1);
    opacity: 1 !important;
  }
  .mega-svg { stroke: var(--ms); }
  .mega-card svg { transition: stroke 0.35s ease; }
  .mega-card:hover svg:not(.hover-preserve) {
    stroke: #ffffff;
  }
</style>

<style is:global>
  .bottom-nav-item {
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .bottom-nav-item:active {
    background: rgba(22,54,103,0.06);
  }

  .mb-quad {
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.2s ease;
  }
  .mb-quad:active {
    filter: brightness(0.94);
  }

  .mb-dropdown.open {
    pointer-events: auto !important;
    opacity: 1 !important;
  }
  #mb-backdrop.open {
    pointer-events: auto !important;
    opacity: 1 !important;
  }
</style>

<script>
  (function () {
    const triggers = document.querySelectorAll('[data-mb-trigger]');
    const backdrop = document.getElementById('mb-backdrop');
    let activePanel: HTMLElement | null = null;
    let activeTrigger: Element | null = null;

    function closeAll() {
      document.querySelectorAll('.mb-dropdown.open').forEach(el => el.classList.remove('open'));
      if (backdrop) backdrop.classList.remove('open');
      activePanel = null;
      activeTrigger = null;
    }

    triggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const id = (btn as HTMLElement).dataset.mbTrigger;
        const panel = document.getElementById('mb-panel-' + id);

        if (activePanel === panel) {
          closeAll();
          return;
        }

        closeAll();

        if (panel) {
          panel.classList.add('open');
          if (backdrop) backdrop.classList.add('open');
          activePanel = panel;
          activeTrigger = btn;
        }
      });
    });

    if (backdrop) {
      backdrop.addEventListener('click', closeAll);
    }

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (activePanel && !activePanel.contains(target) && target !== activeTrigger && !activeTrigger?.contains(target)) {
        closeAll();
      }
    });
  })();
</script>
