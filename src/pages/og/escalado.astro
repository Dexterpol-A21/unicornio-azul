<!-- OG Image: Escalado Internacional — Pirámides + Trendline -->
<style>html,body{margin:0;padding:0;overflow:hidden}</style>
<div style="
  width:1200px;height:630px;overflow:hidden;position:relative;
  background:#00698D;
