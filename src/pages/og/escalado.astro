      <rect x="0" y="0" width="60" height="15" rx="6" fill="#00698D" opacity="0.1" />
      <circle cx="10" cy="7.5" r="3" fill="#00698D" />
      <rect x="8" y="22" width="44" height="20" rx="3" fill="#00698D" opacity="0.2" />
      <rect x="8" y="48" width="30" height="4" rx="2" fill="#00698D" opacity="0.4" />
      <rect x="8" y="56" width="20" height="4" rx="2" fill="#00698D" opacity="0.2" />
    </g>
    <g transform="translate(260, 295)">
      <rect x="0" y="0" width="70" height="50" rx="6" fill="#ffffff" opacity="0.95" stroke="#ffffff" stroke-width="1.5" />
      <rect x="8" y="8" width="14" height="14" rx="2" fill="#00698D" opacity="0.6" />
      <rect x="28" y="8" width="14" height="14" rx="2" fill="#00698D" opacity="0.4" />
      <rect x="48" y="8" width="14" height="14" rx="2" fill="#00698D" opacity="0.2" />
      <rect x="8" y="28" width="14" height="14" rx="2" fill="#00698D" opacity="0.2" />
      <rect x="28" y="28" width="14" height="14" rx="2" fill="#00698D" opacity="0.6" />
      <rect x="48" y="28" width="14" height="14" rx="2" fill="#00698D" opacity="0.4" />
    </g>
    <g transform="translate(360, 30)">
      <rect x="0" y="0" width="60" height="30" rx="15" fill="#ffffff" opacity="0.95" stroke="#ffffff" stroke-width="1.5" />
      <path d="M 15,18 L 22,11 L 29,18" fill="none" stroke="#00698D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      <line x1="22" y1="11" x2="22" y2="22" stroke="#00698D" stroke-width="2.5" stroke-linecap="round" />
      <circle cx="42" cy="15" r="3" fill="#00698D" />
      <circle cx="50" cy="15" r="3" fill="#00698D" opacity="0.4" />
