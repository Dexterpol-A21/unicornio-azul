---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
 title="Unicornio Azul — Soluciones reales para ideas extraordinarias"
 description="En Unicornio Azul desarrollamos marcas propias, producto, compras internacionales y canales digitales para crear negocios reales y escalables."
 showHeader={true}
>

 <!-- ═════════════════════════════════════════
 HERO — Arcoiris de Unicornio Azul
 Abstraccion geometrica: estrellas gigantes recortadas,
 arco de azules, nubes geometricas, estrella 4 puntas
 en"extraordinarias".
 ═════════════════════════════════════════ -->
 <section class="md:min-h-[100dvh] flex flex-col justify-start items-center text-center px-4 md:px-8 lg:px-12 pt-28 md:pt-36 pb-2 md:pb-12 relative" style="background: #FFFFFF">

 <!-- ═══════════ FONDO GEOMÉTRICO ═══════════ -->
 <svg class="absolute inset-0 w-full h-full pointer-events-none z-0" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">

 <defs>
 <!-- Gradiente arcoiris de azules para el arco -->
 <linearGradient id="blueArc" x1="0%" y1="100%" x2="100%" y2="0%">
 <stop offset="0%" stop-color="#163667" stop-opacity="0.08"/>
 <stop offset="30%" stop-color="#0F2548" stop-opacity="0.06"/>
 <stop offset="55%" stop-color="#00698D" stop-opacity="0.07"/>
 <stop offset="75%" stop-color="#0088B3" stop-opacity="0.05"/>
 <stop offset="100%" stop-color="#A8D8EA" stop-opacity="0.04"/>
 </linearGradient>

 <!-- Gradiente para nubes -->
 <radialGradient id="cloudGrad1">
 <stop offset="0%" stop-color="#A8D8EA" stop-opacity="0.06"/>
 <stop offset="100%" stop-color="#A8D8EA" stop-opacity="0"/>
 </radialGradient>
 <radialGradient id="cloudGrad2">
 <stop offset="0%" stop-color="#0088B3" stop-opacity="0.04"/>
 <stop offset="100%" stop-color="#0088B3" stop-opacity="0"/>
 </radialGradient>
 </defs>

 <!-- Arco de azules — atraviesa el fondo de izquierda a derecha -->
 <path d="M -100 800 Q 400 200 720 350 Q 1040 500 1540 100" fill="none" stroke="url(#blueArc)" stroke-width="140" opacity="0.7"/>

 <!-- Nubes geométricas — círculos superpuestos -->
 <!-- Grupo nube 1: top-left -->
 <circle cx="180" cy="220" r="90" fill="url(#cloudGrad1)"/>
 <circle cx="280" cy="200" r="70" fill="url(#cloudGrad1)"/>
 <circle cx="140" cy="280" r="60" fill="url(#cloudGrad1)"/>

 <!-- Grupo nube 2: mid-right -->
 <circle cx="1200" cy="400" r="100" fill="url(#cloudGrad2)"/>
 <circle cx="1320" cy="370" r="75" fill="url(#cloudGrad2)"/>
 <circle cx="1250" cy="480" r="65" fill="url(#cloudGrad2)"/>

 <!-- Grupo nube 3: bottom-center -->
 <circle cx="700" cy="780" r="80" fill="url(#cloudGrad1)"/>
 <circle cx="800" cy="760" r="60" fill="url(#cloudGrad1)"/>

 <!-- Estrella gigante recortada — top-right (solo se ve esquina inferior-izquierda) -->
 <!-- Posicionada fuera de la pantalla, solo una punta entra -->
 <g transform="translate(1620, -80)" opacity="0.06">
 <line x1="0" y1="-200" x2="0" y2="200" stroke="#163667" stroke-width="3"/>
 <line x1="-200" y1="0" x2="200" y2="0" stroke="#163667" stroke-width="3"/>
 <!-- Borde recortado: solo la punta inferior-izquierda asoma en la pantalla -->
 <circle cx="0" cy="0" r="90" fill="#163667" opacity="0.15"/>
 </g>

 <!-- Estrella gigante recortada — bottom-left (solo se ve esquina superior-derecha) -->
 <g transform="translate(-180, 1020)" opacity="0.05">
 <line x1="0" y1="-180" x2="0" y2="180" stroke="#00698D" stroke-width="2.5"/>
 <line x1="-180" y1="0" x2="180" y2="0" stroke="#00698D" stroke-width="2.5"/>
 <circle cx="0" cy="0" r="80" fill="#00698D" opacity="0.12"/>
 </g>

 <!-- Puntos/circulos dispersos — micro-formas que acompañan el arco -->
 <circle cx="320" cy="500" r="4" fill="#A8D8EA" opacity="0.15"/>
 <circle cx="580" cy="380" r="3" fill="#0088B3" opacity="0.12"/>
 <circle cx="850" cy="520" r="5" fill="#00698D" opacity="0.10"/>
 <circle cx="1050" cy="300" r="3.5" fill="#A8D8EA" opacity="0.12"/>
 <circle cx="480" cy="650" r="4" fill="#0088B3" opacity="0.08"/>
 <circle cx="750" cy="200" r="3" fill="#163667" opacity="0.06"/>
 </svg>

 <!-- ═══════════ CONTENIDO PRINCIPAL ═══════════ -->
 <div class="relative z-10 w-full max-w-[1100px] mx-auto flex flex-col items-center">

 <!-- Slogan -->
 <div class="stagger-inner space-y-1 md:space-y-2" style="--i: 0">
 <h1 class="leading-[0.98] tracking-tight max-w-full" style="color: #1A1A1A; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(2.3rem, 10.5vw, 5rem);">
 Soluciones reales
 </h1>
 <h1 class="leading-[0.98] tracking-tight max-w-full" style="color: #00698D; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(2.3rem, 10.5vw, 5rem);">
 para ideas
 </h1>
 <h1 class="leading-[0.88] tracking-tighter max-w-full" style="color: #163667; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(2.5rem, 12.5vw, 8rem);">
 <span style="position: relative; display: inline-block;">
 extraordinarias
 <!-- Estrella 4 puntas — lo extraordinario -->
 <svg class="star-sparkle" viewBox="0 0 40 40" style="position: absolute; top: 0.12em; left: 100%; margin-left: 0.02em; width: 0.3em; height: 0.3em;">
 <path d="M20 6 Q20 20 34 20 Q20 20 20 34 Q20 20 6 20 Q20 20 20 6Z" fill="#00698D"/>
 </svg>
 </span>
 </h1>
 </div>

 <!-- Descripcion -->
    <p class="stagger-inner mt-6 md:mt-10 text-base md:text-lg max-w-[55ch] leading-relaxed" style="color: #6B7280; font-family: 'Satoshi', sans-serif; font-weight: 400; --i: 1">
    Unicornio Azul desarrolla marcas propias, producto, compras internacionales y canales digitales para crear negocios reales y escalables.
    </p>

 <!-- CTAs -->
 <div class="stagger-inner mt-7 md:mt-10 flex flex-row items-center justify-center gap-4" style="--i: 2">

 <!-- CTA principal — Circle-expand hover effect -->
 <a href="/empezar" class="animated-btn" style="
 position: relative; display: inline-flex; align-items: center; justify-content: center;
 height: 52px; padding: 0 48px 0 32px;
 font-size: 15px; background-color: #163667;
 border-radius: 4px; font-weight: 600; font-family: 'Satoshi', sans-serif;
 color: #ffffff; cursor: pointer; overflow: hidden; text-decoration: none;
 box-shadow: 0 0.625em 1em 0 rgba(22, 54, 103, 0.20);
 ">
 <span class="text" style="position: relative; z-index: 2; transition: transform 0.8s cubic-bezier(0.23, 1, 0.32, 1);">Cuéntanos tu proyecto</span>
 <svg class="arr-1" style="position: absolute; top: 50%; margin-top: -10px; width: 20px; height: 20px; z-index: 2; right: 20px; transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);" fill="none" stroke="#ffffff" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
 <svg class="arr-2" style="position: absolute; top: 50%; margin-top: -10px; width: 20px; height: 20px; z-index: 2; left: -25%; transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);" fill="none" stroke="#ffffff" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
 <span class="circle" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 20px; height: 20px; background-color: #00698D; border-radius: 50%; opacity: 0; transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);"></span>
 </a>

 <!-- CTA secundario — Slide-down hover -->
 <a href="#que-hacemos" class="cta-slide" style="
 display: block; width: 190px; height: 52px;
 border-radius: 4px; overflow: hidden;
 cursor: pointer; text-decoration: none;
 box-shadow: inset 0 0 0 2px #163667;
 ">
 <div style="height: 52px; display: flex; align-items: center; justify-content: center; transition: transform 0.6s cubic-bezier(.16,1,.3,1); flex-shrink: 0;">
 <span style="font-size: 15px; font-weight: 600; color: #163667; font-family: 'Satoshi', sans-serif;">Quiero saber más</span>
 </div>
 <div style="height: 52px; display: flex; align-items: center; justify-content: center; transition: transform 0.6s cubic-bezier(.16,1,.3,1); flex-shrink: 0; background: #163667;">
 <span style="font-size: 15px; font-weight: 600; color: #ffffff; font-family: 'Satoshi', sans-serif;">Qué hacemos</span>
 </div>
 </a>

 </div>

 <!-- ═══════════ AREA INFERIOR — CLUSTER LITERAL CENTRAL ═══════════ -->
 <div class="mt-10 md:mt-16 w-full flex-1 flex flex-col justify-end items-center pointer-events-none stagger-inner relative opacity-100" style="--i: 3;">
 
 <!-- Expandido: Max-H al 55% de pantalla, Ancho hasta 1400px, y ViewBox"zoomeado" para escalar todo -->
 <svg viewBox="80 10 840 470" preserveAspectRatio="xMidYMax meet" class="w-full h-auto max-h-[55vh] max-w-[1400px] drop-shadow-sm transform origin-bottom" xmlns="http://www.w3.org/2000/svg">
 
 <!-- Sombra base para agrupadolos -->
 <ellipse cx="500" cy="440" rx="350" ry="25" fill="#163667" opacity="0.05" />

 <!-- 5. EL GLOBO TERRÁQUEO (Internacional & Compras) - Asomando por detrás en el centro -->
 <!-- Oculto parcialmente por el contenedor frontal, pero muy detallado en la zona superior (polo) -->
 <g transform="translate(510, 270) scale(1.8)" opacity="0.30">
 <!-- Círculo base del mundo -->
 <circle cx="0" cy="0" r="100" fill="#A8D8EA" opacity="0.05" />
 <circle cx="0" cy="0" r="100" fill="none" stroke="#0F2548" stroke-width="2" />
 
 <!-- Ejes del mundo (Meridianos y Paralelos detallados) -->
 <!-- Ecuador -->
 <ellipse cx="0" cy="0" rx="100" ry="25" fill="none" stroke="#0F2548" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.6" />
 
 <!-- Paralelos Superiores (los más visibles) -->
 <ellipse cx="0" cy="-30" rx="95.3" ry="20" fill="none" stroke="#163667" stroke-width="1.5" opacity="0.4" />
 <ellipse cx="0" cy="-60" rx="80" ry="15" fill="none" stroke="#163667" stroke-width="1" opacity="0.3" />
 <ellipse cx="0" cy="-85" rx="52.6" ry="8" fill="none" stroke="#163667" stroke-width="1" opacity="0.2" />
 
 <!-- Paralelos Inferiores -->
 <ellipse cx="0" cy="30" rx="95.3" ry="20" fill="none" stroke="#163667" stroke-width="1.5" opacity="0.3" />
 <ellipse cx="0" cy="60" rx="80" ry="15" fill="none" stroke="#163667" stroke-width="1" opacity="0.2" />
 
 <!-- Meridianos (Acoplados a los polos) -->
 <path d="M 0 -100 C 40 -100, 40 100, 0 100" fill="none" stroke="#163667" stroke-width="1.5" opacity="0.4" />
 <path d="M 0 -100 C -40 -100, -40 100, 0 100" fill="none" stroke="#163667" stroke-width="1.5" opacity="0.4" />
 <path d="M 0 -100 C 80 -100, 80 100, 0 100" fill="none" stroke="#163667" stroke-width="1" opacity="0.3" />
 <path d="M 0 -100 C -80 -100, -80 100, 0 100" fill="none" stroke="#163667" stroke-width="1" opacity="0.3" />
 <line x1="0" y1="-100" x2="0" y2="100" stroke="#163667" stroke-width="1.5" opacity="0.5" />
 
 <!-- Geografía Abstracta tipo Holograma / Polígonos de datos (Eurasia y América) -->
 <!-- Derecha (Asia/Europa) -->
 <path d="M 15 -75 L 45 -65 L 65 -45 L 80 -25 L 55 -15 L 30 -30 L 10 -50 Z" fill="#0088B3" opacity="0.2" stroke="#0088B3" stroke-width="1" stroke-linejoin="round"/>
 <circle cx="50" cy="-45" r="4" fill="#00698D" />
 <circle cx="50" cy="-45" r="8" fill="none" stroke="#00698D" stroke-width="1" opacity="0.5" />
 
 <!-- Izquierda (América) -->
 <path d="M -25 -80 L -55 -60 L -75 -25 L -45 -15 L -20 -40 Z" fill="#0088B3" opacity="0.2" stroke="#0088B3" stroke-width="1" stroke-linejoin="round"/>
 <circle cx="-55" cy="-35" r="4" fill="#00698D" />
 <circle cx="-55" cy="-35" r="8" fill="none" stroke="#00698D" stroke-width="1" opacity="0.5" />
 
 <!-- Ruta de Vuelo / Logística Cruzando Fuera del Planeta sobre el polo -->
 <path d="M 50 -45 Q 0 -130 -55 -35" fill="none" stroke="#A8D8EA" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="6 6"/>
 <!-- Avión / Datos enviándose sobre el arco -->
 <polygon points="-2,-85 -7,-72 3,-72" fill="#0F2548" transform="rotate(-70 -2 -78)" />
 <circle cx="-2" cy="-78" r="7" fill="none" stroke="#0088B3" stroke-width="1.5" />
 </g>

 <!-- 1. LA PANTALLA (Marketing Digital) - Fondo Derecha -->
 <g transform="translate(560, 160) rotate(4)">
 <!-- Carcasa Monitor -->
 <rect x="0" y="0" width="340" height="220" rx="12" fill="#ffffff" stroke="#00698D" stroke-width="4"/>
 <rect x="0" y="0" width="340" height="220" rx="12" fill="#00698D" opacity="0.03"/>
 <!-- Pantalla interna -->
 <rect x="15" y="15" width="310" height="190" rx="6" fill="#fafafa" stroke="#00698D" stroke-width="2"/>
 <!-- Elementos UI en pantalla -->
 <rect x="30" y="30" width="100" height="12" rx="4" fill="#00698D" opacity="0.2"/>
 <rect x="30" y="55" width="200" height="8" rx="4" fill="#00698D" opacity="0.1"/>
 <rect x="30" y="75" width="160" height="8" rx="4" fill="#00698D" opacity="0.1"/>
 <!-- Soporte -->
 <path d="M 140 220 L 120 290 L 220 290 L 200 220" fill="#ffffff" stroke="#00698D" stroke-width="4" stroke-linejoin="round"/>
 <line x1="90" y1="290" x2="250" y2="290" stroke="#00698D" stroke-width="8" stroke-linecap="round"/>
 <!-- UI Graph (Escalado preview) -->
 <polyline points="40,160 100,100 160,130 240,60 280,80" fill="none" stroke="#00698D" stroke-width="4" stroke-linejoin="round" stroke-linecap="round"/>
 <circle cx="240" cy="60" r="6" fill="#ffffff" stroke="#00698D" stroke-width="3"/>
 </g>

 <!-- 2. EL PLANO / PORTAPAPELES (Desarrollo Negocios) - Fondo Izquierda -->
 <g transform="translate(140, 180) rotate(-12)">
 <!-- Tabla portapapeles -->
 <rect x="0" y="0" width="240" height="300" rx="8" fill="#ffffff" stroke="#163667" stroke-width="4" />
 <!-- Hojas de papel -->
 <rect x="10" y="10" width="220" height="280" fill="#ffffff" stroke="#163667" stroke-width="1.5" opacity="0.5"/>
 <!-- Clip superior -->
 <path d="M 80 -10 L 160 -10 L 170 15 L 70 15 Z" fill="#ffffff" stroke="#163667" stroke-width="3" stroke-linejoin="round" />
 <circle cx="120" cy="5" r="4" fill="#163667" />
 <!-- Contenido del plano (Wireframes y notas) -->
 <line x1="30" y1="50" x2="150" y2="50" stroke="#163667" stroke-width="4" stroke-linecap="round"/>
 <line x1="30" y1="80" x2="210" y2="80" stroke="#163667" stroke-width="3" stroke-linecap="round" opacity="0.5"/>
 <line x1="30" y1="110" x2="180" y2="110" stroke="#163667" stroke-width="3" stroke-linecap="round" opacity="0.5"/>
 <!-- Gráfico circular estratégico -->
 <circle cx="120" cy="200" r="45" fill="none" stroke="#163667" stroke-width="4"/>
 <path d="M 120 155 A 45 45 0 0 1 165 200 L 120 200 Z" fill="#163667" opacity="0.2"/>
 <!-- Lupa abstracta sobre el plano -->
 <circle cx="180" cy="180" r="25" fill="#fafafa" stroke="#163667" stroke-width="3"/>
 <line x1="165" y1="195" x2="145" y2="215" stroke="#163667" stroke-width="4" stroke-linecap="round"/>
 </g>

 <!-- 3. EL CONTENEDOR ISOMÉTRICO (Producto & Compras) - Centro Frente -->
 <!-- Oculta y solapa perfectamente las bases de los otros y unifica todo -->
 <g transform="translate(480, 200)">
 <!-- Top Face -->
 <polygon points="0,0 130,65 0,130 -130,65" fill="#f8fafc" stroke="#0F2548" stroke-width="4" stroke-linejoin="round"/>
 <!-- Left Face (Front) -->
 <polygon points="-130,65 0,130 0,270 -130,205" fill="#ffffff" stroke="#0F2548" stroke-width="4" stroke-linejoin="round"/>
 <!-- Right Face -->
 <polygon points="0,130 130,65 130,205 0,270" fill="#f1f5f9" stroke="#0F2548" stroke-width="4" stroke-linejoin="round"/>
 
 <!-- Detalles estructurales -->
 <polygon points="-10,125 10,125 10,265 -10,265" fill="#0F2548" opacity="0.1"/>
 </g>

 <!-- 4. LA FLECHA DE ESCALADO (Escalado & Amazon) - Cruzando y subiendo -->
 <!-- Sombra luminosa -->
 <path d="M 280 400 C 450 400, 600 250, 860 60" fill="none" stroke="#0088B3" stroke-width="28" stroke-linecap="round" opacity="0.1"/>
 <!-- Cuerpo de la flecha -->
 <path d="M 280 400 C 450 400, 600 250, 860 60" fill="none" stroke="#0088B3" stroke-width="14" stroke-linecap="round"/>
 <!-- Punta de la flecha -->
 <g transform="translate(860, 60) rotate(-35)">
 <polygon points="-30,-30 20,0 -30,30" fill="#ffffff" stroke="#0088B3" stroke-width="8" stroke-linejoin="round"/>
 <polygon points="-30,-30 20,0 -30,30" fill="#0088B3" opacity="0.2"/>
 </g>

 <!-- Estrella insignia (Extraordinarias) acompañando a la izquierda -->
 <g transform="translate(180, 20) scale(0.4)">
 <path d="M20 0 Q20 20 40 20 Q20 20 20 40 Q20 20 0 20 Q20 20 20 0Z" fill="#00698D" opacity="0.5"/>
 </g>

 </svg>

 </div>

 </div>

 </section>

 <!-- ═══════════════════════════════════════════════════
 SECCION: QUE HACEMOS — REGLAS DEL SISTEMA
 ─────────────────────────────────────────────────
 • Figuras: 240×240 px, viewBox 0 0 240 240
 • Paths tocan los 4 bordes del viewBox (sin padding)
 • Rectangulo: misma altura (240px), mismo color solido
 • Rect cubre 85% del ancho desde el borde de origen
 • Figura centrada en el borde libre del rect (mitad
 dentro, mitad fuera → overflow:hidden en row)
 • Texto DENTRO del rectangulo, con sub-items
 • Texto SIEMPRE text-left, items-start (sin alternancia)
 • Tipografia: Space Grotesk bold en titulos,
 Satoshi regular en cuerpo, #FFFFFF
 • Orden cromatico: mas oscuro → mas claro
 Negocios #0F2548 | Producto #163667 |
 Marketing #00698D | Escalado #0088B3
 • NO modificar viewBox ni alturas sin ajustar todo
 ═══════════════════════════════════════════════════ -->
 <!-- ═══════════════════════════════════════════════════
 SECCION: QUE HACEMOS — BRUTALISTA
 Numeros gigantes, titulos masivos, expansion en hover
 ═══════════════════════════════════════════════════ -->
 <section id="que-hacemos" class="relative" style="background: #FFFFFF;">

    <!-- Intro -->
    <div class="text-center pt-20 md:pt-28 pb-8 md:pb-12 px-4">
      <span class="text-[11px] tracking-[0.35em] uppercase font-semibold opacity-35" style="color: #6B7280; font-family: 'Satoshi', sans-serif;">Qué hacemos</span>
      <h2 class="mt-4 text-4xl md:text-5xl font-bold tracking-tight" style="font-family: 'Space Grotesk', sans-serif; color: #1A1A1A;">
        Creamos y escalamos<br class="md:hidden"> negocios reales
      </h2>
      <p class="mt-4 text-base md:text-lg max-w-[55ch] mx-auto leading-relaxed" style="color: #6B7280; font-family: 'Satoshi', sans-serif;">
        En Unicornio Azul no ofrecemos servicios aislados. Cubrimos el ciclo 360º completo: desde la idea hasta la venta y el escalado internacional.
      </p>
    </div>

    <!-- ═══ ROW 1: DESARROLLO DE NEGOCIOS — midnight ★ ═══ -->
    <a href="/que-hacemos/desarrollo-de-negocios" class="pillar-card relative block w-full h-[440px] md:h-[520px] group cursor-pointer">
      <div class="pillar-shape absolute" style="left:0; width:85%; top:calc(50% - 150px); height:300px;">
        <div style="position:absolute; top:0; left:0; width:100%; height:100%; background:#0F2548;"></div>
        <div style="position:absolute; left:calc(100% - 150px); top:0; width:300px; height:300px; display:flex; align-items:center; justify-content:center;">
          <svg viewBox="0 0 300 300" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
            <path d="M150 0 Q150 150 300 150 Q150 150 150 300 Q150 150 0 150 Q150 150 150 0Z" fill="#0F2548"/>
          </svg>
        </div>
      </div>
      <div class="pillar-content absolute z-20 flex flex-row items-center gap-8 md:gap-12" style="left: calc(15% + 160px); top: 50%; transform: translateY(-50%); right: 4vw; max-height: 300px;">
        <h3 class="text-5xl md:text-6xl lg:text-7xl font-bold leading-[0.85] tracking-tighter shrink-0" style="font-family: 'Space Grotesk', sans-serif; color: #FFFFFF;">Desarrollo<br>de Negocios</h3>
        <div class="flex flex-col gap-4 min-w-0">
          <div class="flex items-start gap-3">
            <span class="text-2xl font-bold shrink-0 mt-0.5" style="color:rgba(255,255,255,0.4); font-family:'Space Grotesk',sans-serif;">01</span>
            <div>
              <span class="text-lg font-semibold" style="color:rgba(255,255,255,0.9); font-family:'Satoshi',sans-serif;">Análisis de oportunidades</span>
              <p class="text-base mt-1" style="color:rgba(255,255,255,0.5); font-family:'Satoshi',sans-serif;">Investigación de mercados, competencia y viabilidad</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-2xl font-bold shrink-0 mt-0.5" style="color:rgba(255,255,255,0.4); font-family:'Space Grotesk',sans-serif;">02</span>
            <div>
              <span class="text-lg font-semibold" style="color:rgba(255,255,255,0.9); font-family:'Satoshi',sans-serif;">Validación de ideas y mercados</span>
              <p class="text-base mt-1" style="color:rgba(255,255,255,0.5); font-family:'Satoshi',sans-serif;">Pruebas de concepto, MVP y feedback real</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-2xl font-bold shrink-0 mt-0.5" style="color:rgba(255,255,255,0.4); font-family:'Space Grotesk',sans-serif;">03</span>
            <div>
              <span class="text-lg font-semibold" style="color:rgba(255,255,255,0.9); font-family:'Satoshi',sans-serif;">Creación de marca desde cero</span>
              <p class="text-base mt-1" style="color:rgba(255,255,255,0.5); font-family:'Satoshi',sans-serif;">Identidad, posicionamiento y estrategia de lanzamiento</p>
            </div>
          </div>
        </div>
