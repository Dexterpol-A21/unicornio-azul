    transition: background 0.45s ease, border-color 0.45s ease;
  }
  .pipeline-label {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -0.03em;
