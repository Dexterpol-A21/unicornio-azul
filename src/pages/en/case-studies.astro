  .caso-link { transition: opacity 0.25s ease, gap 0.25s ease; }
  .caso-link:hover { opacity: 0.7; gap: 0.65rem; }

  /* Vertical pipeline — scroll fill */
  .pipeline { position: relative; }
  .pipeline-track {
    position: absolute;
