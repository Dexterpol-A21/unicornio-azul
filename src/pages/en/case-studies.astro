    line-height: 1.15;
    color: #ffffff;
  }

  .caso-block { transform: none; }
  @media (prefers-reduced-motion: no-preference) {
    .caso-block {
      transform: translateY(20px);
      transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .caso-block.is-in { transform: translateY(0); }
    .pipeline-step {
      opacity: 1;
