    align-items: flex-end;
  }
  .stair-step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    width: var(--w);
    min-height: 4.25rem;
    padding: 1rem 1.35rem;
    background: transparent;
    list-style: none;
    isolation: isolate;
  }
  .stair-step::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--c);
    transform-origin: right center;
