    z-index: 0;
  }
  .pipeline-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform-origin: top;
    transform: scaleY(0);
    background: linear-gradient(to bottom, #0F2548, #163667, #0B4F7A, #00698D, #0088B3);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pipeline-step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.45rem 0;
