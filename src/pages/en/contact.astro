---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Blue Unicorn"
  description="Find all ways to contact Blue Unicorn. Email, LinkedIn, Instagram, or tell us about your project step by step."
  showHeader={true}
>

<!-- ═══════════════════════════════════════════════════
  CONTACT — editorial layout, no sections, massive typography
  ═══════════════════════════════════════════════════ -->
<div class="min-h-screen flex flex-col overflow-x-hidden" style="background:#FFFFFF;">

  <!-- Main typographic block -->
  <div class="flex-1 flex flex-col justify-center w-full max-w-[92vw] md:max-w-[80vw] mx-auto px-4 md:px-0 pt-16 md:pt-36 pb-16 md:pb-32">

    <!-- Massive H1 -->
    <h1 class="text-[19vw] md:text-[14vw] lg:text-[16vw] font-black leading-[0.85] tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
      Let's <span style="color:transparent;-webkit-text-stroke:2px #00698D;">talk</span>
    </h1>

    <!-- Email + Phone — side by side -->
    <div class="mt-10 md:mt-20 flex flex-col md:flex-row md:items-end md:justify-between gap-6 md:gap-16">

      <a href="mailto:hola@unicornioazul.com"
         class="group no-underline transition-colors duration-500"
         style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
        <span class="hidden md:block text-[5vw] lg:text-[4.5vw] font-bold leading-[0.95] tracking-tight transition-colors duration-500 group-hover:text-[#00698D]">hola@unicornio</span>
        <span class="hidden md:block text-[5vw] lg:text-[4.5vw] font-bold leading-[0.95] tracking-tight transition-colors duration-500 group-hover:text-[#00698D]">azul.com</span>
        <span class="md:hidden block text-[6.5vw] font-bold leading-[0.95] tracking-tight transition-colors duration-500 group-hover:text-[#00698D] whitespace-nowrap">hola@unicornioazul.com</span>
      </a>

      <a href="tel:+34600000000"
         class="group no-underline transition-colors duration-500"
         style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
        <span class="hidden md:block text-[5vw] lg:text-[4.5vw] font-bold leading-[0.95] tracking-tight transition-colors duration-500 group-hover:text-[#00698D]">+34 123</span>
        <span class="hidden md:block text-[5vw] lg:text-[4.5vw] font-bold leading-[0.95] tracking-tight transition-colors duration-500 group-hover:text-[#00698D]">456 789</span>
        <span class="md:hidden block text-[6.5vw] font-bold leading-[0.95] tracking-tight transition-colors duration-500 group-hover:text-[#00698D] whitespace-nowrap">+34 123 456 789</span>
      </a>

    </div>

    <!-- Subtle horizontal line -->
    <div class="mt-12 md:mt-24 w-full" style="height:1px;background:rgba(22,54,103,0.06);"></div>

    <!-- Info in 3 columns -->
    <div class="mt-10 md:mt-20 grid md:grid-cols-3 gap-6 md:gap-16">

      <!-- Col 1: Response -->
      <div>
        <span class="text-[11px] tracking-[0.35em] uppercase font-semibold block mb-4 opacity-35" style="font-family:'Satoshi',sans-serif;color:#6B7280;">Response in</span>
        <p class="text-4xl md:text-5xl lg:text-6xl font-bold leading-[0.95] tracking-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
          &lt; 48h
        </p>
        <p class="mt-3 text-lg max-w-[28ch] leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">
          No automation. A person who has read your message will reply.
        </p>
      </div>

      <!-- Col 2: Social -->
      <div>
        <span class="text-[11px] tracking-[0.35em] uppercase font-semibold block mb-4 opacity-35" style="font-family:'Satoshi',sans-serif;color:#6B7280;">Also on</span>
        <div class="flex flex-col gap-3">
          <a href="#" class="text-base font-semibold no-underline hover:opacity-50 transition-opacity" style="font-family:'Satoshi',sans-serif;color:#374151;">LinkedIn</a>
          <a href="#" class="text-base font-semibold no-underline hover:opacity-50 transition-opacity" style="font-family:'Satoshi',sans-serif;color:#374151;">Instagram</a>
        </div>
      </div>

      <!-- Col 3: Location -->
      <div>
        <span class="text-[11px] tracking-[0.35em] uppercase font-semibold block mb-2 opacity-35" style="font-family:'Satoshi',sans-serif;color:#6B7280;">From</span>
        <p class="text-lg leading-relaxed max-w-[28ch]" style="font-family:'Satoshi',sans-serif;color:#374151;">
          Madrid, Spain<br>
          <span style="color:#6B7280;">Operating with clients and suppliers across Europe, LATAM and Asia.</span>
        </p>
      </div>

    </div>

    <!-- CTA — full width at bottom -->
    <div class="mt-12 md:mt-24">
      <a href="/en/get-started"
         class="group block p-6 md:p-12 rounded-sm no-underline transition-all duration-500 hover:scale-[1.01]"
         style="background:#F5F1EC;">
        <p class="text-4xl md:text-7xl font-bold leading-[0.92] tracking-tight transition-colors duration-500" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
          Tell us about your project
        </p>
        <p class="mt-5 text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">
          No long forms. No obligation. We guide you step by step to understand what you need.
        </p>
        <div class="mt-6 flex items-center gap-3 text-sm font-semibold" style="font-family:'Space Grotesk',sans-serif;color:#163667;">
          <span>Get started</span>
          <svg class="w-4 h-4 transition-transform duration-500 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>
      </a>
    </div>

  </div>

  <!-- ═══════════════════════════════════════════════════
     FOOTER
     ═══════════════════════════════════════════════════ -->
  <footer style="background:#0F2548;font-family:'Satoshi',sans-serif;">
    <div class="max-w-6xl mx-auto px-6 md:px-12 py-8 md:py-20">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-12">

        <div class="flex flex-col gap-4">
          <a href="/en" style="text-decoration:none;">
            <div class="inline-block rounded p-3" style="background: rgba(255,255,255,0.95);">
              <img src="/images/logo-marino.png" alt="Unicornio Azul" class="h-10 md:h-11 w-auto" />
            </div>
          </a>
          <p class="text-sm leading-relaxed max-w-[28ch]" style="color:rgba(255,255,255,0.55);">
            Real solutions for extraordinary ideas.
          </p>
          <div class="flex flex-col gap-1.5 mt-1">
            <a href="mailto:hola@unicornioazul.com" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.5);">hola@unicornioazul.com</a>
            <div class="flex items-center gap-4">
              <a href="#" class="no-underline hover:opacity-60 transition-opacity" style="color:rgba(255,255,255,0.45);font-size:13px;">LinkedIn</a>
              <a href="#" class="no-underline hover:opacity-60 transition-opacity" style="color:rgba(255,255,255,0.45);font-size:13px;">Instagram</a>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-3">
          <span style="font-family:'Space Grotesk',sans-serif;font-size:12px;font-weight:600;letter-spacing:0.15em;color:rgba(255,255,255,0.35);text-transform:uppercase;">What we do</span>
          <a href="/en/what-we-do/business-development" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.7);">Business Development</a>
          <a href="/en/what-we-do/product-international-sourcing" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.7);">Product & Sourcing</a>
          <a href="/en/what-we-do/digital-marketing" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.7);">Digital Marketing</a>
          <a href="/en/what-we-do/digital-channels-scaling" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.7);">Digital Channels & Scaling</a>
        </div>

        <div class="flex flex-col gap-3">
          <span style="font-family:'Space Grotesk',sans-serif;font-size:12px;font-weight:600;letter-spacing:0.15em;color:rgba(255,255,255,0.35);text-transform:uppercase;">How we work</span>
          <a href="/en/how-we-work#proceso" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.7);">5-Step Process</a>
          <a href="/en/sorie-methodology" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.7);">SORIE™ Methodology</a>
          <a href="/en/case-studies" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.7);">Case Studies</a>
        </div>

        <div class="flex flex-col gap-3">
          <span style="font-family:'Space Grotesk',sans-serif;font-size:12px;font-weight:600;letter-spacing:0.15em;color:rgba(255,255,255,0.35);text-transform:uppercase;">Company</span>
          <a href="/en/about-us" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.7);">About Us</a>
          <a href="/en/contact" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.7);">Contact</a>
        </div>

      </div>

      <div class="mt-8 md:mt-18 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4" style="border-top:1px solid rgba(255,255,255,0.08);">
        <span class="text-xs" style="color:rgba(255,255,255,0.3);">&copy; 2026 Blue Unicorn. All rights reserved.</span>
        <div class="flex items-center gap-5 text-xs" style="color:rgba(255,255,255,0.3);">
          <a href="#" class="no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.3);">Legal notice</a>
          <a href="#" class="no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.3);">Privacy</a>
        </div>
      </div>
    </div>
  </footer>

</div>

</BaseLayout>
