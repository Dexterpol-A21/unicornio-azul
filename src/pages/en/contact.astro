---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Unicornio Azul"
  description="Find all ways to contact Unicornio Azul. Email, LinkedIn, or tell us about your project step by step."
  showHeader={true}
>

<!-- ═══════════════════════════════════════════════════
  CONTACT — editorial layout, no sections, massive typography
  ═══════════════════════════════════════════════════ -->
<div class="min-h-screen flex flex-col overflow-x-hidden" style="background:#FFFFFF;">

  <!-- Main typographic block -->
  <div class="flex-1 flex flex-col justify-center w-full max-w-[92vw] md:max-w-[80vw] mx-auto px-4 md:px-0 pt-16 md:pt-36 pb-16 md:pb-32" data-reveal>

    <!-- Massive H1 -->
    <h1 class="reveal-item text-[19vw] md:text-[14vw] lg:text-[16vw] font-black leading-[0.85] tracking-tighter" style="--i:0;font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
      Let's <span style="color:transparent;-webkit-text-stroke:2px #00698D;">talk</span>
    </h1>

    <!-- Email + Phone -->
    <div class="reveal-item mt-10 md:mt-20 flex flex-col md:flex-row md:items-end md:justify-between gap-6 md:gap-16" style="--i:1">

      <a href="mailto:luis.chicharro@unicornioazul.es"
         class="group no-underline transition-colors duration-500"
         style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
        <span class="hidden md:block text-[4.5vw] lg:text-[4vw] font-bold leading-[0.95] tracking-tight transition-colors duration-500 group-hover:text-[#00698D]">luis.chicharro@</span>
        <span class="hidden md:block text-[4.5vw] lg:text-[4vw] font-bold leading-[0.95] tracking-tight transition-colors duration-500 group-hover:text-[#00698D]">unicornioazul.es</span>
        <span class="md:hidden block text-[5vw] sm:text-[5.5vw] font-bold leading-[0.95] tracking-tight transition-colors duration-500 group-hover:text-[#00698D]">luis.chicharro@unicornioazul.es</span>
      </a>

      <button
         type="button"
         id="copy-phone"
         data-phone="+34 617 348 381"
         class="group relative text-left bg-transparent border-0 p-0 cursor-pointer transition-colors duration-500"
         style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;"
         aria-label="Copy phone number"
         title="Click to copy">
        <span class="hidden md:block text-[5vw] lg:text-[4.5vw] font-bold leading-[0.95] tracking-tight transition-colors duration-500 group-hover:text-[#00698D]">+34 617</span>
        <span class="hidden md:block text-[5vw] lg:text-[4.5vw] font-bold leading-[0.95] tracking-tight transition-colors duration-500 group-hover:text-[#00698D]">348 381</span>
        <span class="md:hidden block text-[6.5vw] font-bold leading-[0.95] tracking-tight transition-colors duration-500 group-hover:text-[#00698D] whitespace-nowrap">+34 617 348 381</span>
        <span id="copy-phone-toast" class="pointer-events-none absolute left-0 top-full mt-2 text-sm font-semibold opacity-0 transition-opacity duration-300" style="font-family:'Satoshi',sans-serif;color:#00698D;" aria-live="polite">Copied</span>
      </button>

    </div>

    <!-- Subtle horizontal line -->
    <div class="mt-12 md:mt-24 w-full" style="height:1px;background:rgba(22,54,103,0.06);"></div>

    <!-- Info in 3 columns -->
    <div class="reveal-item mt-10 md:mt-20 grid md:grid-cols-3 gap-6 md:gap-16" style="--i:2">

      <!-- Col 1: Response -->
      <div>
        <span class="text-[11px] tracking-[0.35em] uppercase font-semibold block mb-4 opacity-35" style="font-family:'Satoshi',sans-serif;color:#6B7280;">Response in</span>
        <p class="text-4xl md:text-5xl lg:text-6xl font-bold leading-[0.95] tracking-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
          &lt; 48h
        </p>
        <p class="mt-3 text-lg max-w-[28ch] leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">
          No automation. A person who has read your message will reply.
        </p>
      </div>

      <!-- Col 2: Social -->
      <div>
        <span class="text-[11px] tracking-[0.35em] uppercase font-semibold block mb-4 opacity-35" style="font-family:'Satoshi',sans-serif;color:#6B7280;">Also on</span>
        <div class="flex flex-col gap-4">
          <a
            href="https://www.linkedin.com/company/unicornio-azul-desarrollo-de-marcas/"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 no-underline transition-colors duration-300"
            style="font-family:'Satoshi',sans-serif;color:#163667;"
            aria-label="LinkedIn — Unicornio Azul"
          >
            <span class="inline-flex items-center justify-center w-11 h-11 rounded-sm transition-colors duration-300" style="background:rgba(22,54,103,0.06);">
              <svg class="w-5 h-5 transition-colors duration-300 group-hover:text-[#00698D]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </span>
            <span class="text-lg font-semibold tracking-tight transition-colors duration-300 group-hover:text-[#00698D]">LinkedIn</span>
          </a>
          <a
            href="https://wa.me/34617348381"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 no-underline transition-colors duration-300"
            style="font-family:'Satoshi',sans-serif;color:#163667;"
            aria-label="WhatsApp — Unicornio Azul"
          >
            <span class="inline-flex items-center justify-center w-11 h-11 rounded-sm transition-colors duration-300 group-hover:bg-[rgba(37,211,102,0.12)]" style="background:rgba(22,54,103,0.06);">
              <svg class="w-5 h-5 transition-colors duration-300 group-hover:text-[#25D366]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </span>
            <span class="text-lg font-semibold tracking-tight transition-colors duration-300 group-hover:text-[#25D366]">WhatsApp</span>
          </a>
          <a
            href="https://www.instagram.com/somosunicornioazul/"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 no-underline transition-colors duration-300"
            style="font-family:'Satoshi',sans-serif;color:#163667;"
            aria-label="Instagram — Unicornio Azul"
          >
            <span class="inline-flex items-center justify-center w-11 h-11 rounded-sm transition-colors duration-300 group-hover:bg-[rgba(228,64,95,0.12)]" style="background:rgba(22,54,103,0.06);">
              <svg class="w-5 h-5 transition-colors duration-300 group-hover:text-[#E4405F]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
            </span>
            <span class="text-lg font-semibold tracking-tight transition-colors duration-300 group-hover:text-[#E4405F]">Instagram</span>
          </a>
        </div>
      </div>

      <!-- Col 3: Location -->
      <div>
        <span class="text-[11px] tracking-[0.35em] uppercase font-semibold block mb-2 opacity-35" style="font-family:'Satoshi',sans-serif;color:#6B7280;">From</span>
        <p class="text-lg leading-relaxed max-w-[28ch]" style="font-family:'Satoshi',sans-serif;color:#374151;">
          Madrid, Spain<br>
          <span style="color:#6B7280;">Operating with clients and suppliers across Europe, LATAM and Asia.</span>
        </p>
      </div>

    </div>

    <!-- CTA — full width at bottom -->
    <div class="mt-12 md:mt-24">
      <a href="/en/get-started"
         class="group block p-6 md:p-12 rounded-sm no-underline transition-all duration-500 hover:scale-[1.01]"
         style="background:#F5F1EC;">
        <p class="text-4xl md:text-7xl font-bold leading-[0.92] tracking-tight transition-colors duration-500" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
          Tell us about your project
        </p>
        <p class="mt-5 text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">
          No long forms. No obligation. We guide you step by step to understand what you need.
        </p>
        <div class="mt-6 flex items-center gap-3 text-sm font-semibold" style="font-family:'Space Grotesk',sans-serif;color:#163667;">
          <span>Get started</span>
          <svg class="w-4 h-4 transition-transform duration-500 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>
      </a>
    </div>

  </div>

  <!-- ═══════════════════════════════════════════════════
     FOOTER
     ═══════════════════════════════════════════════════ -->
  <footer style="background:#0F2548;font-family:'Satoshi',sans-serif;">
    <div class="max-w-6xl mx-auto px-6 md:px-12 py-8 md:py-20">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-12">

        <div class="flex flex-col gap-4">
          <a href="/en" style="text-decoration:none;">
            <div class="inline-block rounded p-3" style="background: rgba(255,255,255,0.95);">
              <img src="/images/logo-marino.png" alt="Unicornio Azul" class="h-10 md:h-11 w-auto" />
            </div>
          </a>
          <p class="text-sm leading-relaxed max-w-[28ch]" style="color:rgba(255,255,255,0.55);">
            Real solutions for extraordinary ideas.
          </p>
          <div class="flex flex-col gap-1.5 mt-1">
            <a href="mailto:luis.chicharro@unicornioazul.es" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.5);">luis.chicharro@unicornioazul.es</a>
            <div class="flex items-center gap-4">
              <a href="https://www.linkedin.com/company/unicornio-azul-desarrollo-de-marcas/" target="_blank" rel="noopener noreferrer" class="footer-social-link footer-social-link--li">LinkedIn</a>
              <a href="https://www.instagram.com/somosunicornioazul/" target="_blank" rel="noopener noreferrer" class="footer-social-link footer-social-link--ig">Instagram</a>
              <a href="https://wa.me/34617348381" target="_blank" rel="noopener noreferrer" class="footer-social-link footer-social-link--wa">WhatsApp</a>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-3">
          <span style="font-family:'Space Grotesk',sans-serif;font-size:12px;font-weight:600;letter-spacing:0.15em;color:rgba(255,255,255,0.35);text-transform:uppercase;">What we do</span>
          <a href="/en/what-we-do/business-development" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.7);">Business Development</a>
          <a href="/en/what-we-do/product-international-sourcing" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.7);">Product & Sourcing</a>
          <a href="/en/what-we-do/digital-marketing" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.7);">Digital Marketing</a>
          <a href="/en/what-we-do/digital-channels-scaling" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.7);">Digital Channels & Scaling</a>
        </div>

        <div class="flex flex-col gap-3">
          <span style="font-family:'Space Grotesk',sans-serif;font-size:12px;font-weight:600;letter-spacing:0.15em;color:rgba(255,255,255,0.35);text-transform:uppercase;">How we work</span>
          <a href="/en/how-we-work#proceso" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.7);">5-Step Process</a>
          <a href="/en/sorie-methodology" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.7);">SORIE™ Methodology</a>
          <a href="/en/case-studies" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.7);">Case Studies</a>
        </div>

        <div class="flex flex-col gap-3">
          <span style="font-family:'Space Grotesk',sans-serif;font-size:12px;font-weight:600;letter-spacing:0.15em;color:rgba(255,255,255,0.35);text-transform:uppercase;">Company</span>
          <a href="/en/about-us" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.7);">About Us</a>
          <a href="/en/contact" class="text-sm no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.7);">Contact</a>
        </div>

      </div>

      <div class="mt-8 md:mt-18 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4" style="border-top:1px solid rgba(255,255,255,0.08);">
        <span class="text-xs" style="color:rgba(255,255,255,0.3);">&copy; 2026 Unicornio Azul. All rights reserved.</span>
        <div class="flex items-center gap-5 text-xs" style="color:rgba(255,255,255,0.3);">
          <a href="/en/legal-notice" class="no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.3);">Legal notice</a>
          <a href="/en/privacy" class="no-underline hover:opacity-70 transition-opacity" style="color:rgba(255,255,255,0.3);">Privacy & cookies</a>
        </div>
      </div>
    </div>
  </footer>

</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ContactPage",
        "name": "Contact — Unicornio Azul",
        "description": "Find all ways to contact Unicornio Azul.",
        "url": "https://unicornioazul.es/en/contact",
        "mainEntity": {
          "@type": "Organization",
          "name": "Unicornio Azul",
          "email": "luis.chicharro@unicornioazul.es",
          "telephone": "+34617348381",
          "url": "https://unicornioazul.es/en"
        }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://unicornioazul.es/en" },
          { "@type": "ListItem", "position": 2, "name": "Contact" }
        ]
      }
    ]
  }
</script>

<script>
  const copyBtn = document.getElementById('copy-phone');
  const toast = document.getElementById('copy-phone-toast');
  let toastTimer;
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const phone = copyBtn.getAttribute('data-phone') || '+34 617 348 381';
      try {
        await navigator.clipboard.writeText(phone);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = phone;
        ta.setAttribute('readonly', '');
        ta.style.position = 'absolute';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      if (toast) {
        toast.style.opacity = '1';
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => { toast.style.opacity = '0'; }, 1600);
      }
    });
  }
</script>

</BaseLayout>
