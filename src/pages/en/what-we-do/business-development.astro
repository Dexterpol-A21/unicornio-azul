---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProblemBridge from '@/components/ProblemBridge.astro';
---

<BaseLayout
  title="Business development and brands | Unicornio Azul"
  description="At Unicornio Azul we turn ideas into real businesses: consulting to create your own brand, validate your business idea, and launch projects with data, not assumptions."
  image="/images/og-desarrollo-negocios.jpg"
  showHeader={true}
>

<!-- ═════════════════════════════════════════
HERO LANDING — Business Development
min-h-screen · centered · bold · midnight + star
═════════════════════════════════════════ -->
<section class="relative overflow-hidden md:min-h-[85dvh]" style="background:#0F2548;">

  <!-- Geometric background — giant star top-right + small ones left -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none z-0" aria-hidden="true" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <!-- ═══ GIANT STAR — top-right, huge, cropped ═══ -->
    <g transform="translate(1480, 310) scale(7)" opacity="0.045">
      <path d="M0 -60 Q0 0 60 0 Q0 0 0 60 Q0 0 -60 0 Q0 0 0 -60Z" fill="#ffffff"/>
    </g>

    <!-- ═══ SMALL — left of content ═══ -->
    <g transform="translate(80, 120) scale(0.9)" opacity="0.07">
      <path d="M0 -30 Q0 0 30 0 Q0 0 0 30 Q0 0 -30 0 Q0 0 0 -30Z" fill="#ffffff"/>
    </g>
    <g transform="translate(140, 260) scale(0.6)" opacity="0.06">
      <path d="M0 -28 Q0 0 28 0 Q0 0 0 28 Q0 0 -28 0 Q0 0 0 -28Z" fill="#ffffff"/>
    </g>
    <g transform="translate(60, 380) scale(0.75)" opacity="0.055">
      <path d="M0 -30 Q0 0 30 0 Q0 0 0 30 Q0 0 -30 0 Q0 0 0 -30Z" fill="#ffffff"/>
    </g>
    <g transform="translate(180, 480) scale(0.55)" opacity="0.05">
      <path d="M0 -28 Q0 0 28 0 Q0 0 0 28 Q0 0 -28 0 Q0 0 0 -28Z" fill="#ffffff"/>
    </g>
    <g transform="translate(100, 620) scale(0.7)" opacity="0.06">
      <path d="M0 -30 Q0 0 30 0 Q0 0 0 30 Q0 0 -30 0 Q0 0 0 -30Z" fill="#ffffff"/>
    </g>
    <g transform="translate(200, 760) scale(0.5)" opacity="0.05">
      <path d="M0 -28 Q0 0 28 0 Q0 0 0 28 Q0 0 -28 0 Q0 0 0 -28Z" fill="#ffffff"/>
    </g>
    <g transform="translate(50, 830) scale(0.65)" opacity="0.055">
      <path d="M0 -30 Q0 0 30 0 Q0 0 0 30 Q0 0 -30 0 Q0 0 0 -30Z" fill="#ffffff"/>
    </g>
  </svg>

  <div class="relative z-10 w-full max-w-6xl mx-auto px-6 md:px-12 h-full flex flex-col">

    <!-- GRID 2-columns: text left · visual right -->
    <div class="flex-1 flex flex-col items-center gap-6 md:gap-8 pt-10 md:pt-20 pb-4 md:pb-28">

      <!-- TOP ROW: text left + illustration right -->
      <div class="w-full flex flex-col lg:flex-row items-center justify-center gap-8 lg:gap-16">

        <!-- LEFT COLUMN — text -->
        <div class="flex-1 flex flex-col items-center lg:items-start text-center lg:text-left" data-reveal>
          <!-- H1 — huge -->
          <h1 class="reveal-item leading-[0.92] tracking-tight max-w-[14ch]" style="--i:0;color:#ffffff;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(2.8rem,10vw,5.5rem);">
            From an idea<br>to a real business
          </h1>

          <!-- Subtitle -->
          <p class="reveal-item mt-4 md:mt-8 text-lg md:text-lg max-w-[40ch] leading-relaxed" style="--i:1;color:rgba(255,255,255,0.55);font-family:'Satoshi',sans-serif;">
            We research, validate, and structure your business idea before you spend a single euro. Business development consulting with real data.
          </p>

          <!-- CTA — desktop (in text column) -->
          <div class="reveal-item hidden lg:flex mt-8" style="--i:2">
            <a href="/en/get-started" class="animated-btn" style="position:relative;display:inline-flex;align-items:center;justify-content:center;height:56px;padding:0 52px 0 36px;font-size:16px;background-color:#ffffff;border-radius:4px;font-weight:600;font-family:'Satoshi',sans-serif;color:#0F2548;cursor:pointer;overflow:hidden;text-decoration:none;box-shadow:0 0.625em 1.2em 0 rgba(0,0,0,0.12);">
              <span class="text" style="position:relative;z-index:2;transition:transform 0.8s cubic-bezier(0.23,1,0.32,1);">Tell us about your project</span>
              <svg class="arr-1" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;right:22px;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#0F2548" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              <svg class="arr-2" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;left:-25%;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#0F2548" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              <span class="circle" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:20px;height:20px;background-color:#00698D;border-radius:50%;opacity:0;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);"></span>
            </a>
          </div>
        </div>

        <!-- RIGHT COLUMN — conceptual illustration: idea → business -->
        <div class="flex-1 w-full max-w-[360px] sm:max-w-[420px] md:max-w-[480px] aspect-[4/3] flex items-center justify-center relative" role="img" aria-label="Illustration of a lightbulb with gears representing business idea development and validation">
        <svg viewBox="0 0 480 360" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <radialGradient id="glow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#ffffff" stop-opacity="0.15"/>
              <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
            </radialGradient>
            
            <g id="gear">
              <circle cx="0" cy="0" r="22" />
              <rect x="-6" y="-28" width="12" height="56" rx="2" />
              <rect x="-6" y="-28" width="12" height="56" rx="2" transform="rotate(45)" />
              <rect x="-6" y="-28" width="12" height="56" rx="2" transform="rotate(90)" />
              <rect x="-6" y="-28" width="12" height="56" rx="2" transform="rotate(135)" />
            </g>

            <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#ffffff" stroke-width="1" opacity="0.05"/>
            </pattern>
          </defs>

          <!-- Background: Blueprint Grid (Structure/Planning) -->
          <rect width="480" height="360" fill="url(#grid)" />

          <!-- Growth Chart (Scaling) -->
          <g transform="translate(60, 260)" opacity="0.25">
            <path d="M 0,0 L 80,-30 L 140,-10 L 260,-90 L 320,-70 L 400,-140" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="400" cy="-140" r="4" fill="#ffffff" />
          </g>

          <!-- Puzzle Pieces (Strategy) -->
          <g transform="translate(360, 80) scale(0.7) rotate(15)" opacity="0.5">
            <path d="M0,0 L20,0 C20,-15 40,-15 40,0 L60,0 L60,20 C75,20 75,40 60,40 L60,60 L40,60 C40,45 20,45 20,60 L0,60 L0,40 C-15,40 -15,20 0,20 Z" fill="none" stroke="#ffffff" stroke-width="3" stroke-linejoin="round" />
          </g>
          <g transform="translate(70, 120) scale(0.5) rotate(-25)" opacity="0.3">
            <path d="M0,0 L20,0 C20,15 40,15 40,0 L60,0 L60,20 C45,20 45,40 60,40 L60,60 L40,60 C40,75 20,75 20,60 L0,60 L0,40 C15,40 15,20 0,20 Z" fill="#ffffff" opacity="0.15" stroke="#ffffff" stroke-width="3" stroke-linejoin="round" />
          </g>

          <!-- Central Lightbulb (The Idea) -->
          <g transform="translate(240, 170)">
            <!-- Glow -->
            <circle cx="0" cy="-20" r="130" fill="url(#glow)" />

            <!-- Bulb Glass -->
            <path d="M-70,-35 C-70,-85 -35,-115 0,-115 C35,-115 70,-85 70,-35 C70,10 40,45 28,75 L-28,75 C-40,45 -70,10 -70,-35 Z" fill="none" stroke="#ffffff" stroke-width="4" stroke-linecap="round" />
            
            <!-- Glass Reflection -->
            <path d="M-50,-35 C-50,-65 -25,-90 0,-90" fill="none" stroke="#ffffff" stroke-width="3" opacity="0.4" stroke-linecap="round" />

            <!-- Metal Base -->
            <g transform="translate(0, 75)">
              <rect x="-30" y="0" width="60" height="14" rx="3" fill="#ffffff" opacity="0.9" />
              <rect x="-26" y="18" width="52" height="12" rx="3" fill="#ffffff" opacity="0.7" />
              <rect x="-22" y="34" width="44" height="10" rx="3" fill="#ffffff" opacity="0.5" />
              <path d="M-12,48 L12,48 L8,60 L-8,60 Z" fill="#ffffff" opacity="0.3" />
            </g>

            <!-- Internal Gears (The Real Business / Operations) -->
            <!-- Large Gear (Turns right) -->
            <g transform="translate(-18, -25)">
              <g>
                <animateTransform attributeName="transform" type="rotate" from="0 0 0" to="360 0 0" dur="12s" repeatCount="indefinite" />
                <use href="#gear" fill="#0088B3" opacity="0.95" />
              </g>
              <!-- Static center axle -->
              <circle cx="0" cy="0" r="8" fill="#0F2548" />
              <circle cx="0" cy="0" r="8" fill="none" stroke="#ffffff" stroke-width="2" opacity="0.8" />
            </g>
            
            <!-- Small Gear (Turns left to mesh correctly) -->
            <g transform="translate(20, 3) scale(0.7)">
              <g>
                <animateTransform attributeName="transform" type="rotate" from="15 0 0" to="-345 0 0" dur="8.4s" repeatCount="indefinite" />
                <use href="#gear" fill="#00698D" opacity="0.95" />
              </g>
              <!-- Static center axle -->
              <circle cx="0" cy="0" r="8" fill="#0F2548" />
              <circle cx="0" cy="0" r="8" fill="none" stroke="#ffffff" stroke-width="2" opacity="0.8" />
            </g>
            
            <!-- Electrical/structural connections -->
            <path d="M-18,10 L-18,55 M20,25 L20,55" stroke="#ffffff" stroke-width="3" opacity="0.6" stroke-linecap="round" />
            <circle cx="-18" cy="55" r="3" fill="#ffffff" opacity="0.8" />
            <circle cx="20" cy="55" r="3" fill="#ffffff" opacity="0.8" />
          </g>
        </svg>
      </div>

      </div>
      <!-- END top row -->

      <!-- CTA — below illustration (mobile only) -->
      <div class="lg:hidden mt-2 md:mt-4">
        <a href="/en/get-started" class="animated-btn" style="position:relative;display:inline-flex;align-items:center;justify-content:center;height:60px;padding:0 56px 0 40px;font-size:17px;background-color:#ffffff;border-radius:4px;font-weight:600;font-family:'Satoshi',sans-serif;color:#0F2548;cursor:pointer;overflow:hidden;text-decoration:none;box-shadow:0 0.625em 1.2em 0 rgba(0,0,0,0.12);">
          <span class="text" style="position:relative;z-index:2;transition:transform 0.8s cubic-bezier(0.23,1,0.32,1);">Tell us about your project</span>
          <svg class="arr-1" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;right:26px;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#0F2548" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <svg class="arr-2" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;left:-25%;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#0F2548" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <span class="circle" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:20px;height:20px;background-color:#00698D;border-radius:50%;opacity:0;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);"></span>
        </a>
      </div>

    </div>

  </div>
</section>

<!-- ═════════════════════════════════════════
PROBLEM → ANSWER (Feedback HOME §5)
═════════════════════════════════════════ -->
<ProblemBridge
  problem="I have an idea"
  solution="We turn it into reality"
  accent="#0F2548"
  shape="star"
  problemLabel="Problem"
  solutionLabel="Answer"
/>

<!-- ═════════════════════════════════════════
2. INTRO — Developing businesses and brands from scratch
Editorial design · 2-columns
═════════════════════════════════════════ -->
<section style="background:#FFFFFF;" data-reveal>
  <div class="max-w-6xl mx-auto px-6 md:px-12 pt-14 md:pt-32 pb-12 md:pb-24 flex flex-col md:flex-row gap-8 md:gap-20">

    <!-- LEFT COLUMN — headline -->
    <div class="reveal-item md:w-[42%] flex flex-col" style="--i:0">
      <h2 class="text-[2.5rem] md:text-[2.5rem] font-bold leading-[1.05] tracking-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
        We shape ideas<br>and turn them<br>into business.
      </h2>
      <div class="mt-6 md:mt-8 w-16 h-[2px]" style="background:#0F2548;opacity:0.2;"></div>
    </div>

    <!-- RIGHT COLUMN — text -->
    <div class="reveal-item md:w-[58%] space-y-6 text-lg md:text-lg leading-relaxed" style="--i:1;font-family:'Satoshi',sans-serif;color:#374151;">
      <!-- Lead — highlighted -->
      <p class="text-xl md:text-2xl leading-relaxed" style="color:#0F2548;font-weight:700; font-family:'Space Grotesk',sans-serif;">
        We offer consulting to create your own brands and projects from the start, without improvising or making costly mistakes.
      </p>
      <p>
        We analyze the market, define the product, structure the <strong style="color:#1A1A1A;font-weight:700;">business model</strong>, and create brands with commercial sense. All with real data, not assumptions.
      </p>
      <p>
        This block is key for entrepreneurs and companies that want to <strong style="color:#1A1A1A;font-weight:700;">launch their own brand and validate their business idea</strong> on a solid foundation. Here we work on the strategic foundations that will allow the business to scale later on.
      </p>
    </div>

  </div>
</section>

<!-- ═════════════════════════════════════════
3. WHAT'S INCLUDED — 4 blocks according to brief
═════════════════════════════════════════ -->
<section style="background:#F2F5F8;" data-reveal>
  <div class="max-w-4xl mx-auto md:px-12 py-14 md:py-28">

    <div class="px-6 md:px-0">
      <h2 class="reveal-item text-[2.5rem] md:text-4xl font-bold tracking-tight mb-8 md:mb-14" style="--i:0;font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
        Four blocks. One solid foundation.
      </h2>
    </div>

    <!-- Mobile: horizontal gallery · Desktop: vertical stack -->
    <div class="md:hidden overflow-hidden w-full" data-bloque-rail data-bloque-x>
      <div class="flex gap-3 overflow-x-auto snap-x snap-mandatory" data-bloque-scroller style="scrollbar-width:none; -ms-overflow-style:none; padding-left:24px; padding-right:24px; scroll-padding-left:24px; scroll-padding-right:24px;">

        <!-- 01 -->
        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" data-bloque-item style="--c:#0F2548;background:#FFFFFF;border:1px solid rgba(15,37,72,0.06);">
          <span class="bloque-num block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;">01</span>
          <h3 class="bloque-title text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Business opportunity analysis</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We analyze the market, the competition, and the numbers before taking a single step. Clear, actionable information, not 80-page PDFs.</p>
        </div>

        <!-- 02 -->
        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" data-bloque-item style="--c:#163667;background:#FFFFFF;border:1px solid rgba(15,37,72,0.06);">
          <span class="bloque-num block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;">02</span>
          <h3 class="bloque-title text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Idea and market validation</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We validate with real data, proof of concept, and conversations with potential customers. If the idea doesn't hold up, we adjust it before it costs money.</p>
        </div>

        <!-- 03 -->
        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" data-bloque-item style="--c:#0B4F7A;background:#FFFFFF;border:1px solid rgba(15,37,72,0.06);">
          <span class="bloque-num block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;">03</span>
          <h3 class="bloque-title text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Business model definition</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We structure the business model, the value proposition, and the commercial strategy. The strategic foundations that support everything else.</p>
        </div>

        <!-- 04 -->
        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" data-bloque-item style="--c:#00698D;background:#FFFFFF;border:1px solid rgba(15,37,72,0.06);">
          <span class="bloque-num block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;">04</span>
          <h3 class="bloque-title text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Brand creation from scratch</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We create brands with commercial purpose: identity, positioning, naming, and launch strategy. It's not a logo, it's the promise you make to your customer.</p>
        </div>

      </div>
    </div>

    <!-- Dots indicator (mobile only) -->
    <div id="bloques-dots" class="md:hidden flex items-center justify-center gap-2 mt-5" data-bloque-dots>
      <span class="block w-2 h-2 rounded-full" data-color="#0F2548" style="background:#0F2548;opacity:1;"></span>
      <span class="block w-2 h-2 rounded-full" data-color="#163667" style="background:#163667;opacity:0.22;"></span>
      <span class="block w-2 h-2 rounded-full" data-color="#0B4F7A" style="background:#0B4F7A;opacity:0.22;"></span>
      <span class="block w-2 h-2 rounded-full" data-color="#00698D" style="background:#00698D;opacity:0.22;"></span>
    </div>

    <!-- Desktop: vertical stack (original) -->
    <div class="hidden md:flex flex-col gap-4 mt-14 px-12" data-bloque-rail>

      <div class="reveal-item flex flex-col md:flex-row gap-4 md:gap-10 items-start p-5 md:p-8 rounded-xl" data-bloque-item style="--i:1;--c:#0F2548;background:#FFFFFF;border:1px solid rgba(15,37,72,0.06);">
        <div class="shrink-0"><span class="bloque-num block text-8xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;">01</span></div>
        <div class="flex-1">
          <h3 class="bloque-title text-2xl font-bold mb-1.5 leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Business opportunity analysis</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We analyze the market, the competition, and the numbers before taking a single step. Clear, actionable information, not 80-page PDFs.</p>
        </div>
      </div>

      <div class="reveal-item flex flex-col md:flex-row gap-4 md:gap-10 items-start p-5 md:p-8 rounded-xl" data-bloque-item style="--i:2;--c:#163667;background:#FFFFFF;border:1px solid rgba(15,37,72,0.06);">
        <div class="shrink-0"><span class="bloque-num block text-8xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;">02</span></div>
        <div class="flex-1">
          <h3 class="bloque-title text-2xl font-bold mb-1.5 leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Idea and market validation</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We validate with real data, proof of concept, and conversations with potential customers. If the idea doesn't hold up, we adjust it before it costs money.</p>
        </div>
      </div>

      <div class="reveal-item flex flex-col md:flex-row gap-4 md:gap-10 items-start p-5 md:p-8 rounded-xl" data-bloque-item style="--i:3;--c:#0B4F7A;background:#FFFFFF;border:1px solid rgba(15,37,72,0.06);">
        <div class="shrink-0"><span class="bloque-num block text-8xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;">03</span></div>
        <div class="flex-1">
          <h3 class="bloque-title text-2xl font-bold mb-1.5 leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Business model definition</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We structure the business model, the value proposition, and the commercial strategy. The strategic foundations that support everything else.</p>
        </div>
      </div>

      <div class="reveal-item flex flex-col md:flex-row gap-4 md:gap-10 items-start p-5 md:p-8 rounded-xl" data-bloque-item style="--i:4;--c:#00698D;background:#FFFFFF;border:1px solid rgba(15,37,72,0.06);">
        <div class="shrink-0"><span class="bloque-num block text-8xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;">04</span></div>
        <div class="flex-1">
          <h3 class="bloque-title text-2xl font-bold mb-1.5 leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Brand creation from scratch</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We create brands with commercial purpose: identity, positioning, naming, and launch strategy. It's not a logo, it's the promise you make to your customer.</p>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- ═════════════════════════════════════════
4. AUTHORITY QUOTE
═════════════════════════════════════════ -->
<section style="background:#FFFFFF;" data-reveal>
  <div class="max-w-3xl mx-auto px-6 md:px-12 py-12 md:py-20 text-center">
    <svg viewBox="0 0 40 40" class="reveal-item w-8 h-8 mx-auto mb-5 opacity-20" style="--i:0;color:#0F2548;">
      <path d="M20 0 Q20 20 40 20 Q20 20 20 40 Q20 20 0 20 Q20 20 20 0Z" fill="currentColor"/>
    </svg>
    <blockquote class="reveal-item text-2xl md:text-3xl font-bold leading-[1.2] tracking-tight" style="--i:1;font-family:'Space Grotesk',sans-serif;color:#0F2548;">
