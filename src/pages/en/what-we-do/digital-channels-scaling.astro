---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Digital Channels & Scaling — Blue Unicorn"
  description="We scale businesses through digital channels: Amazon FBA, marketplaces, B2B e-commerce, logistics and fulfillment, and international expansion strategies."
  image="/images/og-escalado.jpg"
  showHeader={true}
>

<!-- ═════════════════════════════════════════
HERO LANDING — Digital Channels & Scaling
aqua #00698D · triangle ▲ · min-h-85dvh
═════════════════════════════════════════ -->
<section class="relative overflow-hidden md:min-h-[85dvh]" style="background:#00698D;">

  <!-- Geometric background — giant triangle top-right + small triangles left -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none z-0" aria-hidden="true" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <!-- ═══ GIANT TRIANGLE — top-right, huge, cropped ═══ -->
    <g transform="translate(1500, 140) scale(8)" opacity="0.04">
      <polygon points="0,-50 -43,25 43,25" fill="#ffffff"/>
    </g>

    <!-- ═══ SMALL TRIANGLES — left of content ═══ -->
    <g transform="translate(80, 120) scale(0.9)" opacity="0.07">
      <polygon points="0,-15 -13,8 13,8" fill="#ffffff"/>
    </g>
    <g transform="translate(140, 260) scale(0.6)" opacity="0.06">
      <polygon points="0,-14 -12,7 12,7" fill="#ffffff"/>
    </g>
    <g transform="translate(60, 380) scale(0.75)" opacity="0.055">
      <polygon points="0,-15 -13,8 13,8" fill="#ffffff"/>
    </g>
    <g transform="translate(180, 480) scale(0.55)" opacity="0.05">
      <polygon points="0,-14 -12,7 12,7" fill="#ffffff"/>
    </g>
    <g transform="translate(100, 620) scale(0.7)" opacity="0.06">
      <polygon points="0,-15 -13,8 13,8" fill="#ffffff"/>
    </g>
    <g transform="translate(200, 760) scale(0.5)" opacity="0.05">
      <polygon points="0,-14 -12,7 12,7" fill="#ffffff"/>
    </g>
    <g transform="translate(50, 830) scale(0.65)" opacity="0.055">
      <polygon points="0,-15 -13,8 13,8" fill="#ffffff"/>
    </g>
  </svg>

  <div class="relative z-10 w-full max-w-6xl mx-auto px-6 md:px-12 h-full flex flex-col">

    <!-- GRID 2-columns: text left · visual right -->
    <div class="flex-1 flex flex-col items-center gap-6 md:gap-8 pt-10 md:pt-20 pb-4 md:pb-28">

      <!-- TOP ROW: text left + illustration right -->
      <div class="w-full flex flex-col lg:flex-row items-center justify-center gap-8 lg:gap-16">

        <!-- LEFT COLUMN — text -->
        <div class="flex-1 flex flex-col items-center lg:items-start text-center lg:text-left">
          <!-- H1 — huge -->
          <h1 class="leading-[0.92] tracking-tight max-w-[14ch]" style="color:#ffffff;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(2.8rem,10vw,5.5rem);">
            Scale to the<br>digital world
          </h1>

          <!-- Subtitle -->
          <p class="mt-4 md:mt-8 text-lg md:text-lg max-w-[40ch] leading-relaxed" style="color:rgba(255,255,255,0.55);font-family:'Satoshi',sans-serif;">
            Amazon FBA, marketplaces, B2B e-commerce, logistics, and fulfillment. We diversify channels and scale your business internationally.
          </p>

          <!-- CTA — desktop (in text column) -->
          <div class="hidden lg:flex mt-8">
            <a href="/en/get-started" class="animated-btn" style="position:relative;display:inline-flex;align-items:center;justify-content:center;height:56px;padding:0 52px 0 36px;font-size:16px;background-color:#ffffff;border-radius:4px;font-weight:600;font-family:'Satoshi',sans-serif;color:#00698D;cursor:pointer;overflow:hidden;text-decoration:none;box-shadow:0 0.625em 1.2em 0 rgba(0,0,0,0.12);">
              <span class="text" style="position:relative;z-index:2;transition:transform 0.8s cubic-bezier(0.23,1,0.32,1);">Tell us about your project</span>
              <svg class="arr-1" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;right:22px;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#00698D" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              <svg class="arr-2" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;left:-25%;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#00698D" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              <span class="circle" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:20px;height:20px;background-color:#00698D;border-radius:50%;opacity:0;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);"></span>
            </a>
          </div>
        </div>

        <!-- RIGHT COLUMN — conceptual illustration: scaling and digital channels -->
        <div class="flex-1 w-full max-w-[360px] sm:max-w-[420px] md:max-w-[480px] aspect-[4/3] flex items-center justify-center relative" role="img" aria-label="Illustration of pyramids with growth chart representing digital channels and international scaling">
          <svg viewBox="0 0 480 360" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="pyrLeft" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0.9"/>
                <stop offset="100%" stop-color="#ffffff" stop-opacity="0.4"/>
              </linearGradient>
              <linearGradient id="pyrRight" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0.4"/>
                <stop offset="100%" stop-color="#ffffff" stop-opacity="0.05"/>
              </linearGradient>
              <radialGradient id="glow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0.25"/>
                <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
              </radialGradient>
              <radialGradient id="coreGlow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0.8"/>
                <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
              </radialGradient>
            </defs>

            <!-- 1. BACKGROUND: Glow -->
            <circle cx="240" cy="180" r="200" fill="url(#glow)" />

            <!-- 2. TRENDLINE -->
            <path d="M 20,340 L 140,260 L 260,180 L 380,100 L 460,20" fill="none" stroke="#ffffff" stroke-width="2" opacity="0.2" />
            <path d="M 20,340 L 140,260 L 260,180 L 380,100 L 460,20" fill="none" stroke="#ffffff" stroke-width="3" stroke-dasharray="12 12">
              <animate attributeName="stroke-dashoffset" from="120" to="0" dur="3s" repeatCount="indefinite" />
            </path>

            <!-- Vertical connections -->
            <g opacity="0.15" stroke="#ffffff" stroke-width="1.5" stroke-dasharray="4 4">
              <line x1="140" y1="260" x2="140" y2="340" />
              <line x1="260" y1="180" x2="260" y2="340" />
              <line x1="380" y1="100" x2="380" y2="340" />
              <line x1="20" y1="340" x2="460" y2="340" stroke-dasharray="none" opacity="0.5" />
            </g>

            <!-- 3. THE PYRAMIDS (Scaling) -->
            
            <!-- Pyramid 1 (Small - E-commerce) -->
            <g transform="translate(140, 260) scale(0.6)">
              <g>
                <animateTransform attributeName="transform" type="translate" values="0,0; 0,-10; 0,0" dur="4s" repeatCount="indefinite" />
                <polygon points="0,40 -40,20 0,0 40,20" fill="#000000" opacity="0.2" />
                <circle cx="0" cy="-10" r="20" fill="url(#coreGlow)" />
                <polygon points="0,-50 -40,10 0,30" fill="url(#pyrLeft)" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="round" />
                <polygon points="0,-50 40,10 0,30" fill="url(#pyrRight)" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="round" />
              </g>
            </g>

            <!-- Pyramid 2 (Medium - Marketplaces) -->
            <g transform="translate(260, 180) scale(0.8)">
              <g>
                <animateTransform attributeName="transform" type="translate" values="0,0; 0,-12; 0,0" dur="5s" begin="1s" repeatCount="indefinite" />
                <polygon points="0,40 -40,20 0,0 40,20" fill="#000000" opacity="0.2" />
                <circle cx="0" cy="-10" r="25" fill="url(#coreGlow)" />
                <polygon points="0,-50 -40,10 0,30" fill="url(#pyrLeft)" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="round" />
                <polygon points="0,-50 40,10 0,30" fill="url(#pyrRight)" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="round" />
              </g>
            </g>

            <!-- Pyramid 3 (Large - Amazon / Global) -->
            <g transform="translate(380, 100) scale(1.1)">
              <g>
                <animateTransform attributeName="transform" type="translate" values="0,0; 0,-18; 0,0" dur="6s" begin="2s" repeatCount="indefinite" />
                <path id="orbitPath" d="M -60,15 A 60,20 0 1,1 60,15 A 60,20 0 1,1 -60,15" fill="none" stroke="#ffffff" stroke-width="1.5" opacity="0.4" stroke-dasharray="4 4" />
                <circle r="4" fill="#ffffff">
                  <animateMotion dur="6s" repeatCount="indefinite">
                    <mpath href="#orbitPath" />
                  </animateMotion>
                </circle>
                <circle r="3" fill="#ffffff" opacity="0.6">
                  <animateMotion dur="6s" begin="-3s" repeatCount="indefinite">
                    <mpath href="#orbitPath" />
                  </animateMotion>
                </circle>
                <polygon points="0,40 -40,20 0,0 40,20" fill="#000000" opacity="0.2" />
                <circle cx="0" cy="-10" r="30" fill="url(#coreGlow)" />
                <polygon points="0,-50 -40,10 0,30" fill="url(#pyrLeft)" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="round" />
                <polygon points="0,-50 40,10 0,30" fill="url(#pyrRight)" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="round" />
              </g>
            </g>

            <!-- 4. FLOATING ELEMENTS (UI Cards / Channels) -->
            
            <!-- Card 1: E-commerce -->
            <g transform="translate(50, 140)">
              <g>
                <animateTransform attributeName="transform" type="translate" values="0,0; 0,-8; 0,0" dur="4.5s" repeatCount="indefinite" />
                <rect x="0" y="0" width="60" height="70" rx="6" fill="#ffffff" opacity="0.95" stroke="#ffffff" stroke-width="1.5" />
                <rect x="0" y="0" width="60" height="15" rx="6" fill="#00698D" opacity="0.1" />
                <circle cx="10" cy="7.5" r="3" fill="#00698D" />
                <rect x="8" y="22" width="44" height="20" rx="3" fill="#00698D" opacity="0.2" />
                <rect x="8" y="48" width="30" height="4" rx="2" fill="#00698D" opacity="0.4" />
                <rect x="8" y="56" width="20" height="4" rx="2" fill="#00698D" opacity="0.2" />
              </g>
            </g>

            <!-- Card 2: Marketplaces -->
            <g transform="translate(260, 295)">
              <g>
                <animateTransform attributeName="transform" type="translate" values="0,0; 0,-8; 0,0" dur="5.5s" begin="-2s" repeatCount="indefinite" />
                <rect x="0" y="0" width="70" height="50" rx="6" fill="#ffffff" opacity="0.95" stroke="#ffffff" stroke-width="1.5" />
                <rect x="8" y="8" width="14" height="14" rx="2" fill="#00698D" opacity="0.6" />
                <rect x="28" y="8" width="14" height="14" rx="2" fill="#00698D" opacity="0.4" />
                <rect x="48" y="8" width="14" height="14" rx="2" fill="#00698D" opacity="0.2" />
                <rect x="8" y="28" width="14" height="14" rx="2" fill="#00698D" opacity="0.2" />
                <rect x="28" y="28" width="14" height="14" rx="2" fill="#00698D" opacity="0.6" />
                <rect x="48" y="28" width="14" height="14" rx="2" fill="#00698D" opacity="0.4" />
              </g>
            </g>

            <!-- Card 3: Growth Badge -->
            <g transform="translate(360, 30)">
              <g>
                <animateTransform attributeName="transform" type="translate" values="0,0; 0,-6; 0,0" dur="3.5s" begin="-1s" repeatCount="indefinite" />
                <rect x="0" y="0" width="60" height="30" rx="15" fill="#ffffff" opacity="0.95" stroke="#ffffff" stroke-width="1.5" />
                <path d="M 15,18 L 22,11 L 29,18" fill="none" stroke="#00698D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                <line x1="22" y1="11" x2="22" y2="22" stroke="#00698D" stroke-width="2.5" stroke-linecap="round" />
                <circle cx="42" cy="15" r="3" fill="#00698D" />
                <circle cx="50" cy="15" r="3" fill="#00698D" opacity="0.4" />
              </g>
            </g>

          </svg>
        </div>

      </div>
      <!-- END top row -->

      <!-- CTA — below illustration (mobile only) -->
      <div class="lg:hidden mt-2">
        <a href="/en/get-started" class="animated-btn" style="position:relative;display:inline-flex;align-items:center;justify-content:center;height:60px;padding:0 56px 0 40px;font-size:17px;background-color:#ffffff;border-radius:4px;font-weight:600;font-family:'Satoshi',sans-serif;color:#00698D;cursor:pointer;overflow:hidden;text-decoration:none;box-shadow:0 0.625em 1.2em 0 rgba(0,0,0,0.12);">
          <span class="text" style="position:relative;z-index:2;transition:transform 0.8s cubic-bezier(0.23,1,0.32,1);">Tell us about your project</span>
          <svg class="arr-1" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;right:26px;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#00698D" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <svg class="arr-2" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;left:-25%;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#00698D" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <span class="circle" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:20px;height:20px;background-color:#00698D;border-radius:50%;opacity:0;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);"></span>
        </a>
      </div>

    </div>

  </div>
</section>

<!-- ═════════════════════════════════════════
2. INTRO — Digital channels and international scaling
Editorial design · 2-columns
═════════════════════════════════════════ -->
<section style="background:#FFFFFF;">
  <div class="max-w-6xl mx-auto px-6 md:px-12 pt-14 md:pt-32 pb-12 md:pb-24 flex flex-col md:flex-row gap-8 md:gap-20">

    <!-- LEFT COLUMN — headline -->
    <div class="md:w-[42%] flex flex-col">
      <h2 class="text-[2.5rem] md:text-[2.5rem] font-bold leading-[1.05] tracking-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
        Digital channels<br>and international scaling
      </h2>
      <div class="mt-6 md:mt-8 w-16 h-[2px]" style="background:#00698D;opacity:0.2;"></div>
    </div>

    <!-- RIGHT COLUMN — text -->
    <div class="md:w-[58%] space-y-6 text-lg md:text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">
      <!-- Lead — highlighted -->
      <p class="text-xl md:text-2xl leading-relaxed" style="color:#00698D;font-weight:700; font-family:'Space Grotesk',sans-serif;">
        We help sell and scale businesses through digital channels.
      </p>
      <p>
        <strong style="color:#1A1A1A;font-weight:700;">Amazon (FBA included)</strong> is a key tool for selling and scaling, but not the only one. Our approach seeks to diversify channels and prepare the business to grow nationally and internationally.
      </p>
      <p>
        We don't scale a business just for the sake of scaling. We work on <strong style="color:#1A1A1A;font-weight:700;">B2B e-commerce, logistics and fulfillment, marketplaces, and digital platforms</strong> with strategy, data, and a medium-term vision so that growth is sustainable.
      </p>
    </div>

  </div>
</section>

<!-- ═════════════════════════════════════════
3. WHAT'S INCLUDED — 4 blocks according to brief
═════════════════════════════════════════ -->
<section style="background:#F2F5F8;">
  <div class="max-w-4xl mx-auto md:px-12 py-14 md:py-28">

    <div class="px-6 md:px-0">
      <h2 class="text-[2.5rem] md:text-4xl font-bold tracking-tight mb-8 md:mb-14" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
        Four channels.<br>One goal: sell more.
      </h2>
    </div>

    <!-- Mobile: horizontal gallery -->
    <div class="md:hidden overflow-hidden w-full">
      <div class="flex gap-3 overflow-x-auto snap-x snap-mandatory" style="scrollbar-width:none; -ms-overflow-style:none; padding-left:24px; padding-right:24px; scroll-padding-left:24px; scroll-padding-right:24px;">

        <!-- 01 -->
        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" style="background:#FFFFFF;border:1px solid rgba(0,105,141,0.06);">
          <span class="block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:rgba(0,105,141,0.07);">01</span>
          <h3 class="text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Amazon</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">Comprehensive account management on Amazon Europe and international. From brand registry to listing optimization and advertising campaigns within the platform.</p>
        </div>

        <!-- 02 -->
        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" style="background:#FFFFFF;border:1px solid rgba(0,105,141,0.06);">
          <span class="block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:rgba(0,105,141,0.07);">02</span>
          <h3 class="text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Marketplaces</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We take your product to other platforms and marketplaces relevant to your sector, diversifying sales channels and reducing dependence on just one.</p>
        </div>

        <!-- 03 -->
        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" style="background:#FFFFFF;border:1px solid rgba(0,105,141,0.06);">
          <span class="block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:rgba(0,105,141,0.07);">03</span>
          <h3 class="text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">E-commerce</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We create and optimize your own online stores with the right tools for your product, your customer, and your business model.</p>
        </div>

        <!-- 04 -->
        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" style="background:#FFFFFF;border:1px solid rgba(0,105,141,0.06);">
          <span class="block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:rgba(0,105,141,0.07);">04</span>
          <h3 class="text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Digital scaling strategies</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We design the roadmap to grow beyond the first channel: new markets, international expansion, and revenue diversification.</p>
        </div>

      </div>
    </div>

    <!-- Dots indicator (mobile only) -->
    <div id="canales-dots" class="md:hidden flex items-center justify-center gap-2 mt-5">
      <span class="block w-2 h-2 rounded-full" style="background:#00698D;"></span>
      <span class="block w-2 h-2 rounded-full" style="background:rgba(0,105,141,0.2);"></span>
      <span class="block w-2 h-2 rounded-full" style="background:rgba(0,105,141,0.2);"></span>
      <span class="block w-2 h-2 rounded-full" style="background:rgba(0,105,141,0.2);"></span>
    </div>

    <!-- Desktop: vertical stack -->
    <div class="hidden md:flex flex-col gap-4 mt-14 px-12">

      <div class="flex flex-col md:flex-row gap-4 md:gap-10 items-start p-5 md:p-8 rounded-xl" style="background:#FFFFFF;border:1px solid rgba(0,105,141,0.06);">
        <div class="shrink-0"><span class="block text-8xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:rgba(0,105,141,0.07);">01</span></div>
        <div class="flex-1">
          <h3 class="text-2xl font-bold mb-1.5 leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Amazon</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">Comprehensive account management on Amazon Europe and international. From brand registry to listing optimization and advertising campaigns within the platform.</p>
        </div>
      </div>

      <div class="flex flex-col md:flex-row gap-4 md:gap-10 items-start p-5 md:p-8 rounded-xl" style="background:#FFFFFF;border:1px solid rgba(0,105,141,0.06);">
        <div class="shrink-0"><span class="block text-8xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:rgba(0,105,141,0.07);">02</span></div>
        <div class="flex-1">
          <h3 class="text-2xl font-bold mb-1.5 leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Marketplaces</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We take your product to other platforms and marketplaces relevant to your sector, diversifying sales channels and reducing dependence on just one.</p>
        </div>
      </div>

      <div class="flex flex-col md:flex-row gap-4 md:gap-10 items-start p-5 md:p-8 rounded-xl" style="background:#FFFFFF;border:1px solid rgba(0,105,141,0.06);">
        <div class="shrink-0"><span class="block text-8xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:rgba(0,105,141,0.07);">03</span></div>
        <div class="flex-1">
          <h3 class="text-2xl font-bold mb-1.5 leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">E-commerce</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We create and optimize your own online stores with the right tools for your product, your customer, and your business model.</p>
        </div>
      </div>

