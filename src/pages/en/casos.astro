---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Case Studies — Blue Unicorn"
  description="Real business development projects, brand creation, and digital scaling. Results, not promises."
  showHeader={true}
>

<!-- ═════════════════════════════════════════
HERO — clean, no decoration
═════════════════════════════════════════ -->
<section class="text-center px-6 md:px-12 pt-20 pb-10 md:pt-32 md:pb-16" style="background:#FFFFFF;">
  <h1 class="leading-[0.92] tracking-tight mb-4" style="color:#1A1A1A;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(2.6rem,7vw,5rem);">
    Case Studies
  </h1>
  <p class="text-lg max-w-[38ch] mx-auto leading-relaxed" style="color:#6B7280;font-family:'Satoshi',sans-serif;">
    We don't talk about what we do.<br>We show what we've achieved.
  </p>
</section>

<!-- ═════════════════════════════════════════
CASE 01 — Giant background number + card
═════════════════════════════════════════ -->
<section class="relative px-6 md:px-12 py-16 md:py-28" style="background:#0A1628;">

  <span class="absolute select-none pointer-events-none z-0" style="top:-0.15em;left:0;font-family:'Space Grotesk',sans-serif;font-weight:900;font-size:clamp(14rem,28vw,26rem);line-height:1;color:rgba(255,255,255,0.02);">01</span>

  <div class="relative z-10 max-w-3xl mx-auto">
    <span class="inline-block text-xs font-semibold tracking-[0.15em] uppercase px-3 py-1.5 rounded-full mb-6" style="background:rgba(15,37,72,0.5);color:#A8D8EA;font-family:'Satoshi',sans-serif;">Business Development</span>

    <div class="flex items-baseline gap-4 mb-6">
      <span class="text-5xl md:text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:#A8D8EA;">3×</span>
      <span class="text-base md:text-lg leading-snug" style="color:rgba(255,255,255,0.5);font-family:'Satoshi',sans-serif;">return on<br>investment</span>
    </div>

    <h3 class="text-xl md:text-2xl font-bold mb-8 leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#ffffff;">
      From a napkin idea to a brand selling on Amazon Europe
    </h3>

    <div class="grid md:grid-cols-3 gap-6">
      <div>
        <p class="text-xs font-semibold tracking-[0.12em] uppercase mb-2" style="color:rgba(255,255,255,0.35);font-family:'Satoshi',sans-serif;">Problem</p>
        <p class="text-sm leading-relaxed" style="color:rgba(255,255,255,0.55);font-family:'Satoshi',sans-serif;">Entrepreneur with a home product idea, no manufacturing or online sales experience. Didn't know where to start.</p>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-[0.12em] uppercase mb-2" style="color:rgba(255,255,255,0.35);font-family:'Satoshi',sans-serif;">Solution</p>
        <p class="text-sm leading-relaxed" style="color:rgba(255,255,255,0.55);font-family:'Satoshi',sans-serif;">Market validation, Asian manufacturer, product development, brand from scratch, and launch on Amazon ES, DE, and FR.</p>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-[0.12em] uppercase mb-2" style="color:rgba(255,255,255,0.35);font-family:'Satoshi',sans-serif;">Result</p>
        <p class="text-sm leading-relaxed" style="color:rgba(255,255,255,0.55);font-family:'Satoshi',sans-serif;">Brand in 3 European markets. Profitable from month six. +€200K in sales in the first year.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═════════════════════════════════════════
CASE 02
═════════════════════════════════════════ -->
<section class="relative px-6 md:px-12 py-16 md:py-28" style="background:#FFFFFF;">

  <span class="absolute select-none pointer-events-none z-0" style="top:-0.15em;right:0;font-family:'Space Grotesk',sans-serif;font-weight:900;font-size:clamp(14rem,28vw,26rem);line-height:1;color:rgba(22,54,103,0.03);">02</span>

  <div class="relative z-10 max-w-3xl mx-auto">
    <span class="inline-block text-xs font-semibold tracking-[0.15em] uppercase px-3 py-1.5 rounded-full mb-6" style="background:rgba(0,105,141,0.1);color:#00698D;font-family:'Satoshi',sans-serif;">Product & Sourcing</span>

    <div class="flex items-baseline gap-4 mb-6">
      <span class="text-5xl md:text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:#00698D;">+240%</span>
      <span class="text-base md:text-lg leading-snug" style="color:#6B7280;font-family:'Satoshi',sans-serif;">increase in<br>net margin</span>
    </div>

    <h3 class="text-xl md:text-2xl font-bold mb-8 leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
      Manufacturing relocalization and cost optimization for a cosmetics brand
    </h3>

    <div class="grid md:grid-cols-3 gap-6">
      <div>
        <p class="text-xs font-semibold tracking-[0.12em] uppercase mb-2" style="color:rgba(0,0,0,0.3);font-family:'Satoshi',sans-serif;">Problem</p>
        <p class="text-sm leading-relaxed" style="color:#6B7280;font-family:'Satoshi',sans-serif;">Spanish natural cosmetics brand with tight margins due to a single expensive supplier blocking growth.</p>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-[0.12em] uppercase mb-2" style="color:rgba(0,0,0,0.3);font-family:'Satoshi',sans-serif;">Solution</p>
        <p class="text-sm leading-relaxed" style="color:#6B7280;font-family:'Satoshi',sans-serif;">Sourcing from 3 manufacturers in Asia, negotiation, production supervision, quality control, and CE certifications.</p>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-[0.12em] uppercase mb-2" style="color:rgba(0,0,0,0.3);font-family:'Satoshi',sans-serif;">Result</p>
        <p class="text-sm leading-relaxed" style="color:#6B7280;font-family:'Satoshi',sans-serif;">−40% unit cost. Net margin from 22% to 53%. Scaled production without losing quality.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═════════════════════════════════════════
CASE 03
═════════════════════════════════════════ -->
<section class="relative px-6 md:px-12 py-16 md:py-28" style="background:#F2F5F8;">

  <span class="absolute select-none pointer-events-none z-0" style="top:-0.15em;left:0;font-family:'Space Grotesk',sans-serif;font-weight:900;font-size:clamp(14rem,28vw,26rem);line-height:1;color:rgba(22,54,103,0.04);">03</span>

  <div class="relative z-10 max-w-3xl mx-auto">
    <span class="inline-block text-xs font-semibold tracking-[0.15em] uppercase px-3 py-1.5 rounded-full mb-6" style="background:rgba(0,136,179,0.1);color:#0088B3;font-family:'Satoshi',sans-serif;">Digital Channels & Scaling</span>

    <div class="flex items-baseline gap-4 mb-6">
      <span class="text-5xl md:text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:#0088B3;">500K</span>
      <span class="text-base md:text-lg leading-snug" style="color:#6B7280;font-family:'Satoshi',sans-serif;">€ in sales<br>first year</span>
    </div>

    <h3 class="text-xl md:text-2xl font-bold mb-8 leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
      Expansion of accessories brand to 5 European marketplaces
    </h3>

    <div class="grid md:grid-cols-3 gap-6">
      <div>
        <p class="text-xs font-semibold tracking-[0.12em] uppercase mb-2" style="color:rgba(0,0,0,0.3);font-family:'Satoshi',sans-serif;">Problem</p>
        <p class="text-sm leading-relaxed" style="color:#6B7280;font-family:'Satoshi',sans-serif;">Fashion accessories brand selling only in Spain via their own website. Wanted Europe but didn't know how.</p>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-[0.12em] uppercase mb-2" style="color:rgba(0,0,0,0.3);font-family:'Satoshi',sans-serif;">Solution</p>
        <p class="text-sm leading-relaxed" style="color:#6B7280;font-family:'Satoshi',sans-serif;">Amazon Seller Central in ES, DE, FR, IT, and UK. Listings, A+ Content, Brand Registry, and campaigns.</p>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-[0.12em] uppercase mb-2" style="color:rgba(0,0,0,0.3);font-family:'Satoshi',sans-serif;">Result</p>
        <p class="text-sm leading-relaxed" style="color:#6B7280;font-family:'Satoshi',sans-serif;">+€500K first year. 5 marketplaces with FBA. Brand registered on Amazon Brand Registry.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═════════════════════════════════════════
FINAL CTA — same as index, only copy changes
═════════════════════════════════════════ -->
<section class="relative flex flex-col md:flex-row items-center justify-center gap-12 md:gap-20 px-6 md:px-12 py-12 md:py-32" style="background:#FFFFFF;">
  <div class="text-center md:text-left max-w-lg">
    <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.05]" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Every case starts<br>with a<br>conversation</h2>
    <p class="mt-6 text-base md:text-lg leading-relaxed" style="color:#6B7280;font-family:'Satoshi',sans-serif;">If you have a project, an idea, or a business you want to take to the next level, let's talk. No obligation.</p>
    <div class="mt-8">
      <a href="/en/get-started" class="animated-btn" style="position:relative;display:inline-flex;align-items:center;justify-content:center;height:56px;padding:0 52px 0 36px;font-size:16px;background-color:#0F2548;border-radius:4px;font-weight:600;font-family:'Satoshi',sans-serif;color:#ffffff;cursor:pointer;overflow:hidden;text-decoration:none;box-shadow:0 0.625em 1.2em 0 rgba(15,37,72,0.2);">
        <span class="text" style="position:relative;z-index:2;transition:transform 0.8s cubic-bezier(0.23,1,0.32,1);">Tell us about your project</span>
        <svg class="arr-1" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;right:22px;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#ffffff" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        <svg class="arr-2" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;left:-25%;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#ffffff" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        <span class="circle" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:20px;height:20px;background-color:#00698D;border-radius:50%;opacity:0;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);"></span>
      </a>
    </div>
  </div>
  <div class="grid grid-cols-2 gap-6 md:gap-8 shrink-0">
    <svg viewBox="0 0 100 100" class="w-20 h-20 md:w-24 md:h-24"><path d="M50 8 Q50 50 92 50 Q50 50 50 92 Q50 50 8 50 Q50 50 50 8Z" fill="#0F2548" opacity="0.8"/></svg>
    <svg viewBox="0 0 100 100" class="w-20 h-20 md:w-24 md:h-24"><rect x="8" y="8" width="84" height="84" rx="3" fill="#163667" opacity="0.8"/></svg>
    <svg viewBox="0 0 100 100" class="w-20 h-20 md:w-24 md:h-24"><circle cx="50" cy="50" r="42" fill="#0B4F7A" opacity="0.8"/></svg>
    <svg viewBox="0 0 100 100" class="w-20 h-20 md:w-24 md:h-24"><polygon points="50,4 96,96 4,96" fill="#00698D" opacity="0.8"/></svg>
  </div>
</section>

<!-- ═════════════════════════════════════════
FOOTER
═════════════════════════════════════════ -->
<footer style="background:#0F2548;font-family:'Satoshi',sans-serif;">
  <div class="max-w-6xl mx-auto px-6 md:px-12 py-14 md:py-20">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
      <div class="col-span-2 md:col-span-1 flex flex-col gap-4">
        <div class="bg-white rounded-xl p-3 inline-flex"><img src="/images/logo-marino.png" alt="Unicornio Azul" class="h-6 w-auto" /></div>
        <p class="text-sm leading-relaxed" style="color:rgba(255,255,255,0.5);">Real solutions for extraordinary ideas.</p>
        <a href="mailto:hola@unicornioazul.com" class="text-sm font-medium hover:underline" style="color:rgba(255,255,255,0.65);">hola@unicornioazul.com</a>
        <div class="flex gap-4">
          <a href="https://linkedin.com" target="_blank" rel="noopener" class="text-sm font-medium hover:underline" style="color:rgba(255,255,255,0.55);">LinkedIn</a>
          <a href="https://instagram.com" target="_blank" rel="noopener" class="text-sm font-medium hover:underline" style="color:rgba(255,255,255,0.55);">Instagram</a>
        </div>
      </div>
      <div class="flex flex-col gap-3">
        <p class="text-sm font-semibold tracking-tight mb-1" style="color:rgba(255,255,255,0.8);">What we do</p>
        <a href="/en/que-hacemos/desarrollo-de-negocios" class="text-sm hover:underline" style="color:rgba(255,255,255,0.5);">Business Development</a>
        <a href="/en/que-hacemos/producto-compras-internacionales" class="text-sm hover:underline" style="color:rgba(255,255,255,0.5);">Product & Sourcing</a>
        <a href="/en/que-hacemos/marketing-digital" class="text-sm hover:underline" style="color:rgba(255,255,255,0.5);">Digital Marketing</a>
        <a href="/en/que-hacemos/canales-digitales-escalado" class="text-sm hover:underline" style="color:rgba(255,255,255,0.5);">Channels & Scaling</a>
      </div>
      <div class="flex flex-col gap-3">
        <p class="text-sm font-semibold tracking-tight mb-1" style="color:rgba(255,255,255,0.8);">How we work</p>
        <a href="/en/como-trabajamos#proceso" class="text-sm hover:underline" style="color:rgba(255,255,255,0.5);">5-Step Process</a>
        <a href="/en/metodologia-sorie" class="text-sm hover:underline" style="color:rgba(255,255,255,0.5);">SORIE&trade; Methodology</a>
        <a href="/en/casos" class="text-sm hover:underline" style="color:rgba(255,255,255,0.5);">Case Studies</a>
      </div>
      <div class="flex flex-col gap-3">
        <p class="text-sm font-semibold tracking-tight mb-1" style="color:rgba(255,255,255,0.8);">Company</p>
        <a href="/en/sobre-nosotros" class="text-sm hover:underline" style="color:rgba(255,255,255,0.5);">Who we are</a>
        <a href="/en/contacto" class="text-sm hover:underline" style="color:rgba(255,255,255,0.5);">Contact</a>
      </div>
    </div>
    <div class="mt-12 pt-8 border-t flex flex-col md:flex-row justify-between gap-4" style="border-color:rgba(255,255,255,0.08);">
      <p class="text-xs" style="color:rgba(255,255,255,0.35);">&copy; 2026 Blue Unicorn. All rights reserved.</p>
      <p class="text-xs" style="color:rgba(255,255,255,0.25);">Madrid, Spain</p>
    </div>
  </div>
</footer>

</BaseLayout>
