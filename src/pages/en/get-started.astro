---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Tell us about your project | Unicornio Azul"
  description="Tell us about your project in a step-by-step form. We review your business idea, product or digital channel and tell you if it makes sense to build it together."
  showHeader={true}
>

<!-- ═══════════════════════════════════════════════════
  MULTI-STEP FORM — Conversational
  Each step is ONE question. Fallback always visible.
  ═══════════════════════════════════════════════════ -->
<section style="background:#FFFFFF; padding-top:48px; padding-bottom:48px;" class="flex flex-col items-center px-4 md:px-8">
  <div class="w-full max-w-xl mx-auto">

    <!-- Step indicator -->
    <div class="flex items-center justify-center gap-3 mb-10 md:mb-12" id="step-indicator">
      <span class="step-dot w-3 h-3 rounded-full transition-all duration-500" style="background:#0F2548;" data-step="1"></span>
      <span class="step-line w-8 h-px transition-all duration-500" style="background:rgba(15,37,72,0.2);" data-line="1"></span>
      <span class="step-dot w-3 h-3 rounded-full transition-all duration-500" style="background:rgba(15,37,72,0.15);" data-step="2"></span>
      <span class="step-line w-8 h-px transition-all duration-500" style="background:rgba(15,37,72,0.1);" data-line="2"></span>
      <span class="step-dot w-3 h-3 rounded-full transition-all duration-500" style="background:rgba(15,37,72,0.15);" data-step="3"></span>
      <span class="step-line w-8 h-px transition-all duration-500" style="background:rgba(15,37,72,0.1);" data-line="3"></span>
      <span class="step-dot w-3 h-3 rounded-full transition-all duration-500" style="background:rgba(15,37,72,0.15);" data-step="4"></span>
    </div>

    <!-- ═══ FORM ═══ -->
    <form id="multistep-form" class="relative" style="min-height:420px;" novalidate>
      <input type="text" name="_honey" style="display:none !important;visibility:hidden;position:absolute;left:-9999px;" tabindex="-1" autocomplete="off" aria-hidden="true">

      <!-- ── STEP 1: What can we help you with? ── -->
      <fieldset class="step active" data-step="1" style="border:none;padding:0;margin:0;transition:opacity 0.4s ease,transform 0.4s ease,position 0s 0.4s;">
        <legend class="block text-2xl md:text-3xl font-bold text-center mb-3" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
          What can we help you bring to life?
        </legend>
        <p class="text-sm text-center mb-8 opacity-65" style="font-family:'Satoshi',sans-serif;color:#6B7280;">Choose the option that best fits what you have in mind.</p>
        <div class="grid grid-cols-2 gap-3">
          <label class="step-option group cursor-pointer flex items-center gap-5 p-5 rounded-xl border-2 transition-all duration-300 hover:shadow-md" style="border-color:rgba(15,37,72,0.1); --card-r:15; --card-g:37; --card-b:72;">
            <input type="radio" name="objetivo" value="negocios" class="sr-only peer" required>
            <svg viewBox="0 0 40 40" class="w-10 h-10 shrink-0 transition-transform duration-300 group-hover:scale-110"><path d="M20 0Q20 20 40 20Q20 20 20 40Q20 20 0 20Q20 20 20 0Z" fill="#0F2548"/></svg>
            <div class="text-left">
              <span class="text-base font-semibold block" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Business development</span>
              <span class="text-sm opacity-65" style="font-family:'Satoshi',sans-serif;color:#6B7280;">Business model, brand, and strategy from scratch.</span>
            </div>
          </label>
          <label class="step-option group cursor-pointer flex items-center gap-5 p-5 rounded-xl border-2 transition-all duration-300 hover:shadow-md" style="border-color:rgba(15,37,72,0.1); --card-r:22; --card-g:54; --card-b:103;">
            <input type="radio" name="objetivo" value="producto" class="sr-only peer">
            <svg viewBox="0 0 40 40" class="w-10 h-10 shrink-0 transition-transform duration-300 group-hover:scale-110"><rect x="0" y="0" width="40" height="40" rx="3" fill="#163667"/></svg>
            <div class="text-left">
              <span class="text-base font-semibold block" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Product & international sourcing</span>
              <span class="text-sm opacity-65" style="font-family:'Satoshi',sans-serif;color:#6B7280;">Product development, sourcing, manufacturing, and import/export.</span>
            </div>
          </label>
          <label class="step-option group cursor-pointer flex items-center gap-5 p-5 rounded-xl border-2 transition-all duration-300 hover:shadow-md" style="border-color:rgba(15,37,72,0.1); --card-r:0; --card-g:105; --card-b:141;">
            <input type="radio" name="objetivo" value="marketing" class="sr-only peer">
            <svg viewBox="0 0 40 40" class="w-10 h-10 shrink-0 transition-transform duration-300 group-hover:scale-110"><circle cx="20" cy="20" r="20" fill="#00698D"/></svg>
            <div class="text-left">
              <span class="text-base font-semibold block" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Digital marketing</span>
              <span class="text-sm opacity-65" style="font-family:'Satoshi',sans-serif;color:#6B7280;">Branding, digital strategy, SEO, and sales-driven advertising.</span>
            </div>
          </label>
          <label class="step-option group cursor-pointer flex items-center gap-5 p-5 rounded-xl border-2 transition-all duration-300 hover:shadow-md" style="border-color:rgba(15,37,72,0.1); --card-r:0; --card-g:136; --card-b:179;">
            <input type="radio" name="objetivo" value="escalado" class="sr-only peer">
            <svg viewBox="0 0 40 40" class="w-10 h-10 shrink-0 transition-transform duration-300 group-hover:scale-110"><polygon points="20,0 40,40 0,40" fill="#0088B3"/></svg>
            <div class="text-left">
              <span class="text-base font-semibold block" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Digital channels & scaling</span>
              <span class="text-sm opacity-65" style="font-family:'Satoshi',sans-serif;color:#6B7280;">Amazon, e-commerce, and international marketplaces.</span>
            </div>
          </label>
          <label class="step-option group cursor-pointer flex items-center gap-5 p-5 rounded-xl border-2 transition-all duration-300 hover:shadow-md col-span-2" style="border-color:rgba(15,37,72,0.1); --card-r:22; --card-g:54; --card-b:103;">
            <input type="radio" name="objetivo" value="otro" class="sr-only peer">
            <svg viewBox="0 0 40 40" class="w-10 h-10 shrink-0 transition-transform duration-300 group-hover:scale-110" style="opacity:0.5;">
              <text x="20" y="29" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-size="28" font-weight="700" fill="#6B7280">?</text>
            </svg>
            <div class="text-left">
              <span class="text-base font-semibold block" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Something different</span>
              <span class="text-sm opacity-65" style="font-family:'Satoshi',sans-serif;color:#6B7280;">Tell us what you need and we'll figure out how to help.</span>
            </div>
          </label>
        </div>
        <div class="flex justify-center mt-8">
          <button type="button" class="step-next animated-btn" style="position:relative;display:inline-flex;align-items:center;justify-content:center;height:48px;padding:0 48px 0 28px;font-size:15px;background-color:rgba(15,37,72,0.06);border-radius:4px;font-weight:600;font-family:'Satoshi',sans-serif;color:rgba(15,37,72,0.3);cursor:not-allowed;overflow:hidden;border:none;transition:all 0.3s ease;" disabled>
            <span class="text" style="position:relative;z-index:2;transition:transform 0.8s cubic-bezier(0.23,1,0.32,1);">Next</span>
            <svg class="arr-1" style="position:absolute;top:50%;margin-top:-9px;width:18px;height:18px;z-index:2;right:20px;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <svg class="arr-2" style="position:absolute;top:50%;margin-top:-9px;width:18px;height:18px;z-index:2;left:-25%;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#ffffff" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <span class="circle" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:18px;height:18px;background-color:#00698D;border-radius:50%;opacity:0;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);"></span>
          </button>
        </div>
      </fieldset>

      <!-- ── STEP 2: What's your name? ── -->
      <fieldset class="step" data-step="2" style="border:none;padding:0;margin:0;opacity:0;transform:translateX(40px);pointer-events:none;position:absolute;top:0;left:0;width:100%;">
        <legend class="block text-2xl md:text-3xl font-bold text-center mb-3" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
          Great. What's your name?
        </legend>
        <p class="text-sm text-center mb-8 opacity-65" style="font-family:'Satoshi',sans-serif;color:#6B7280;">So we know how to address you.</p>
        <div class="max-w-sm mx-auto">
          <input type="text" name="nombre" required placeholder="Your full name"
            class="w-full px-4 py-3.5 rounded-lg border-2 text-base transition-all duration-300 outline-none"
            style="font-family:'Satoshi',sans-serif;border-color:rgba(22,54,103,0.2);color:#1A1A1A;background:#FFFFFF;"
            onfocus="this.style.borderColor='#163667';this.style.boxShadow='0 0 0 3px rgba(22,54,103,0.06)'"
            onblur="this.style.borderColor='rgba(22,54,103,0.2)';this.style.boxShadow='none'"
          >
          <span class="field-error" data-field="nombre"></span>
        </div>
        <div class="flex justify-center gap-4 mt-8">
          <button type="button" class="step-prev py-3 px-6 rounded text-base font-semibold transition-all duration-300 hover:opacity-70" style="font-family:'Satoshi',sans-serif;background:transparent;color:#6B7280;border:none;cursor:pointer;">← Back</button>
          <button type="button" class="step-next animated-btn" style="position:relative;display:inline-flex;align-items:center;justify-content:center;height:48px;padding:0 48px 0 28px;font-size:15px;background-color:rgba(15,37,72,0.06);border-radius:4px;font-weight:600;font-family:'Satoshi',sans-serif;color:rgba(15,37,72,0.3);cursor:not-allowed;overflow:hidden;border:none;transition:all 0.3s ease;" disabled>
            <span class="text" style="position:relative;z-index:2;transition:transform 0.8s cubic-bezier(0.23,1,0.32,1);">Next</span>
            <svg class="arr-1" style="position:absolute;top:50%;margin-top:-9px;width:18px;height:18px;z-index:2;right:20px;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <svg class="arr-2" style="position:absolute;top:50%;margin-top:-9px;width:18px;height:18px;z-index:2;left:-25%;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#ffffff" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <span class="circle" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:18px;height:18px;background-color:#00698D;border-radius:50%;opacity:0;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);"></span>
          </button>
        </div>
      </fieldset>

      <!-- ── STEP 3: Rapport ── -->
      <fieldset class="step" data-step="3" style="border:none;padding:0;margin:0;opacity:0;transform:translateX(40px);pointer-events:none;position:absolute;top:0;left:0;width:100%;">
        <legend class="block text-2xl md:text-3xl font-bold text-center mb-3" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
          Tell us more. Is there anything you'd like to share?
        </legend>
        <p class="text-sm text-center mb-8 opacity-65 max-w-xs mx-auto" style="font-family:'Satoshi',sans-serif;color:#6B7280;">This isn't required, but any detail helps us prepare better.</p>
        <div class="max-w-sm mx-auto">
          <textarea name="contexto" rows="3" placeholder="Whatever you have in mind…"
            class="w-full px-4 py-3.5 rounded-lg border-2 text-base transition-all duration-300 outline-none resize-none"
            style="font-family:'Satoshi',sans-serif;border-color:rgba(22,54,103,0.2);color:#1A1A1A;background:#FFFFFF;"
            onfocus="this.style.borderColor='#163667';this.style.boxShadow='0 0 0 3px rgba(22,54,103,0.06)'"
            onblur="this.style.borderColor='rgba(22,54,103,0.2)';this.style.boxShadow='none'"
          ></textarea>
        </div>
        <div class="flex justify-center gap-4 mt-8">
          <button type="button" class="step-prev py-3 px-6 rounded text-base font-semibold transition-all duration-300 hover:opacity-70" style="font-family:'Satoshi',sans-serif;background:transparent;color:#6B7280;border:none;cursor:pointer;">← Back</button>
          <button type="button" class="step-next animated-btn" style="position:relative;display:inline-flex;align-items:center;justify-content:center;height:48px;padding:0 48px 0 28px;font-size:15px;background-color:#163667;border-radius:4px;font-weight:600;font-family:'Satoshi',sans-serif;color:#ffffff;cursor:pointer;overflow:hidden;border:none;box-shadow:0 0.625em 1em 0 rgba(22,54,103,0.20);">
            <span class="text" style="position:relative;z-index:2;transition:transform 0.8s cubic-bezier(0.23,1,0.32,1);">Next</span>
            <svg class="arr-1" style="position:absolute;top:50%;margin-top:-9px;width:18px;height:18px;z-index:2;right:20px;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#ffffff" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <svg class="arr-2" style="position:absolute;top:50%;margin-top:-9px;width:18px;height:18px;z-index:2;left:-25%;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#ffffff" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <span class="circle" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:18px;height:18px;background-color:#00698D;border-radius:50%;opacity:0;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);"></span>
          </button>
        </div>
      </fieldset>

      <!-- ── STEP 4: Email and phone ── -->
      <fieldset class="step" data-step="4" style="border:none;padding:0;margin:0;opacity:0;transform:translateX(40px);pointer-events:none;position:absolute;top:0;left:0;width:100%;">
        <legend class="block text-2xl md:text-3xl font-bold text-center mb-3" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
          What's the best way to reach you?
        </legend>
        <p class="text-sm text-center mb-8 opacity-65" style="font-family:'Satoshi',sans-serif;color:#6B7280;">Choose how you'd like us to get back to you.</p>
        <div class="flex flex-col gap-4 max-w-sm mx-auto">
          <div>
            <label class="text-sm font-semibold mb-1.5 block" style="font-family:'Satoshi',sans-serif;color:#1A1A1A;">Email</label>
            <input type="email" name="email" required placeholder="you@email.com"
              class="w-full px-4 py-3.5 rounded-lg border-2 text-base transition-all duration-300 outline-none"
              style="font-family:'Satoshi',sans-serif;border-color:rgba(22,54,103,0.2);color:#1A1A1A;background:#FFFFFF;"
              onfocus="this.style.borderColor='#163667';this.style.boxShadow='0 0 0 3px rgba(22,54,103,0.06)'"
              onblur="this.style.borderColor='rgba(22,54,103,0.2)';this.style.boxShadow='none'"
            >
            <span class="field-error" data-field="email"></span>
          </div>
          <div>
            <label class="text-sm font-semibold mb-1.5 block" style="font-family:'Satoshi',sans-serif;color:#1A1A1A;">Phone <span class="font-normal opacity-40">(optional)</span></label>
            <input type="tel" name="telefono" placeholder="+34 617 348 381"
              class="w-full px-4 py-3.5 rounded-lg border-2 text-base transition-all duration-300 outline-none"
              style="font-family:'Satoshi',sans-serif;border-color:rgba(22,54,103,0.2);color:#1A1A1A;background:#FFFFFF;"
              onfocus="this.style.borderColor='#163667';this.style.boxShadow='0 0 0 3px rgba(22,54,103,0.06)'"
              onblur="this.style.borderColor='rgba(22,54,103,0.2)';this.style.boxShadow='none'"
            >
          </div>
          <label class="flex items-start gap-3 cursor-pointer select-none mt-1" style="font-family:'Satoshi',sans-serif;">
            <input type="checkbox" name="privacidad" id="privacy-consent" required
              class="mt-1 shrink-0"
              style="width:18px;height:18px;accent-color:#163667;cursor:pointer;"
            >
            <span class="text-sm leading-relaxed" style="color:#374151;">
              I have read and accept the <a href="/en/privacy" target="_blank" rel="noopener" class="font-semibold underline underline-offset-2" style="color:#163667;">privacy policy</a>
              <span style="color:#D92D20;">*</span>
            </span>
          </label>
          <span class="field-error" data-field="privacidad"></span>
        </div>
        <div class="flex justify-center gap-4 mt-8">
          <button type="button" class="step-prev py-3 px-6 rounded text-base font-semibold transition-all duration-300 hover:opacity-70" style="font-family:'Satoshi',sans-serif;background:transparent;color:#6B7280;border:none;cursor:pointer;">← Back</button>
          <button type="submit" class="animated-btn" style="position:relative;display:inline-flex;align-items:center;justify-content:center;height:48px;padding:0 48px 0 28px;font-size:15px;background-color:rgba(15,37,72,0.06);border-radius:4px;font-weight:600;font-family:'Satoshi',sans-serif;color:rgba(15,37,72,0.3);cursor:not-allowed;overflow:hidden;text-decoration:none;border:none;transition:all 0.3s ease;" disabled>
            <span class="text" style="position:relative;z-index:2;transition:transform 0.8s cubic-bezier(0.23,1,0.32,1);">Send</span>
            <svg class="arr-1" style="position:absolute;top:50%;margin-top:-9px;width:18px;height:18px;z-index:2;right:20px;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <svg class="arr-2" style="position:absolute;top:50%;margin-top:-9px;width:18px;height:18px;z-index:2;left:-25%;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#ffffff" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <span class="circle" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:18px;height:18px;background-color:#00698D;border-radius:50%;opacity:0;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);"></span>
          </button>
        </div>
      </fieldset>

    </form>

    <!-- ═══ Fallback: Would you rather reach out yourself? ═══ -->
    <div id="form-fallback" class="text-center mt-10 pt-8" style="border-top:1px solid rgba(15,37,72,0.06);">
      <p class="text-sm" style="font-family:'Satoshi',sans-serif;color:#6B7280;">
        Would you rather reach out directly?
      </p>
      <div class="mt-3 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-5">
        <a href="mailto:luis.chicharro@unicornioazul.es" class="text-sm font-semibold no-underline transition-all duration-300 hover:opacity-70" style="font-family:'Space Grotesk',sans-serif;color:#163667;">luis.chicharro@unicornioazul.es</a>
        <a href="https://wa.me/34617348381" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold no-underline transition-colors duration-300 hover:text-[#25D366]" style="font-family:'Space Grotesk',sans-serif;color:#163667;">WhatsApp</a>
      </div>
      <a href="/en/contact" class="inline-flex items-center gap-2 mt-3 text-sm font-semibold no-underline transition-all duration-300 hover:opacity-70" style="font-family:'Space Grotesk',sans-serif;color:#163667;position:relative;z-index:10;">
        Go to the contact page
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "name": "Get Started — Unicornio Azul",
        "description": "Step-by-step form to tell us about your business idea, product or digital channel.",
        "url": "https://unicornioazul.es/en/get-started",
        "isPartOf": { "@type": "WebSite", "name": "Unicornio Azul", "url": "https://unicornioazul.es/en" }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://unicornioazul.es/en" },
          { "@type": "ListItem", "position": 2, "name": "Get started" }
        ]
      }
    ]
  }
</script>

</BaseLayout>

<script>
  const form = document.getElementById('multistep-form');
  const steps = form.querySelectorAll('.step');
  const dots = document.querySelectorAll('.step-dot');
  const lines = document.querySelectorAll('.step-line');
  const totalSteps = 4;
  let currentStep = 1;

  function showStep(n) {
    steps.forEach(s => {
      const sn = parseInt(s.dataset.step);
      if (sn === n) {
        s.style.position = 'relative';
        s.style.opacity = '1';
        s.style.transform = 'translateX(0)';
        s.style.pointerEvents = 'auto';
      } else {
        s.style.position = 'absolute';
        s.style.opacity = '0';
        s.style.transform = sn < n ? 'translateX(-40px)' : 'translateX(40px)';
        s.style.pointerEvents = 'none';
      }
    });

    dots.forEach(d => {
      const ds = parseInt(d.dataset.step);
      if (ds === n) { d.style.background = '#0F2548'; d.style.transform = 'scale(1.3)'; }
      else if (ds < n) { d.style.background = '#0F2548'; d.style.opacity = '0.5'; d.style.transform = 'scale(1)'; }
      else { d.style.background = 'rgba(15,37,72,0.15)'; d.style.opacity = '1'; d.style.transform = 'scale(1)'; }
    });

    lines.forEach(l => {
      const ls = parseInt(l.dataset.line);
      l.style.background = ls < n ? 'rgba(15,37,72,0.4)' : 'rgba(15,37,72,0.1)';
    });

    currentStep = n;
  }

  // Next buttons
  form.querySelectorAll('.step-next').forEach(btn => {
    btn.addEventListener('click', () => { if (currentStep < totalSteps) showStep(currentStep + 1); });
  });

  // Prev buttons
  form.querySelectorAll('.step-prev').forEach(btn => {
    btn.addEventListener('click', () => { if (currentStep > 1) showStep(currentStep - 1); });
  });

  // Step 1: enable next on radio select
  const step1Radios = form.querySelectorAll('input[name="objetivo"]');
  const step1Next = form.querySelector('[data-step="1"] .step-next');
  step1Radios.forEach(r => r.addEventListener('change', () => enableBtn(step1Next)));

  // Visual selection for radio cards
  document.querySelectorAll('.step-option input[type="radio"]').forEach(input => {
    input.addEventListener('change', () => {
      document.querySelectorAll('.step-option').forEach(opt => {
        opt.classList.remove('selected');
        opt.style.borderColor = 'rgba(15,37,72,0.1)'; opt.style.background = 'transparent';
      });
      const label = input.closest('.step-option');
      label.classList.add('selected');
    });
  });

  // Step 2: enable next when name is not empty
  const step2Next = form.querySelector('[data-step="2"] .step-next');
  const nombreInput = form.querySelector('input[name="nombre"]');
  nombreInput.addEventListener('input', () => {
    const val = nombreInput.value.trim();
    if (val) { enableBtn(step2Next); }
    else { disableBtn(step2Next); }
    clearFieldError('nombre');
  });

  // Step 4: enable submit when email is valid; validate on blur
  const step4Submit = form.querySelector('[data-step="4"] button[type="submit"]');
  const emailInput = form.querySelector('input[name="email"]');
  const privacyInput = form.querySelector('input[name="privacidad"]');
  const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function checkEmailValid() {
    const val = emailInput.value.trim();
    return val && emailRe.test(val);
  }

  function updateStep4Submit() {
    if (checkEmailValid() && privacyInput?.checked) enableBtn(step4Submit);
    else disableBtn(step4Submit);
  }

  emailInput.addEventListener('input', () => {
    updateStep4Submit();
    clearFieldError('email');
  });

  emailInput.addEventListener('blur', () => {
    const val = emailInput.value.trim();
    if (!val) { clearFieldError('email'); updateStep4Submit(); return; }
    if (!emailRe.test(val)) {
      showFieldError('email', "That email doesn't look right. Could you double-check?");
      disableBtn(step4Submit);
    } else {
      clearFieldError('email');
      updateStep4Submit();
    }
  });

  privacyInput?.addEventListener('change', () => {
    clearFieldError('privacidad');
    updateStep4Submit();
  });

  // ── Button helpers ──
  function enableBtn(btn) {
    if (!btn) return;
    btn.disabled = false; btn.style.cursor = 'pointer';
    btn.style.background = '#163667'; btn.style.color = '#ffffff';
    btn.style.boxShadow = '0 0.625em 1em 0 rgba(22,54,103,0.20)';
    const arrow = btn.querySelector('.arr-1');
    if (arrow) arrow.style.stroke = '#ffffff';
  }
  function disableBtn(btn) {
    if (!btn) return;
    btn.disabled = true; btn.style.cursor = 'not-allowed';
    btn.style.background = 'rgba(15,37,72,0.06)'; btn.style.color = 'rgba(15,37,72,0.3)';
    btn.style.boxShadow = 'none';
    const arrow = btn.querySelector('.arr-1');
    if (arrow) arrow.style.stroke = 'currentColor';
  }

  function showFieldError(fieldName, message) {
    const span = document.querySelector('.field-error[data-field="' + fieldName + '"]');
    const input = form.querySelector('input[name="' + fieldName + '"]');
    if (span) { span.textContent = message; span.classList.add('visible'); }
    if (input) { input.style.borderColor = '#D92D20'; }
  }
  function clearFieldError(fieldName) {
    const span = document.querySelector('.field-error[data-field="' + fieldName + '"]');
    const input = form.querySelector('input[name="' + fieldName + '"]');
    if (span) { span.textContent = ''; span.classList.remove('visible'); }
    if (input) { input.style.borderColor = 'rgba(22,54,103,0.2)'; }
  }

  // Submit → FormSubmit (email to Luis)
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = nombreInput.value.trim();
    const email = emailInput.value.trim();
    let hasError = false;

    if (!name) { showFieldError('nombre', 'Please tell us your name.'); hasError = true; }
    if (!email) { showFieldError('email', 'We need your email to contact you.'); hasError = true; }
    else if (!emailRe.test(email)) { showFieldError('email', "That email doesn't look right. Could you double-check?"); hasError = true; }
    if (!privacyInput?.checked) {
      showFieldError('privacidad', 'You must accept the privacy policy to continue.');
      hasError = true;
    }
    if (hasError) return;

    const objetivoVal = form.querySelector('input[name="objetivo"]:checked')?.value || '';
    const telefono = form.querySelector('input[name="telefono"]')?.value.trim() || '';
    const contexto = form.querySelector('textarea[name="contexto"]')?.value.trim() || '';
    const honey = form.querySelector('input[name="_honey"]')?.value || '';

    const labels = {
      negocios: 'Business development',
      producto: 'Product & international sourcing',
      marketing: 'Digital marketing',
      escalado: 'Digital channels & scaling',
      otro: 'Something different'
    };
    const objetivoLabel = labels[objetivoVal] || 'your project';

    let canal = 'by email';
    if (email && telefono) canal = 'by email or phone';
    else if (telefono) canal = 'by phone';

    const submitBtn = form.querySelector('button[type="submit"]');
    const submitText = submitBtn?.querySelector('.text');
    const prevLabel = submitText?.textContent || 'Send';
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.style.cursor = 'wait';
      submitBtn.style.opacity = '0.7';
    }
    if (submitText) submitText.textContent = 'Sending…';

    try {
      const res = await fetch('https://formsubmit.co/ajax/luis.chicharro@unicornioazul.es', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        signal: AbortSignal.timeout(15000),
        body: JSON.stringify({
          _subject: `New lead — Get started: ${objetivoLabel}`,
          _template: 'table',
          _captcha: 'false',
          _honey: honey,
          _replyto: email,
          name,
          email,
          phone: telefono || '—',
          goal: objetivoLabel,
          context: contexto || '—',
          language: 'EN',
          source: '/en/get-started',
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || data.success === 'false' || data.success === false) {
        throw new Error(data.message || 'Could not send the form.');
      }

      const successName = document.getElementById('success-name');
      const successObjetivo = document.getElementById('success-objetivo');
      const successCanal = document.getElementById('success-canal');
      if (successName) successName.textContent = name;
      if (successObjetivo) successObjetivo.textContent = objetivoLabel;
      if (successCanal) successCanal.textContent = canal;

      form.style.opacity = '0'; form.style.transform = 'scale(0.98)'; form.style.transition = 'all 0.5s ease';
      const fallback = document.getElementById('form-fallback');
      setTimeout(() => {
        form.style.display = 'none';
        if (fallback) fallback.style.display = 'none';
        const success = document.getElementById('form-success');
        if (success) { success.classList.remove('hidden'); success.style.opacity = '1'; success.style.transform = 'translateY(0)'; }
      }, 500);
    } catch (err) {
      alert('We could not send your message. Please try again or email luis.chicharro@unicornioazul.es');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.style.cursor = 'pointer';
        submitBtn.style.opacity = '1';
      }
      if (submitText) submitText.textContent = prevLabel;
    }
  });

  showStep(1);
</script>

<!-- Success message (hidden) -->
<div id="form-success" class="hidden text-center py-16" style="opacity:0;transform:translateY(24px);transition:all 0.6s cubic-bezier(0.23,1,0.32,1);max-width:28rem;margin:0 auto;">

  <!-- Animated checkmark with glow ring -->
  <div class="success-icon-wrap" style="position:relative;width:88px;height:88px;margin:0 auto 2rem;">
    <svg class="success-ring" viewBox="0 0 88 88" style="position:absolute;inset:0;width:100%;height:100%;">
      <circle cx="44" cy="44" r="38" fill="none" stroke="#00698D" stroke-width="2.5" style="stroke-dasharray:239;stroke-dashoffset:239;animation: ringDraw 0.8s cubic-bezier(0.23,1,0.32,1) 0.3s forwards;"/>
      <circle cx="44" cy="44" r="38" fill="none" stroke="#00698D" stroke-width="6" opacity="0" style="animation: ringPulse 1s ease-out 1.1s forwards;"/>
    </svg>
    <svg viewBox="0 0 88 88" class="success-check" style="position:absolute;inset:0;width:100%;height:100%;">
      <circle cx="44" cy="44" r="34" fill="#00698D" style="transform-origin:center;animation: checkPop 0.6s cubic-bezier(0.34,1.56,0.64,1) 0.4s both;"/>
      <path d="M26 44l12 12L62 32" fill="none" stroke="#ffffff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" style="stroke-dasharray:60;stroke-dashoffset:60;animation: checkDraw 0.5s ease 0.7s forwards;"/>
    </svg>
  </div>

  <h2 class="text-2xl md:text-3xl font-bold mb-3" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Thank you, <span id="success-name">---</span>!</h2>
  <p class="text-base md:text-lg leading-relaxed mb-1" style="font-family:'Satoshi',sans-serif;color:#6B7280;">
    We've received your interest in <strong style="color:#1A1A1A;" id="success-objetivo">your project</strong>.
  </p>
  <p class="text-base md:text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#6B7280;">
    We'll contact you <span id="success-canal">by email</span> in less than <strong style="color:#1A1A1A;">48 hours</strong>.
  </p>
  <a href="/en" class="inline-flex items-center gap-2 mt-8 text-base font-semibold no-underline transition-all duration-300 hover:opacity-70" style="font-family:'Space Grotesk',sans-serif;color:#163667;">
    ← Back to home
  </a>
</div>

