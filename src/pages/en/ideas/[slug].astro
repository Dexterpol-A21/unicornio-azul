---
export const prerender = false;

import BaseLayout from '@layouts/BaseLayout.astro';
import BlogPost from '@/components/blog/BlogPost.astro';
import { getSortedBlogEntries, blogPostUrl, BLOG_CATEGORIES, missingArticle } from '@/lib/blog';

const { slug } = Astro.params;
const entries = await getSortedBlogEntries('en');
const entry = entries.find((item) => item.data.urlSlug === slug);
if (!entry) return missingArticle(Astro.request);

const related = entries.filter((item) => item !== entry).slice(0, 3);
const d = entry.data;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<BaseLayout
  title={`${d.title} | Unicornio Azul`}
  description={d.description}
  image={d.heroImage}
  imageAlt={d.heroImageAlt}
  altUrl={blogPostUrl('es', d.urlSlug)}
  showHeader={true}
  type="article"
  publishedTime={d.publishedAt.toISOString()}
  section={BLOG_CATEGORIES[d.category].label.en}
>

  <BlogPost entry={entry} lang="en" related={related} />

</BaseLayout>
