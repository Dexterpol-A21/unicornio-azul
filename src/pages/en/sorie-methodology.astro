---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="SORIE™ Methodology — Blue Unicorn"
  description="Real Solutions for Extraordinary Ideas. Discover the SORIE™ methodology from Blue Unicorn: Solutions, Objectives, Resources, Implementation, Evolution."
  showHeader={true}
>

<!-- ═════════════════════════════════════════
HERO — SORIE™
midnight #0A1628
═════════════════════════════════════════ -->
<section class="relative overflow-hidden md:min-h-[60dvh] flex items-center" style="background: linear-gradient(to bottom, #0F2548, #163667, #0B4F7A, #00698D, #0088B3);">

  <div class="relative z-10 w-full max-w-4xl mx-auto px-6 md:px-12 py-20 md:py-28 text-center">
    <h1 class="leading-[0.92] tracking-tight mb-6" style="color:#ffffff;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(3rem,9vw,6rem);">
      SORIE&trade;
    </h1>
    <p class="text-lg md:text-xl max-w-[48ch] mx-auto leading-relaxed" style="color:rgba(255,255,255,0.5);font-family:'Satoshi',sans-serif;">
      Real Solutions for Extraordinary Ideas. The methodology we apply to every project, every decision, and every step of the process.
    </p>
  </div>
</section>

<!-- ═════════════════════════════════════════
LETTERS S O R I E — Bilingual, same as index
═════════════════════════════════════════ -->
<section style="background:#FFFFFF;">
  <div class="max-w-4xl mx-auto px-4 pt-24 md:pt-32 pb-10 md:pb-14">

    <div class="flex flex-wrap items-end justify-center gap-6 md:gap-12 lg:gap-20">

      <!-- S — Soluciones / Solutions -->
      <div class="flex flex-col items-center gap-1.5">
        <span class="text-7xl md:text-8xl lg:text-9xl font-black leading-none tracking-tighter" style="font-family: 'Space Grotesk', sans-serif; color: #0F2548;">S</span>
        <span class="text-xs md:text-sm font-semibold tracking-wide" style="font-family: 'Satoshi', sans-serif; color: #0F2548;">Soluciones</span>
        <span class="text-[10px] md:text-xs font-medium tracking-wide opacity-40" style="font-family: 'Satoshi', sans-serif; color: #0F2548;">Solutions</span>
      </div>

      <!-- O — Objetivos / Objectives -->
      <div class="flex flex-col items-center gap-1.5">
        <span class="text-7xl md:text-8xl lg:text-9xl font-black leading-none tracking-tighter" style="font-family: 'Space Grotesk', sans-serif; color: #163667;">O</span>
        <span class="text-xs md:text-sm font-semibold tracking-wide" style="font-family: 'Satoshi', sans-serif; color: #163667;">Objetivos</span>
        <span class="text-[10px] md:text-xs font-medium tracking-wide opacity-40" style="font-family: 'Satoshi', sans-serif; color: #163667;">Objectives</span>
      </div>

      <!-- R — Recursos / Resources -->
      <div class="flex flex-col items-center gap-1.5">
        <span class="text-7xl md:text-8xl lg:text-9xl font-black leading-none tracking-tighter" style="font-family: 'Space Grotesk', sans-serif; color: #0B4F7A;">R</span>
        <span class="text-xs md:text-sm font-semibold tracking-wide" style="font-family: 'Satoshi', sans-serif; color: #0B4F7A;">Recursos</span>
        <span class="text-[10px] md:text-xs font-medium tracking-wide opacity-40" style="font-family: 'Satoshi', sans-serif; color: #0B4F7A;">Resources</span>
      </div>

      <!-- I — Implementación / Implementation -->
      <div class="flex flex-col items-center gap-1.5">
        <span class="text-7xl md:text-8xl lg:text-9xl font-black leading-none tracking-tighter" style="font-family: 'Space Grotesk', sans-serif; color: #00698D;">I</span>
        <span class="text-xs md:text-sm font-semibold tracking-wide" style="font-family: 'Satoshi', sans-serif; color: #00698D;">Implementación</span>
        <span class="text-[10px] md:text-xs font-medium tracking-wide opacity-40" style="font-family: 'Satoshi', sans-serif; color: #00698D;">Implementation</span>
      </div>

      <!-- E — Evolución / Evolution -->
      <div class="flex flex-col items-center gap-1.5">
        <span class="text-7xl md:text-8xl lg:text-9xl font-black leading-none tracking-tighter" style="font-family: 'Space Grotesk', sans-serif; color: #0088B3;">E</span>
        <span class="text-xs md:text-sm font-semibold tracking-wide" style="font-family: 'Satoshi', sans-serif; color: #0088B3;">Evolución</span>
        <span class="text-[10px] md:text-xs font-medium tracking-wide opacity-40" style="font-family: 'Satoshi', sans-serif; color: #0088B3;">Evolution</span>
      </div>

    </div>

    <!-- Slogan -->
    <div class="text-center pt-12 pb-4">
      <p class="text-lg md:text-xl font-semibold italic opacity-70 tracking-wide" style="font-family: 'Satoshi', sans-serif; color: #163667;">
        Real Solutions for Extraordinary Ideas
      </p>
    </div>

  </div>
</section>

<!-- ═════════════════════════════════════════
WHAT EACH LETTER MEANS — Explanation
═════════════════════════════════════════ -->
<section style="background:#F2F5F8;">
  <div class="max-w-3xl mx-auto px-6 md:px-12 py-14 md:py-28">

    <div class="space-y-10 md:space-y-16">

      <!-- S -->
      <div class="flex flex-col md:flex-row gap-4 md:gap-10 items-start">
        <div class="shrink-0">
          <span class="text-6xl md:text-7xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:#0F2548;">S</span>
        </div>
        <div>
          <h3 class="text-xl font-bold mb-2" style="font-family:'Space Grotesk',sans-serif;color:#0F2548;">Solutions / Soluciones</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">
            Everything starts with a plan. Before manufacturing, before buying, before selling. We analyze the market, define the strategy, and design the roadmap that turns an idea into a viable business.
          </p>
        </div>
      </div>

      <!-- O -->
      <div class="flex flex-col md:flex-row gap-4 md:gap-10 items-start">
        <div class="shrink-0">
          <span class="text-6xl md:text-7xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:#163667;">O</span>
        </div>
        <div>
          <h3 class="text-xl font-bold mb-2" style="font-family:'Space Grotesk',sans-serif;color:#163667;">Objectives / Objetivos</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">
            We identify real opportunities where others only see ideas. We validate with market data, not intuition. Because a poorly analyzed opportunity is the most expensive mistake a business can make.
          </p>
        </div>
      </div>

      <!-- R -->
      <div class="flex flex-col md:flex-row gap-4 md:gap-10 items-start">
        <div class="shrink-0">
          <span class="text-6xl md:text-7xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:#0B4F7A;">R</span>
        </div>
        <div>
          <h3 class="text-xl font-bold mb-2" style="font-family:'Space Grotesk',sans-serif;color:#0B4F7A;">Resources / Recursos</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">
            We build on what works, not on what sounds good. Real suppliers, real products, real margins. Every decision is connected with business operations and with the ground.
          </p>
        </div>
      </div>

      <!-- I -->
      <div class="flex flex-col md:flex-row gap-4 md:gap-10 items-start">
        <div class="shrink-0">
          <span class="text-6xl md:text-7xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:#00698D;">I</span>
        </div>
        <div>
          <h3 class="text-xl font-bold mb-2" style="font-family:'Space Grotesk',sans-serif;color:#00698D;">Implementation / Implementación</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">
            Innovation isn't always about inventing something new. Sometimes it's about applying what already works in a smarter way. We look for competitive advantages in the product, in the channel, and in the way we reach the customer.
          </p>
        </div>
      </div>

      <!-- E -->
      <div class="flex flex-col md:flex-row gap-4 md:gap-10 items-start">
        <div class="shrink-0">
          <span class="text-6xl md:text-7xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:#0088B3;">E</span>
        </div>
        <div>
          <h3 class="text-xl font-bold mb-2" style="font-family:'Space Grotesk',sans-serif;color:#0088B3;">Evolution / Evolución</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">
            The best strategy is worthless without execution. Here we move from plan to action: manufacturing, logistics, marketing, and scaling. We make things happen, with control and with judgment.
          </p>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- ═════════════════════════════════════════
AUTHORITY QUOTE
═════════════════════════════════════════ -->
<section style="background:#FFFFFF;">
  <div class="max-w-3xl mx-auto px-6 md:px-12 pt-14 md:pt-24 pb-10 md:pb-16 text-center">
    <img src="/images/logo-marino.png" alt="Blue Unicorn" class="h-8 w-auto mx-auto mb-5 opacity-50" />
    <blockquote class="text-2xl md:text-3xl font-bold leading-[1.2] tracking-tight" style="font-family:'Space Grotesk',sans-serif;color:#163667;">
      &ldquo;A unicorn is that extraordinary opportunity that almost no one manages to find... but some manage to build.&rdquo;
    </blockquote>
    <p class="mt-4 text-base opacity-50" style="font-family:'Satoshi',sans-serif;color:#6B7280;">— Blue Unicorn Philosophy</p>
  </div>
</section>

<!-- ═════════════════════════════════════════
WHY SORIE™
═════════════════════════════════════════ -->
<section style="background:#F5F1EC;">
  <div class="max-w-4xl mx-auto md:px-12 py-14 md:py-24">

    <div class="px-6 md:px-0 text-center mb-10 md:mb-20">
      <h2 class="text-[2.5rem] md:text-5xl font-bold tracking-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Why SORIE&trade;</h2>
      <p class="mt-4 text-lg md:text-xl max-w-[40ch] mx-auto leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#6B7280;">
        It's not a pretty acronym. It's the structure we learned through trial, error, success, and repetition.
      </p>
    </div>

    <!-- Mobile: horizontal gallery -->
    <div class="md:hidden overflow-hidden w-full">
      <div class="flex gap-3 overflow-x-auto snap-x snap-mandatory" style="scrollbar-width:none; -ms-overflow-style:none; padding-left:24px; padding-right:24px; scroll-padding-left:24px; scroll-padding-right:24px;">

        <!-- Reason 1 -->
        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" style="background:#FFFFFF;border:1px solid rgba(15,37,72,0.06);">
          <span class="block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:rgba(15,37,72,0.07);">01</span>
          <h3 class="text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#0F2548;">Born from the ground, not from a manual</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">SORIE™ wasn't designed on a whiteboard. It was shaped project after project, in factories, in customs, in marketplaces, and in real campaigns. Each letter represents a phase we've lived through dozens of times.</p>
        </div>

        <!-- Reason 2 -->
        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" style="background:#FFFFFF;border:1px solid rgba(22,54,103,0.06);">
          <span class="block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:rgba(22,54,103,0.07);">02</span>
          <h3 class="text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#163667;">Connects strategy and execution</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">Many methodologies stay on paper. SORIE™ goes from S to E without gaps: what's analyzed gets executed, what's executed gets measured, and what's measured gets optimized. No cracks between the plan and the action.</p>
        </div>

        <!-- Reason 3 -->
        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" style="background:#FFFFFF;border:1px solid rgba(11,79,122,0.06);">
          <span class="block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:rgba(11,79,122,0.07);">03</span>
          <h3 class="text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#0B4F7A;">It adapts, it doesn't impose</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">Not every project needs the same thing. Some start with O (because they already have strategy), others only need I and E. SORIE™ is a framework, not a straitjacket. It's applied where it adds value.</p>
        </div>

        <!-- Reason 4 -->
        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" style="background:#FFFFFF;border:1px solid rgba(0,105,141,0.06);">
          <span class="block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:rgba(0,105,141,0.07);">04</span>
          <h3 class="text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#00698D;">Results, not PowerPoints</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">At the end of the day, the only thing that matters is whether the business works. SORIE™ exists for that: so that ideas become products, products become sales, and sales become a business that sustains itself and grows.</p>
        </div>

      </div>
    </div>

    <!-- Indicator dots (mobile only) -->
    <div id="sorie-dots" class="md:hidden flex items-center justify-center gap-2 mt-5">
      <span class="block w-2 h-2 rounded-full" style="background:#0F2548;"></span>
      <span class="block w-2 h-2 rounded-full" style="background:rgba(15,37,72,0.2);"></span>
      <span class="block w-2 h-2 rounded-full" style="background:rgba(15,37,72,0.2);"></span>
      <span class="block w-2 h-2 rounded-full" style="background:rgba(15,37,72,0.2);"></span>
    </div>

    <!-- Desktop: 2-column grid (original) -->
    <div class="hidden md:grid grid-cols-2 gap-6 md:gap-8 px-12">

      <div class="bg-white rounded-xl p-6 md:p-8">
        <span class="text-4xl md:text-5xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:#0F2548;">01</span>
        <h3 class="mt-3 text-xl font-bold" style="font-family:'Space Grotesk',sans-serif;color:#0F2548;">Born from the ground, not from a manual</h3>
        <p class="mt-3 text-base leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#4B5563;">
          SORIE™ wasn't designed on a whiteboard. It was shaped project after project, in factories, in customs, in marketplaces, and in real campaigns. Each letter represents a phase we've lived through dozens of times.
        </p>
      </div>

      <div class="bg-white rounded-xl p-6 md:p-8">
        <span class="text-4xl md:text-5xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:#163667;">02</span>
        <h3 class="mt-3 text-xl font-bold" style="font-family:'Space Grotesk',sans-serif;color:#163667;">Connects strategy and execution</h3>
        <p class="mt-3 text-base leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#4B5563;">
          Many methodologies stay on paper. SORIE™ goes from S to E without gaps: what's analyzed gets executed, what's executed gets measured, and what's measured gets optimized. No cracks between the plan and the action.
        </p>
      </div>

      <div class="bg-white rounded-xl p-6 md:p-8">
        <span class="text-4xl md:text-5xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:#0B4F7A;">03</span>
        <h3 class="mt-3 text-xl font-bold" style="font-family:'Space Grotesk',sans-serif;color:#0B4F7A;">It adapts, it doesn't impose</h3>
        <p class="mt-3 text-base leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#4B5563;">
          Not every project needs the same thing. Some start with O (because they already have strategy), others only need I and E. SORIE™ is a framework, not a straitjacket. It's applied where it adds value.
        </p>
      </div>

      <div class="bg-white rounded-xl p-6 md:p-8">
        <span class="text-4xl md:text-5xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:#00698D;">04</span>
        <h3 class="mt-3 text-xl font-bold" style="font-family:'Space Grotesk',sans-serif;color:#00698D;">Results, not PowerPoints</h3>
        <p class="mt-3 text-base leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#4B5563;">
          At the end of the day, the only thing that matters is whether the business works. SORIE™ exists for that: so that ideas become products, products become sales, and sales become a business that sustains itself and grows.
        </p>
      </div>

    </div>

  </div>
</section>

<!-- ═════════════════════════════════════════
FAQ — SORIE™
═════════════════════════════════════════ -->
<section style="background:#F2F5F8;">
  <div class="max-w-3xl mx-auto px-6 md:px-12 pt-2 pb-12 md:pt-4 md:pb-24">

    <div class="space-y-1" id="faq-accordion">

      <div class="faq-item border-b" style="border-color:rgba(22,54,103,0.08);">
        <button class="faq-trigger flex items-center justify-between w-full py-5 cursor-pointer bg-transparent border-none" aria-expanded="false">
          <span class="text-lg font-semibold pr-6 text-left" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Is SORIE™ a rigid methodology?</span>
          <span class="faq-icon shrink-0 text-xl leading-none" style="color:#163667;transition:transform 0.4s ease;">+</span>
        </button>
        <div class="faq-content" style="max-height:0;overflow:hidden;transition:max-height 0.45s ease;">
          <div>
            <p class="pb-5 text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">
              No. SORIE™ is a framework, not a straitjacket. Each project has its own starting point. Some need to begin with E (execution), others with S (solutions). We apply it where it genuinely adds value, without repeating steps that are already covered.
            </p>
          </div>
        </div>
      </div>

      <div class="faq-item border-b" style="border-color:rgba(22,54,103,0.08);">
        <button class="faq-trigger flex items-center justify-between w-full py-5 cursor-pointer bg-transparent border-none" aria-expanded="false">
          <span class="text-lg font-semibold pr-6 text-left" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">How is it different from other methodologies?</span>
          <span class="faq-icon shrink-0 text-xl leading-none" style="color:#163667;transition:transform 0.4s ease;">+</span>
        </button>
        <div class="faq-content" style="max-height:0;overflow:hidden;transition:max-height 0.45s ease;">
          <div>
            <p class="pb-5 text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">
              Most methodologies stay in theory or abstract phases. SORIE™ is born from the ground: each letter represents real learnings from projects executed in factories, customs, marketplaces, and campaigns. It's not what should work — it's what we've proven works.
            </p>
          </div>
        </div>
      </div>

      <div class="faq-item border-b" style="border-color:rgba(22,54,103,0.08);">
        <button class="faq-trigger flex items-center justify-between w-full py-5 cursor-pointer bg-transparent border-none" aria-expanded="false">
          <span class="text-lg font-semibold pr-6 text-left" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">What kind of projects is SORIE™ for?</span>
          <span class="faq-icon shrink-0 text-xl leading-none" style="color:#163667;transition:transform 0.4s ease;">+</span>
        </button>
        <div class="faq-content" style="max-height:0;overflow:hidden;transition:max-height 0.45s ease;">
          <div>
            <p class="pb-5 text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">
              SORIE™ is designed for physical product businesses: from a brand idea to the international expansion of an existing catalog. It works for entrepreneurs starting from scratch as well as companies looking to launch a new line or enter new markets.
            </p>
          </div>
        </div>
      </div>

      <div class="faq-item border-b" style="border-color:rgba(22,54,103,0.08);">
        <button class="faq-trigger flex items-center justify-between w-full py-5 cursor-pointer bg-transparent border-none" aria-expanded="false">
          <span class="text-lg font-semibold pr-6 text-left" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">How do I know if applying SORIE™ makes sense for me?</span>
          <span class="faq-icon shrink-0 text-xl leading-none" style="color:#163667;transition:transform 0.4s ease;">+</span>
        </button>
        <div class="faq-content" style="max-height:0;overflow:hidden;transition:max-height 0.45s ease;">
          <div>
            <p class="pb-5 text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">
              If you have a product idea, a brand you want to scale, or a business that needs structure to grow, SORIE™ makes sense. <a href="/en/get-started" style="color:#163667;font-weight:600;text-decoration:underline;text-underline-offset:3px;">Tell us about your case in a no-obligation first conversation</a> and we'll assess together whether our methodology fits what you need.
            </p>
          </div>
        </div>
      </div>

      <div class="faq-item border-b" style="border-color:rgba(22,54,103,0.08);">
        <button class="faq-trigger flex items-center justify-between w-full py-5 cursor-pointer bg-transparent border-none" aria-expanded="false">
          <span class="text-lg font-semibold pr-6 text-left" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">How much does it cost to apply SORIE™ to a project?</span>
          <span class="faq-icon shrink-0 text-xl leading-none" style="color:#163667;transition:transform 0.4s ease;">+</span>
        </button>
        <div class="faq-content" style="max-height:0;overflow:hidden;transition:max-height 0.45s ease;">
          <div>
            <p class="pb-5 text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">
              It depends on the scope and the phases you need. We don't work with fixed packages because each project has different needs. <a href="/en/get-started" style="color:#163667;font-weight:600;text-decoration:underline;text-underline-offset:3px;">Tell us about your project and we'll prepare a proposal</a> with clear scope, phases, and investment. No fine print.
            </p>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- ═════════════════════════════════════════
FINAL CTA
═════════════════════════════════════════ -->
