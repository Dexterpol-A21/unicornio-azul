HERO — How we work
midnight #0A1628 · editorial process
═════════════════════════════════════════ -->
<section class="relative overflow-hidden md:min-h-[60dvh] flex items-center" style="background: linear-gradient(to right, #0F2548 0%, #0F2548 20%, #163667 20%, #163667 40%, #0B4F7A 40%, #0B4F7A 60%, #00698D 60%, #00698D 80%, #0088B3 80%, #0088B3 100%);">

  <!-- Geometric background — lines and connected dots (process / path) -->
