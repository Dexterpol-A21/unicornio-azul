---
import BaseLayout from '@layouts/BaseLayout.astro';
import ScrollTimelineScript from '@/components/ui/ScrollTimelineScript.astro';
---

<BaseLayout
  title="This is how we work — Blue Unicorn"
  description="We don't work with promises or miracle formulas. At Blue Unicorn we follow a clear 5-step process: analysis, product, brand, sales, and scaling."
  showHeader={true}
>

<!-- ═════════════════════════════════════════
HERO — How we work
midnight #0A1628 · editorial process
═════════════════════════════════════════ -->
<section class="relative overflow-hidden md:min-h-[60dvh] flex items-center" style="background: linear-gradient(to right, #0F2548 0%, #0F2548 20%, #163667 20%, #163667 40%, #0B4F7A 40%, #0B4F7A 60%, #00698D 60%, #00698D 80%, #0088B3 80%, #0088B3 100%);">

  <!-- Geometric background — lines and connected dots (process / path) -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none z-0" viewBox="0 0 1440 700" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <!-- Horizontal dashed line — like a timeline -->
    <line x1="120" y1="350" x2="1320" y2="350" stroke="#ffffff" stroke-width="1" stroke-dasharray="4,12" opacity="0.08"/>
    <!-- Nodes on the line -->
    <circle cx="120" cy="350" r="4" fill="#ffffff" opacity="0.12"/>
    <circle cx="420" cy="350" r="4" fill="#ffffff" opacity="0.12"/>
    <circle cx="720" cy="350" r="4" fill="#ffffff" opacity="0.12"/>
    <circle cx="1020" cy="350" r="4" fill="#ffffff" opacity="0.12"/>
    <circle cx="1320" cy="350" r="4" fill="#ffffff" opacity="0.12"/>
    <!-- Decorative star top-right -->
    <g transform="translate(1340, 80) scale(1.2)" opacity="0.06">
      <path d="M0 -20 Q0 0 20 0 Q0 0 0 20 Q0 0 -20 0 Q0 0 0 -20Z" fill="#ffffff"/>
    </g>
  </svg>

  <div class="relative z-10 w-full max-w-4xl mx-auto px-6 md:px-12 py-20 md:py-28 text-center" data-reveal>
    <h1 class="reveal-item leading-[0.92] tracking-tight mb-6" style="--i:0;color:#ffffff;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(2.8rem,8vw,5.5rem);">
      This is how<br>we work
    </h1>
    <p class="reveal-item text-lg md:text-xl max-w-[48ch] mx-auto leading-relaxed" style="--i:1;color:rgba(255,255,255,0.5);font-family:'Satoshi',sans-serif;">
      We don't work with promises or miracle formulas. We work with clear processes, real experience, and medium to long-term vision.
    </p>
  </div>
</section>

<!-- ═════════════════════════════════════════
PROCESS — 5 steps · Vertical timeline
═════════════════════════════════════════ -->
<section id="proceso" style="background:#FFFFFF;">
  <div class="max-w-4xl mx-auto px-6 md:px-12 py-14 md:py-28">

    <div class="hidden md:block relative" data-scroll-timeline>

      <!-- Start circle — always visible at the beginning of the line -->
      <div class="absolute left-1/2 top-0 z-10 -translate-x-1/2" aria-hidden="true">
        <div class="w-4 h-4 rounded-full border-2 transition-colors duration-500" data-timeline-node data-paso="1" data-color="#0F2548" style="background:#0F2548;border-color:#0F2548;"></div>
      </div>

      <!-- Vertical line — starts from the center of the start circle -->
      <div class="absolute left-1/2 top-2 bottom-2 w-0.5 -translate-x-1/2" style="background:rgba(15,37,72,0.06);">
        <div
          data-timeline-fill
          class="absolute top-0 left-0 w-full origin-top"
          style="height:100%;transform:scaleY(0);background:linear-gradient(to bottom,#0F2548,#163667,#0B4F7A,#00698D,#0088B3);transition:transform 0.45s cubic-bezier(0.16,1,0.3,1);"
        ></div>
      </div>

      <!-- Step 01 — midnight (node is the start circle above) -->
      <div class="relative flex items-start gap-16 mb-16 md:mb-24" data-timeline-item data-paso="1" style="--c:#0F2548;">
        <div class="w-1/2 text-right pr-8" data-side-reveal="left">
          <span class="paso-num block text-8xl font-black leading-none tracking-tighter mb-3" style="font-family:'Space Grotesk',sans-serif;color:#0F2548;">01</span>
          <div class="paso-copy">
            <h3 class="text-2xl font-bold mb-2 leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#0F2548;">Analysis & Viability</h3>
            <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We study the project, the market, and the numbers before moving forward.</p>
          </div>
        </div>
        <div class="w-1/2 pl-8"></div>
      </div>

      <!-- Step 02 — navy -->
      <div class="relative flex items-start gap-16 mb-16 md:mb-24" data-timeline-item data-paso="2" style="--c:#163667;">
        <div class="w-1/2 pr-8"></div>
        <div class="absolute left-1/2 -translate-x-1/2 mt-2">
          <div class="w-4 h-4 rounded-full border-2 transition-colors duration-500" data-timeline-node data-paso="2" data-color="#163667" style="background:#FFFFFF;border-color:#163667;"></div>
        </div>
        <div class="w-1/2 pl-8" data-side-reveal="right">
          <span class="paso-num block text-8xl font-black leading-none tracking-tighter mb-3" style="font-family:'Space Grotesk',sans-serif;color:#163667;">02</span>
          <div class="paso-copy">
            <h3 class="text-2xl font-bold mb-2 leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#163667;">Product & Structure Definition</h3>
            <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We decide what to sell, how to produce it, and how to structure the business.</p>
          </div>
        </div>
      </div>

      <!-- Step 03 — deep aqua -->
      <div class="relative flex items-start gap-16 mb-16 md:mb-24" data-timeline-item data-paso="3" style="--c:#0B4F7A;">
        <div class="w-1/2 text-right pr-8" data-side-reveal="left">
          <span class="paso-num block text-8xl font-black leading-none tracking-tighter mb-3" style="font-family:'Space Grotesk',sans-serif;color:#0B4F7A;">03</span>
          <div class="paso-copy">
            <h3 class="text-2xl font-bold mb-2 leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#0B4F7A;">Brand development & operations</h3>
            <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We create the brand and put real operations in motion.</p>
          </div>
        </div>
        <div class="absolute left-1/2 -translate-x-1/2 mt-2">
          <div class="w-4 h-4 rounded-full border-2 transition-colors duration-500" data-timeline-node data-paso="3" data-color="#0B4F7A" style="background:#FFFFFF;border-color:#0B4F7A;"></div>
        </div>
        <div class="w-1/2 pl-8"></div>
      </div>

      <!-- Step 04 — aqua -->
      <div class="relative flex items-start gap-16 mb-16 md:mb-24" data-timeline-item data-paso="4" style="--c:#00698D;">
        <div class="w-1/2 pr-8"></div>
        <div class="absolute left-1/2 -translate-x-1/2 mt-2">
          <div class="w-4 h-4 rounded-full border-2 transition-colors duration-500" data-timeline-node data-paso="4" data-color="#00698D" style="background:#FFFFFF;border-color:#00698D;"></div>
        </div>
        <div class="w-1/2 pl-8" data-side-reveal="right">
          <span class="paso-num block text-8xl font-black leading-none tracking-tighter mb-3" style="font-family:'Space Grotesk',sans-serif;color:#00698D;">04</span>
          <div class="paso-copy">
            <h3 class="text-2xl font-bold mb-2 leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#00698D;">Sales & marketing activation</h3>
            <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We activate marketing, advertising, and digital channels.</p>
          </div>
        </div>
      </div>

      <!-- Step 05 — sky -->
      <div class="relative flex items-start gap-16" data-timeline-item data-paso="5" style="--c:#0088B3;">
        <div class="w-1/2 text-right pr-8" data-side-reveal="left">
          <span class="paso-num block text-8xl font-black leading-none tracking-tighter mb-3" style="font-family:'Space Grotesk',sans-serif;color:#0088B3;">05</span>
          <div class="paso-copy">
            <h3 class="text-2xl font-bold mb-2 leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#0088B3;">Scaling & optimization</h3>
            <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We optimize processes and scale the business sustainably.</p>
          </div>
        </div>
        <div class="absolute left-1/2 -translate-x-1/2 mt-2">
          <div class="w-4 h-4 rounded-full border-2 transition-colors duration-500" data-timeline-node data-paso="5" data-color="#0088B3" style="background:#FFFFFF;border-color:#0088B3;"></div>
        </div>
        <div class="w-1/2 pl-8"></div>
      </div>

    </div>

    <!-- Mobile: horizontal scroll cards -->
    <div class="md:hidden overflow-hidden w-full" data-bloque-rail data-bloque-x>
      <div class="flex gap-3 overflow-x-auto snap-x snap-mandatory" data-bloque-scroller style="scrollbar-width:none; -ms-overflow-style:none; padding-left:24px; padding-right:24px; scroll-padding-left:24px; scroll-padding-right:24px;">

        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" data-bloque-item style="--c:#0F2548;background:#FFFFFF;border:1px solid rgba(15,37,72,0.12);">
          <span class="bloque-num block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;">01</span>
          <h3 class="bloque-title text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#0F2548;">Analysis & Viability</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We study the project, the market, and the numbers before moving forward.</p>
        </div>

        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" data-bloque-item style="--c:#163667;background:#FFFFFF;border:1px solid rgba(22,54,103,0.12);">
          <span class="bloque-num block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;">02</span>
          <h3 class="bloque-title text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#163667;">Product & Structure Definition</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We decide what to sell, how to produce it, and how to structure the business.</p>
        </div>

        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" data-bloque-item style="--c:#0B4F7A;background:#FFFFFF;border:1px solid rgba(11,79,122,0.12);">
          <span class="bloque-num block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;">03</span>
          <h3 class="bloque-title text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#0B4F7A;">Brand development & operations</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We create the brand and put real operations in motion.</p>
        </div>

        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" data-bloque-item style="--c:#00698D;background:#FFFFFF;border:1px solid rgba(0,105,141,0.12);">
          <span class="bloque-num block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;">04</span>
          <h3 class="bloque-title text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#00698D;">Sales & marketing activation</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We activate marketing, advertising, and digital channels.</p>
        </div>

        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" data-bloque-item style="--c:#0088B3;background:#FFFFFF;border:1px solid rgba(0,136,179,0.14);">
          <span class="bloque-num block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;">05</span>
          <h3 class="bloque-title text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#0088B3;">Scaling & optimization</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">We optimize processes and scale the business sustainably.</p>
        </div>

      </div>
    </div>

    <!-- Indicator dots (mobile only) — rainbow -->
    <div id="proceso-dots" class="md:hidden flex items-center justify-center gap-2 mt-5" data-bloque-dots>
      <span class="block w-2 h-2 rounded-full" data-color="#0F2548" style="background:#0F2548;opacity:1;"></span>
      <span class="block w-2 h-2 rounded-full" data-color="#163667" style="background:#163667;opacity:0.22;"></span>
      <span class="block w-2 h-2 rounded-full" data-color="#0B4F7A" style="background:#0B4F7A;opacity:0.22;"></span>
      <span class="block w-2 h-2 rounded-full" data-color="#00698D" style="background:#00698D;opacity:0.22;"></span>
      <span class="block w-2 h-2 rounded-full" data-color="#0088B3" style="background:#0088B3;opacity:0.22;"></span>
    </div>

  </div>
</section>

<!-- ═════════════════════════════════════════
COLLABORATION — What you bring (humanize)
Doesn't repeat the 5 steps: what the person brings
═════════════════════════════════════════ -->
<section id="collaboration" style="background:#0F2548;" data-reveal>
  <div class="max-w-5xl mx-auto px-6 md:px-12 py-16 md:py-28">

    <div class="reveal-item max-w-2xl mb-12 md:mb-16" style="--i:0">
      <span class="text-[11px] tracking-[0.35em] uppercase font-semibold" style="color:rgba(168,216,234,0.55);font-family:'Satoshi',sans-serif;">
        Collaboration
      </span>
      <h2
        class="mt-5 font-bold tracking-tight leading-[1.05] text-balance"
        style="font-family:'Space Grotesk',sans-serif;color:#FFFFFF;font-size:clamp(1.85rem,4.5vw,3rem);"
      >
        You're not a form.<br>You're part of the process.
      </h2>
      <p class="mt-5 text-base md:text-lg leading-relaxed max-w-[42ch]" style="color:rgba(255,255,255,0.55);font-family:'Satoshi',sans-serif;">
        Without your context, no strategy holds up. This is what we need from you to build together — no more, no less.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-10 md:gap-y-14">

      <div class="reveal-item pl-5" style="--i:1;border-left:2px solid #A8D8EA;">
        <h3 class="text-xl md:text-2xl font-bold tracking-tight" style="font-family:'Space Grotesk',sans-serif;color:#FFFFFF;">Context</h3>
        <p class="mt-2 text-base leading-relaxed" style="font-family:'Satoshi',sans-serif;color:rgba(255,255,255,0.55);">
          The idea, why now, what you already know about the market, and the real budget we can work with.
        </p>
      </div>

      <div class="reveal-item pl-5" style="--i:2;border-left:2px solid #0088B3;">
        <h3 class="text-xl md:text-2xl font-bold tracking-tight" style="font-family:'Space Grotesk',sans-serif;color:#FFFFFF;">Judgment</h3>
        <p class="mt-2 text-base leading-relaxed" style="font-family:'Satoshi',sans-serif;color:rgba(255,255,255,0.55);">
          Preferences, limits and what you won't negotiate. Helps us avoid designing something you can't sustain.
        </p>
      </div>

      <div class="reveal-item pl-5" style="--i:3;border-left:2px solid #00698D;">
        <h3 class="text-xl md:text-2xl font-bold tracking-tight" style="font-family:'Space Grotesk',sans-serif;color:#FFFFFF;">Access</h3>
        <p class="mt-2 text-base leading-relaxed" style="font-family:'Satoshi',sans-serif;color:rgba(255,255,255,0.55);">
          Accounts, suppliers, data and what happens day to day. Without that, we're operating blind.
        </p>
      </div>

      <div class="reveal-item pl-5" style="--i:4;border-left:2px solid #163667;">
        <h3 class="text-xl md:text-2xl font-bold tracking-tight" style="font-family:'Space Grotesk',sans-serif;color:#FFFFFF;">Decisions</h3>
        <p class="mt-2 text-base leading-relaxed" style="font-family:'Satoshi',sans-serif;color:rgba(255,255,255,0.55);">
          Validate, prioritize and say yes or no on time. The project moves when someone decides — and that someone is you.
        </p>
      </div>

    </div>

    <div class="reveal-item mt-14 md:mt-20 max-w-2xl" style="--i:5">
      <p class="text-base md:text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:rgba(255,255,255,0.7);">
        The first conversation usually lasts 30–40 minutes. We listen to the idea and tell you if it makes sense — no commitment.
      </p>
      <div class="mt-6">
        <a href="/en/get-started" class="cta-slide" style="
          display: inline-block; width: 240px; height: 52px;
          border-radius: 4px; overflow: hidden;
          cursor: pointer; text-decoration: none;
          box-shadow: inset 0 0 0 2px rgba(168,216,234,0.55);
        ">
          <div style="height: 52px; display: flex; align-items: center; justify-content: center; transition: transform 0.6s cubic-bezier(.16,1,.3,1); flex-shrink: 0;">
            <span style="font-size: 15px; font-weight: 600; color: #A8D8EA; font-family: 'Satoshi', sans-serif;">Start a conversation</span>
          </div>
          <div style="height: 52px; display: flex; align-items: center; justify-content: center; transition: transform 0.6s cubic-bezier(.16,1,.3,1); flex-shrink: 0; background: #A8D8EA;">
            <span style="font-size: 15px; font-weight: 600; color: #0F2548; font-family: 'Satoshi', sans-serif;">No commitment</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ═════════════════════════════════════════
WHAT WE'RE NOT / WHAT WE ARE — firm criteria
═════════════════════════════════════════ -->
<section style="background:#FFFFFF;" data-reveal>
  <div class="max-w-3xl mx-auto px-6 md:px-12 py-14 md:py-24">
    <span class="reveal-item text-[11px] tracking-[0.35em] uppercase font-semibold opacity-35" style="--i:0;color:#6B7280;font-family:'Satoshi',sans-serif;">Criteria</span>
    <h2 class="reveal-item mt-4 text-[2rem] md:text-4xl font-bold tracking-tight leading-[1.1]" style="--i:1;font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
      What we're not.<br>What we are.
    </h2>

    <div class="mt-10 md:mt-14 space-y-8 md:space-y-10">
      <div class="reveal-item grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-8" style="--i:2">
        <p class="text-base md:text-lg leading-snug" style="font-family:'Satoshi',sans-serif;color:#9CA3AF;">We don't sell packs or formulas</p>
        <p class="text-base md:text-lg leading-snug font-medium" style="font-family:'Satoshi',sans-serif;color:#0F2548;">We do accompany the project end to end</p>
      </div>
      <div class="reveal-item grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-8" style="--i:3;border-top:1px solid rgba(15,37,72,0.08);padding-top:2rem;">
        <p class="text-base md:text-lg leading-snug" style="font-family:'Satoshi',sans-serif;color:#9CA3AF;">We don't promise miracles</p>
        <p class="text-base md:text-lg leading-snug font-medium" style="font-family:'Satoshi',sans-serif;color:#0F2548;">We do work with process and judgment</p>
      </div>
      <div class="reveal-item grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-8" style="--i:4;border-top:1px solid rgba(15,37,72,0.08);padding-top:2rem;">
        <p class="text-base md:text-lg leading-snug" style="font-family:'Satoshi',sans-serif;color:#9CA3AF;">We're not just another marketing agency</p>
        <p class="text-base md:text-lg leading-snug font-medium" style="font-family:'Satoshi',sans-serif;color:#0F2548;">We are a strategy and execution firm</p>
      </div>
    </div>
  </div>
</section>

<!-- ═════════════════════════════════════════
AUTHORITY QUOTE
═════════════════════════════════════════ -->
<section style="background:#F5F1EC;" data-reveal>
  <div class="max-w-3xl mx-auto px-6 md:px-12 py-12 md:py-20 text-center">
    <img src="/images/logo-marino.png" alt="Blue Unicorn" class="reveal-item h-8 w-auto mx-auto mb-5 opacity-50" style="--i:0" />
    <blockquote class="reveal-item text-2xl md:text-3xl font-bold leading-[1.2] tracking-tight" style="--i:1;font-family:'Space Grotesk',sans-serif;color:#163667;">
      &ldquo;We don't work with promises or miracle formulas.&rdquo;
    </blockquote>
    <p class="reveal-item mt-4 text-base opacity-50" style="--i:2;font-family:'Satoshi',sans-serif;color:#6B7280;">— Luis Chicharro · Brands Developer</p>
  </div>
</section>

<!-- ═════════════════════════════════════════
SORIE™ — Method (copied from index)
═════════════════════════════════════════ -->
<section class="relative" style="background: #FFFFFF;" data-sorie-reveal>

    <div class="text-center pt-14 md:pt-32 pb-6 md:pb-10 px-4">
      <span class="sorie-eyebrow text-[11px] tracking-[0.35em] uppercase font-semibold opacity-35" style="color: #6B7280; font-family: 'Satoshi', sans-serif;">Our methodology</span>
      <h2 class="sorie-title mt-4 text-4xl md:text-5xl font-bold tracking-tight" style="font-family: 'Space Grotesk', sans-serif; color: #1A1A1A;">
        The method behind<br class="md:hidden"> everything we do<br>at Blue Unicorn
      </h2>
    </div>

    <!-- Letters S O R I E — bilingual -->
    <div class="flex flex-nowrap items-end justify-center gap-2.5 md:gap-12 lg:gap-20 px-4 pb-10 md:pb-14 max-w-4xl mx-auto">

      <!-- S — Strategy / Estrategia -->
      <div class="sorie-col flex flex-col items-center gap-1.5 shrink-0" style="--i:0">
        <span class="text-5xl md:text-8xl lg:text-9xl font-black leading-none tracking-tighter" style="font-family: 'Space Grotesk', sans-serif; color: #0F2548;">S</span>
        <span class="text-[10px] md:text-sm font-semibold tracking-wide whitespace-nowrap" style="font-family: 'Satoshi', sans-serif; color: #0F2548;">Strategy</span>
        <span class="text-[8px] md:text-xs font-medium tracking-wide opacity-40 whitespace-nowrap" style="font-family: 'Satoshi', sans-serif; color: #0F2548;">Estrategia</span>
      </div>

      <!-- O — Opportunity / Oportunidad -->
      <div class="sorie-col flex flex-col items-center gap-1.5 shrink-0" style="--i:1">
