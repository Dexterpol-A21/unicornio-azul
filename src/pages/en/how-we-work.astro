<!-- FAQ accordion script -->
<script>
  (function () {
    const accordion = document.getElementById('faq-accordion');
    if (!accordion) return;
    const triggers = accordion.querySelectorAll('.faq-trigger');
    triggers.forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.faq-item')!;
        const content = item.querySelector('.faq-content') as HTMLElement;
        const icon = btn.querySelector('.faq-icon') as HTMLElement;
        const isOpen = btn.getAttribute('aria-expanded') === 'true';

        // Close all others
        triggers.forEach(other => {
          if (other !== btn) {
            other.setAttribute('aria-expanded', 'false');
            (other.querySelector('.faq-icon') as HTMLElement).style.transform = 'rotate(0deg)';
            const otherContent = other.closest('.faq-item')!.querySelector('.faq-content') as HTMLElement;
            otherContent.style.maxHeight = '0';
          }
        });

        if (isOpen) {
          btn.setAttribute('aria-expanded', 'false');
          icon.style.transform = 'rotate(0deg)';
          content.style.maxHeight = '0';
        } else {
          btn.setAttribute('aria-expanded', 'true');
          icon.style.transform = 'rotate(45deg)';
          content.style.maxHeight = content.scrollHeight + 'px';
        }
      });
    });
  })();
</script>

