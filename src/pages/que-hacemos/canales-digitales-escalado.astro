---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProblemBridge from '@/components/ProblemBridge.astro';
---

<BaseLayout
  title="Canales Digitales y Escalado — Unicornio Azul"
  description="Escalamos negocios a través de canales digitales: Amazon FBA, marketplaces, e-commerce B2B, logística y fulfillment, y estrategias de expansión internacional."
  image="/images/og-escalado.jpg"
  showHeader={true}
>

<!-- ═════════════════════════════════════════
HERO LANDING — Canales Digitales y Escalado
aqua #00698D · triángulo ▲ · min-h-85dvh
═════════════════════════════════════════ -->
<section class="relative overflow-hidden md:min-h-[85dvh]" style="background:#00698D;">

  <!-- Fondo geométrico — triángulo gigante top-right + triángulos pequeños izquierda -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none z-0" aria-hidden="true" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <!-- ═══ TRIÁNGULO GIGANTE — top-right, enorme, recortado ═══ -->
    <g transform="translate(1500, 140) scale(8)" opacity="0.04">
      <polygon points="0,-50 -43,25 43,25" fill="#ffffff"/>
    </g>

    <!-- ═══ TRIÁNGULOS PEQUEÑOS — izquierda del contenido ═══ -->
    <g transform="translate(80, 120) scale(0.9)" opacity="0.07">
      <polygon points="0,-15 -13,8 13,8" fill="#ffffff"/>
    </g>
    <g transform="translate(140, 260) scale(0.6)" opacity="0.06">
      <polygon points="0,-14 -12,7 12,7" fill="#ffffff"/>
    </g>
    <g transform="translate(60, 380) scale(0.75)" opacity="0.055">
      <polygon points="0,-15 -13,8 13,8" fill="#ffffff"/>
    </g>
    <g transform="translate(180, 480) scale(0.55)" opacity="0.05">
      <polygon points="0,-14 -12,7 12,7" fill="#ffffff"/>
    </g>
    <g transform="translate(100, 620) scale(0.7)" opacity="0.06">
      <polygon points="0,-15 -13,8 13,8" fill="#ffffff"/>
    </g>
    <g transform="translate(200, 760) scale(0.5)" opacity="0.05">
      <polygon points="0,-14 -12,7 12,7" fill="#ffffff"/>
    </g>
    <g transform="translate(50, 830) scale(0.65)" opacity="0.055">
      <polygon points="0,-15 -13,8 13,8" fill="#ffffff"/>
    </g>
  </svg>

  <div class="relative z-10 w-full max-w-6xl mx-auto px-6 md:px-12 h-full flex flex-col">

    <!-- GRID 2-columnas: texto izq · visual der -->
    <div class="flex-1 flex flex-col items-center gap-6 md:gap-8 pt-10 md:pt-20 pb-4 md:pb-28">

      <!-- TOP ROW: texto izq + ilustración der -->
      <div class="w-full flex flex-col lg:flex-row items-center justify-center gap-8 lg:gap-16">

        <!-- COLUMNA IZQUIERDA — texto -->
        <div class="flex-1 flex flex-col items-center lg:items-start text-center lg:text-left" data-reveal>
          <!-- H1 — enorme -->
          <h1 class="reveal-item leading-[0.92] tracking-tight max-w-[14ch]" style="--i:0;color:#ffffff;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(2.8rem,10vw,5.5rem);">
            Escala al<br>mundo digital
          </h1>

          <!-- Subtítulo -->
          <p class="reveal-item mt-4 md:mt-8 text-lg md:text-lg max-w-[40ch] leading-relaxed" style="--i:1;color:rgba(255,255,255,0.55);font-family:'Satoshi',sans-serif;">
            Amazon FBA, marketplaces, e-commerce B2B, logística y fulfillment. Diversificamos canales y escalamos tu negocio a nivel internacional.
          </p>

          <!-- CTA — desktop (en columna de texto) -->
          <div class="reveal-item hidden lg:flex mt-8" style="--i:2">
            <a href="/empezar" class="animated-btn" style="position:relative;display:inline-flex;align-items:center;justify-content:center;height:56px;padding:0 52px 0 36px;font-size:16px;background-color:#ffffff;border-radius:4px;font-weight:600;font-family:'Satoshi',sans-serif;color:#00698D;cursor:pointer;overflow:hidden;text-decoration:none;box-shadow:0 0.625em 1.2em 0 rgba(0,0,0,0.12);">
              <span class="text" style="position:relative;z-index:2;transition:transform 0.8s cubic-bezier(0.23,1,0.32,1);">Cuéntanos tu proyecto</span>
              <svg class="arr-1" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;right:22px;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#00698D" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              <svg class="arr-2" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;left:-25%;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#00698D" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              <span class="circle" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:20px;height:20px;background-color:#00698D;border-radius:50%;opacity:0;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);"></span>
            </a>
          </div>
        </div>

        <!-- COLUMNA DERECHA — ilustración conceptual: escalado y canales digitales -->
        <div class="flex-1 w-full max-w-[360px] sm:max-w-[420px] md:max-w-[480px] aspect-[4/3] flex items-center justify-center relative" role="img" aria-label="Ilustración de pirámides con gráfico de crecimiento representando canales digitales y escalado internacional">
          <svg viewBox="0 0 480 360" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="pyrLeft" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0.9"/>
                <stop offset="100%" stop-color="#ffffff" stop-opacity="0.4"/>
              </linearGradient>
              <linearGradient id="pyrRight" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0.4"/>
                <stop offset="100%" stop-color="#ffffff" stop-opacity="0.05"/>
              </linearGradient>
              <radialGradient id="glow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0.25"/>
                <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
              </radialGradient>
              <radialGradient id="coreGlow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0.8"/>
                <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
              </radialGradient>
            </defs>

            <!-- 1. FONDO: Resplandor -->
            <circle cx="240" cy="180" r="200" fill="url(#glow)" />

            <!-- 2. LÍNEA DE TENDENCIA (Trendline) -->
            <path d="M 20,340 L 140,260 L 260,180 L 380,100 L 460,20" fill="none" stroke="#ffffff" stroke-width="2" opacity="0.2" />
            <path d="M 20,340 L 140,260 L 260,180 L 380,100 L 460,20" fill="none" stroke="#ffffff" stroke-width="3" stroke-dasharray="12 12">
              <animate attributeName="stroke-dashoffset" from="120" to="0" dur="3s" repeatCount="indefinite" />
            </path>

            <!-- Conexiones verticales -->
            <g opacity="0.15" stroke="#ffffff" stroke-width="1.5" stroke-dasharray="4 4">
              <line x1="140" y1="260" x2="140" y2="340" />
              <line x1="260" y1="180" x2="260" y2="340" />
              <line x1="380" y1="100" x2="380" y2="340" />
              <line x1="20" y1="340" x2="460" y2="340" stroke-dasharray="none" opacity="0.5" />
            </g>

            <!-- 3. LAS PIRÁMIDES (Escalado) -->
            
            <!-- Pirámide 1 (Pequeña - E-commerce) -->
            <g transform="translate(140, 260) scale(0.6)">
              <g>
                <animateTransform attributeName="transform" type="translate" values="0,0; 0,-10; 0,0" dur="4s" repeatCount="indefinite" />
                <polygon points="0,40 -40,20 0,0 40,20" fill="#000000" opacity="0.2" />
                <circle cx="0" cy="-10" r="20" fill="url(#coreGlow)" />
                <polygon points="0,-50 -40,10 0,30" fill="url(#pyrLeft)" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="round" />
                <polygon points="0,-50 40,10 0,30" fill="url(#pyrRight)" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="round" />
              </g>
            </g>

            <!-- Pirámide 2 (Mediana - Marketplaces) -->
            <g transform="translate(260, 180) scale(0.8)">
              <g>
                <animateTransform attributeName="transform" type="translate" values="0,0; 0,-12; 0,0" dur="5s" begin="1s" repeatCount="indefinite" />
                <polygon points="0,40 -40,20 0,0 40,20" fill="#000000" opacity="0.2" />
                <circle cx="0" cy="-10" r="25" fill="url(#coreGlow)" />
                <polygon points="0,-50 -40,10 0,30" fill="url(#pyrLeft)" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="round" />
                <polygon points="0,-50 40,10 0,30" fill="url(#pyrRight)" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="round" />
              </g>
            </g>

            <!-- Pirámide 3 (Grande - Amazon / Global) -->
            <g transform="translate(380, 100) scale(1.1)">
              <g>
                <animateTransform attributeName="transform" type="translate" values="0,0; 0,-18; 0,0" dur="6s" begin="2s" repeatCount="indefinite" />
                <path id="orbitPath" d="M -60,15 A 60,20 0 1,1 60,15 A 60,20 0 1,1 -60,15" fill="none" stroke="#ffffff" stroke-width="1.5" opacity="0.4" stroke-dasharray="4 4" />
                <circle r="4" fill="#ffffff">
                  <animateMotion dur="6s" repeatCount="indefinite">
                    <mpath href="#orbitPath" />
                  </animateMotion>
                </circle>
                <circle r="3" fill="#ffffff" opacity="0.6">
                  <animateMotion dur="6s" begin="-3s" repeatCount="indefinite">
                    <mpath href="#orbitPath" />
                  </animateMotion>
                </circle>
                <polygon points="0,40 -40,20 0,0 40,20" fill="#000000" opacity="0.2" />
                <circle cx="0" cy="-10" r="30" fill="url(#coreGlow)" />
                <polygon points="0,-50 -40,10 0,30" fill="url(#pyrLeft)" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="round" />
                <polygon points="0,-50 40,10 0,30" fill="url(#pyrRight)" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="round" />
              </g>
            </g>

            <!-- 4. ELEMENTOS FLOTANTES (UI Cards / Canales) -->
            
            <!-- Card 1: E-commerce -->
            <g transform="translate(50, 140)">
              <g>
                <animateTransform attributeName="transform" type="translate" values="0,0; 0,-8; 0,0" dur="4.5s" repeatCount="indefinite" />
                <rect x="0" y="0" width="60" height="70" rx="6" fill="#ffffff" opacity="0.95" stroke="#ffffff" stroke-width="1.5" />
                <rect x="0" y="0" width="60" height="15" rx="6" fill="#00698D" opacity="0.1" />
                <circle cx="10" cy="7.5" r="3" fill="#00698D" />
                <rect x="8" y="22" width="44" height="20" rx="3" fill="#00698D" opacity="0.2" />
                <rect x="8" y="48" width="30" height="4" rx="2" fill="#00698D" opacity="0.4" />
                <rect x="8" y="56" width="20" height="4" rx="2" fill="#00698D" opacity="0.2" />
              </g>
            </g>

            <!-- Card 2: Marketplaces -->
            <g transform="translate(260, 295)">
              <g>
                <animateTransform attributeName="transform" type="translate" values="0,0; 0,-8; 0,0" dur="5.5s" begin="-2s" repeatCount="indefinite" />
                <rect x="0" y="0" width="70" height="50" rx="6" fill="#ffffff" opacity="0.95" stroke="#ffffff" stroke-width="1.5" />
                <rect x="8" y="8" width="14" height="14" rx="2" fill="#00698D" opacity="0.6" />
                <rect x="28" y="8" width="14" height="14" rx="2" fill="#00698D" opacity="0.4" />
                <rect x="48" y="8" width="14" height="14" rx="2" fill="#00698D" opacity="0.2" />
                <rect x="8" y="28" width="14" height="14" rx="2" fill="#00698D" opacity="0.2" />
                <rect x="28" y="28" width="14" height="14" rx="2" fill="#00698D" opacity="0.6" />
                <rect x="48" y="28" width="14" height="14" rx="2" fill="#00698D" opacity="0.4" />
              </g>
            </g>

            <!-- Card 3: Growth Badge -->
            <g transform="translate(360, 30)">
              <g>
                <animateTransform attributeName="transform" type="translate" values="0,0; 0,-6; 0,0" dur="3.5s" begin="-1s" repeatCount="indefinite" />
                <rect x="0" y="0" width="60" height="30" rx="15" fill="#ffffff" opacity="0.95" stroke="#ffffff" stroke-width="1.5" />
                <path d="M 15,18 L 22,11 L 29,18" fill="none" stroke="#00698D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                <line x1="22" y1="11" x2="22" y2="22" stroke="#00698D" stroke-width="2.5" stroke-linecap="round" />
                <circle cx="42" cy="15" r="3" fill="#00698D" />
                <circle cx="50" cy="15" r="3" fill="#00698D" opacity="0.4" />
              </g>
            </g>

          </svg>
        </div>

      </div>
      <!-- END top row -->

      <!-- CTA — debajo de la ilustración (solo mobile) -->
      <div class="lg:hidden mt-2">
        <a href="/empezar" class="animated-btn" style="position:relative;display:inline-flex;align-items:center;justify-content:center;height:60px;padding:0 56px 0 40px;font-size:17px;background-color:#ffffff;border-radius:4px;font-weight:600;font-family:'Satoshi',sans-serif;color:#00698D;cursor:pointer;overflow:hidden;text-decoration:none;box-shadow:0 0.625em 1.2em 0 rgba(0,0,0,0.12);">
          <span class="text" style="position:relative;z-index:2;transition:transform 0.8s cubic-bezier(0.23,1,0.32,1);">Cuéntanos tu proyecto</span>
          <svg class="arr-1" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;right:26px;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#00698D" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <svg class="arr-2" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;left:-25%;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#00698D" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <span class="circle" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:20px;height:20px;background-color:#00698D;border-radius:50%;opacity:0;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);"></span>
        </a>
      </div>

    </div>

  </div>
</section>

<!-- ═════════════════════════════════════════
PROBLEMA → RESPUESTA (Feedback HOME §5)
═════════════════════════════════════════ -->
<ProblemBridge
  problem="Quiero internacionalizar mi empresa"
  solution="Creamos la estrategia"
  accent="#00698D"
  shape="triangle"
/>

<!-- ═════════════════════════════════════════
2. INTRO — Canales digitales y escalado internacional
Diseño editorial · 2-columnas
═════════════════════════════════════════ -->
<section style="background:#FFFFFF;" data-reveal>
  <div class="max-w-6xl mx-auto px-6 md:px-12 pt-14 md:pt-32 pb-12 md:pb-24 flex flex-col md:flex-row gap-8 md:gap-20">

    <!-- COLUMNA IZQUIERDA — headline -->
    <div class="reveal-item md:w-[42%] flex flex-col" style="--i:0">
      <h2 class="text-[2.5rem] md:text-[2.5rem] font-bold leading-[1.05] tracking-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
        Canales digitales<br>y escalado internacional
      </h2>
      <div class="mt-6 md:mt-8 w-16 h-[2px]" style="background:#00698D;opacity:0.2;"></div>
    </div>

    <!-- COLUMNA DERECHA — texto -->
    <div class="reveal-item md:w-[58%] space-y-6 text-lg md:text-lg leading-relaxed" style="--i:1;font-family:'Satoshi',sans-serif;color:#374151;">
      <!-- Lead — destacado -->
      <p class="text-xl md:text-2xl leading-relaxed" style="color:#00698D;font-weight:700; font-family:'Space Grotesk',sans-serif;">
        Ayudamos a vender y escalar negocios a través de canales digitales.
      </p>
      <p>
        <strong style="color:#1A1A1A;font-weight:700;">Amazon (FBA incluido)</strong> es una herramienta clave para vender y escalar, pero no la única. Nuestro enfoque busca diversificar canales y preparar el negocio para crecer a nivel nacional e internacional.
      </p>
      <p>
        No escalamos un negocio por escalar. Trabajamos <strong style="color:#1A1A1A;font-weight:700;">e-commerce B2B, logística y fulfillment, marketplaces y plataformas digitales</strong> con estrategia, datos y visión de medio plazo para que el crecimiento sea sostenible.
      </p>
    </div>

  </div>
</section>

<!-- ═════════════════════════════════════════
3. QUÉ INCLUYE — 4 bloques según el brief
═════════════════════════════════════════ -->
<section style="background:#F2F5F8;" data-reveal>
  <div class="max-w-4xl mx-auto md:px-12 py-14 md:py-28">

    <div class="px-6 md:px-0">
      <h2 class="reveal-item text-[2.5rem] md:text-4xl font-bold tracking-tight mb-8 md:mb-14" style="--i:0;font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
        Cuatro canales.<br>Un solo objetivo: vender más.
      </h2>
    </div>

    <!-- Mobile: horizontal gallery -->
    <div class="md:hidden overflow-hidden w-full" data-bloque-rail data-bloque-x>
      <div class="flex gap-3 overflow-x-auto snap-x snap-mandatory" data-bloque-scroller style="scrollbar-width:none; -ms-overflow-style:none; padding-left:24px; padding-right:24px; scroll-padding-left:24px; scroll-padding-right:24px;">

        <!-- 01 -->
        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" data-bloque-item style="--c:#0F2548;background:#FFFFFF;border:1px solid rgba(15,37,72,0.06);">
          <span class="bloque-num block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;">01</span>
          <h3 class="bloque-title text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Amazon</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">Gestión integral de cuentas en Amazon Europa e internacional. Desde el registro de marca hasta la optimización de listados y campañas publicitarias dentro de la plataforma.</p>
        </div>

        <!-- 02 -->
        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" data-bloque-item style="--c:#163667;background:#FFFFFF;border:1px solid rgba(15,37,72,0.06);">
          <span class="bloque-num block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;">02</span>
          <h3 class="bloque-title text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Marketplaces</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">Llevamos tu producto a otras plataformas y marketplaces relevantes para tu sector, diversificando los canales de venta y reduciendo la dependencia de uno solo.</p>
        </div>

        <!-- 03 -->
        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" data-bloque-item style="--c:#0B4F7A;background:#FFFFFF;border:1px solid rgba(15,37,72,0.06);">
          <span class="bloque-num block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;">03</span>
          <h3 class="bloque-title text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">E-commerce</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">Creamos y optimizamos tiendas online propias con las herramientas adecuadas para tu producto, tu cliente y tu modelo de negocio.</p>
        </div>

        <!-- 04 -->
        <div class="snap-start shrink-0 w-[82vw] max-w-[360px] flex flex-col gap-3 p-5 rounded-xl" data-bloque-item style="--c:#00698D;background:#FFFFFF;border:1px solid rgba(15,37,72,0.06);">
          <span class="bloque-num block text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;">04</span>
          <h3 class="bloque-title text-xl font-bold leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Estrategias de escalado digital</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">Diseñamos la hoja de ruta para crecer más allá del primer canal: nuevos mercados, expansión internacional y diversificación de ingresos.</p>
        </div>

      </div>
    </div>

    <!-- Indicador dots (solo mobile) -->
    <div id="canales-dots" class="md:hidden flex items-center justify-center gap-2 mt-5">
      <span class="block w-2 h-2 rounded-full" style="background:#00698D;"></span>
      <span class="block w-2 h-2 rounded-full" style="background:rgba(0,105,141,0.2);"></span>
      <span class="block w-2 h-2 rounded-full" style="background:rgba(0,105,141,0.2);"></span>
      <span class="block w-2 h-2 rounded-full" style="background:rgba(0,105,141,0.2);"></span>
    </div>

    <!-- Desktop: vertical stack -->
    <div class="hidden md:flex flex-col gap-4 mt-14 px-12" data-bloque-rail>

      <div class="reveal-item flex flex-col md:flex-row gap-4 md:gap-10 items-start p-5 md:p-8 rounded-xl" data-bloque-item style="--i:1;--c:#0F2548;background:#FFFFFF;border:1px solid rgba(15,37,72,0.06);">
        <div class="shrink-0"><span class="bloque-num block text-8xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;">01</span></div>
        <div class="flex-1">
          <h3 class="bloque-title text-2xl font-bold mb-1.5 leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Amazon</h3>
          <p class="text-lg leading-relaxed" style="font-family:'Satoshi',sans-serif;color:#374151;">Gestión integral de cuentas en Amazon Europa e internacional. Desde el registro de marca hasta la optimización de listados y campañas publicitarias dentro de la plataforma.</p>
        </div>
      </div>

