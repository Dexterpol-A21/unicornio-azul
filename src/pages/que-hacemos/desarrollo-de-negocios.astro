<!-- Scroll indicator scripts for mobile horizontal galleries -->
<script>
  (function () {
    // Bloques 01-04 gallery
    const scroller = document.querySelector('.overflow-x-auto');
    const dots = document.querySelectorAll('#bloques-dots span');
    if (scroller && dots.length) {
      scroller.addEventListener('scroll', () => {
        const step = (scroller.scrollWidth - scroller.clientWidth) / (dots.length - 1);
        const idx = Math.round(scroller.scrollLeft / (step || 1));
        const clamped = Math.min(idx, dots.length - 1);
        dots.forEach((d, i) => {
          (d as HTMLElement).style.background = i === clamped ? '#0F2548' : 'rgba(22,54,103,0.2)';
        });
      }, { passive: true });
    }

    // Pilares gallery (with geometric figure indicators)
    const pillarsScroller = document.querySelectorAll('.overflow-x-auto')[1];
    const figs = document.querySelectorAll('#pilares-figs svg');
    if (pillarsScroller && figs.length) {
      const colors = ['#163667', '#0B4F7A', '#00698D']; // square, circle, triangle
      pillarsScroller.addEventListener('scroll', () => {
        const step = (pillarsScroller.scrollWidth - pillarsScroller.clientWidth) / (figs.length - 1);
        const idx = Math.round(pillarsScroller.scrollLeft / (step || 1));
        const clamped = Math.min(idx, figs.length - 1);
        figs.forEach((fig, i) => {
          const fill = i === clamped ? colors[i] : colors[i] + '33'; // active = solid, inactive = ~20% opacity
          if (fig.querySelector('rect')) fig.querySelector('rect')!.setAttribute('fill', fill);
          else if (fig.querySelector('circle')) fig.querySelector('circle')!.setAttribute('fill', fill);
          else if (fig.querySelector('polygon')) fig.querySelector('polygon')!.setAttribute('fill', fill);
        });
      }, { passive: true });
    }
  })();
</script>

