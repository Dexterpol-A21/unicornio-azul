---
import BaseLayout from '@layouts/BaseLayout.astro';

Astro.response.status = 404;
---

<BaseLayout
  title="404 — Unicornio Azul"
  description="Página no encontrada."
  showHeader={true}
  noindex={true}
>

<!--
  404 bilingüe (estático): el host sirve 404.html para cualquier ruta inexistente.
  El idioma se decide en cliente según si la URL empieza por /en.
-->
<div class="min-h-screen flex flex-col overflow-x-hidden" style="background:#FFFFFF;" id="page-404">

  <div class="flex-1 flex flex-col justify-center w-full max-w-[92vw] md:max-w-[80vw] mx-auto px-4 md:px-0 pt-16 md:pt-36 pb-16 md:pb-32" data-reveal>

    <p
      class="reveal-item text-sm md:text-base font-medium tracking-[0.2em] uppercase mb-4 md:mb-6"
      style="--i:0;font-family:'Satoshi',sans-serif;color:#00698D;"
      data-i18n="eyebrow"
    >
      Error 404
    </p>

    <h1
      class="reveal-item text-[22vw] md:text-[16vw] lg:text-[14vw] font-black leading-[0.85] tracking-tighter"
      style="--i:1;font-family:'Space Grotesk',sans-serif;color:#1A1A1A;"
    >
      <span data-i18n="title-a">Perdi</span><span style="color:transparent;-webkit-text-stroke:2px #00698D;" data-i18n="title-b">do</span>
    </h1>

    <p
      class="reveal-item mt-8 md:mt-12 max-w-xl text-lg md:text-2xl leading-snug"
      style="--i:2;font-family:'Satoshi',sans-serif;color:#4A4A4A;"
      data-i18n="body"
    >
      Esta página no existe — o todavía no. Vuelve al inicio o cuéntanos tu proyecto.
    </p>

    <div class="reveal-item stagger-inner mt-10 md:mt-16 flex flex-row items-center gap-4" style="--i:3">
      <!-- Primario — mismo animated-btn del index -->
      <a
        href="/"
        class="animated-btn"
        style="
          position: relative; display: inline-flex; align-items: center; justify-content: center;
          height: 52px; padding: 0 48px 0 32px;
          font-size: 15px; background-color: #163667;
          border-radius: 4px; font-weight: 600; font-family: 'Satoshi', sans-serif;
          color: #ffffff; cursor: pointer; overflow: hidden; text-decoration: none;
          box-shadow: 0 0.625em 1em 0 rgba(22, 54, 103, 0.20);
        "
        data-href-es="/"
        data-href-en="/en/"
      >
        <span class="text" data-i18n="cta-home" style="position: relative; z-index: 2; transition: transform 0.8s cubic-bezier(0.23, 1, 0.32, 1);">Volver al inicio</span>
        <svg class="arr-1" style="position: absolute; top: 50%; margin-top: -10px; width: 20px; height: 20px; z-index: 2; right: 20px; transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);" fill="none" stroke="#ffffff" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        <svg class="arr-2" style="position: absolute; top: 50%; margin-top: -10px; width: 20px; height: 20px; z-index: 2; left: -25%; transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);" fill="none" stroke="#ffffff" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        <span class="circle" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 20px; height: 20px; background-color: #00698D; border-radius: 50%; opacity: 0; transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);"></span>
      </a>

      <!-- Secundario — mismo cta-slide del index -->
      <a
        href="/empezar"
        class="cta-slide"
        style="
          display: block; width: 190px; height: 52px;
          border-radius: 4px; overflow: hidden;
          cursor: pointer; text-decoration: none;
          box-shadow: inset 0 0 0 2px #163667;
        "
        data-href-es="/empezar"
        data-href-en="/en/get-started"
      >
        <div style="height: 52px; display: flex; align-items: center; justify-content: center; transition: transform 0.6s cubic-bezier(.16,1,.3,1); flex-shrink: 0;">
          <span data-i18n="cta-start" style="font-size: 15px; font-weight: 600; color: #163667; font-family: 'Satoshi', sans-serif;">Empezar</span>
        </div>
        <div style="height: 52px; display: flex; align-items: center; justify-content: center; transition: transform 0.6s cubic-bezier(.16,1,.3,1); flex-shrink: 0; background: #163667;">
          <span data-i18n="cta-start-alt" style="font-size: 15px; font-weight: 600; color: #ffffff; font-family: 'Satoshi', sans-serif;">Hablemos</span>
        </div>
      </a>
    </div>

  </div>
</div>

<script>
  const copy = {
    es: {
      eyebrow: 'Error 404',
      'title-a': 'Perdi',
      'title-b': 'do',
      body: 'Esta página no existe — o todavía no. Vuelve al inicio o cuéntanos tu proyecto.',
      'cta-home': 'Volver al inicio',
      'cta-start': 'Empezar',
      'cta-start-alt': 'Hablemos',
    },
    en: {
      eyebrow: 'Error 404',
      'title-a': 'Lost',
      'title-b': '',
      body: "This page doesn't exist — or not yet. Head home or tell us about your project.",
      'cta-home': 'Back to home',
      'cta-start': 'Get started',
      'cta-start-alt': "Let's talk",
    },
  };

  const path = window.location.pathname;
  const lang = path === '/en' || path.startsWith('/en/') ? 'en' : 'es';
  const t = copy[lang];

  document.documentElement.lang = lang;

  document.querySelectorAll('[data-i18n]').forEach((el) => {
    const key = el.getAttribute('data-i18n');
    if (!key || !(key in t)) return;
    el.textContent = t[key as keyof typeof t];
  });

  document.querySelectorAll('[data-href-es]').forEach((el) => {
    const href = el.getAttribute(lang === 'en' ? 'data-href-en' : 'data-href-es');
    if (href && el instanceof HTMLAnchorElement) el.href = href;
  });

  // English title uses a single word; keep stroke accent on a trailing glyph
  if (lang === 'en') {
    const titleB = document.querySelector('[data-i18n="title-b"]');
    if (titleB) {
      titleB.textContent = '?';
      (titleB as HTMLElement).style.webkitTextStroke = '2px #00698D';
      (titleB as HTMLElement).style.color = 'transparent';
    }
  }
</script>

<style is:global>
  .cta-slide {
    transition: box-shadow 0.8s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .cta-slide:hover {
    box-shadow: inset 0 0 0 2px #163667, 0 0.625em 1em 0 rgba(22, 54, 103, 0.30) !important;
  }
  .cta-slide:hover div {
    transform: translateY(-52px) !important;
  }
  .cta-slide:active {
    transform: scale(0.97) !important;
  }

  .animated-btn:hover {
    box-shadow: 0 0.625em 1em 0 rgba(0, 105, 141, 0.30) !important;
  }
  .animated-btn:hover .arr-1 {
    right: -25% !important;
  }
  .animated-btn:hover .arr-2 {
    left: 16px !important;
  }
  .animated-btn:hover .text {
    transform: translateX(14px) !important;
  }
  .animated-btn:hover .circle {
    width: 400px !important;
    height: 400px !important;
    opacity: 1 !important;
  }
  .animated-btn:active {
    scale: 0.95 !important;
    box-shadow: inset 0 0 0 3px #00698D !important;
  }

  @media (max-width: 767px) {
    .stagger-inner:has(> .animated-btn):has(> .cta-slide) {
      flex-direction: column !important;
      width: 100% !important;
      align-items: stretch !important;
    }

    .stagger-inner:has(> .animated-btn):has(> .cta-slide) > .animated-btn {
      width: 100% !important;
      justify-content: center !important;
      height: 58px !important;
      font-size: 17px !important;
    }

    .stagger-inner:has(> .animated-btn):has(> .cta-slide) > .cta-slide {
      width: 100% !important;
      height: 58px !important;
    }

    .stagger-inner:has(> .animated-btn):has(> .cta-slide) > .cta-slide > div {
      height: 58px !important;
    }

    .stagger-inner:has(> .animated-btn):has(> .cta-slide) > .cta-slide > div > span {
      font-size: 17px !important;
    }

    .stagger-inner:has(> .animated-btn):has(> .cta-slide) > .cta-slide:hover div {
      transform: translateY(-58px) !important;
    }

    .animated-btn {
      width: 100% !important;
      box-sizing: border-box !important;
    }
  }
</style>

</BaseLayout>
