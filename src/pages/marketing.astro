    .banner-li__services {
      position: relative;
      z-index: 1;
      list-style: none;
      margin: 0;
      padding: 4px 0 4px 34px;
      border-left: 2px solid rgba(15, 37, 72, 0.12);
      display: flex;
      flex-direction: column;
      justify-content: center;
