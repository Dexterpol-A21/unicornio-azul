    }

    .banner-li__services svg {
      width: 46px;
      height: 46px;
      flex-shrink: 0;
      color: #163667;
    }

    /* ── Posts ── */
    .post {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 72px 64px;
      box-sizing: border-box;
      position: relative;
      overflow: hidden;
      font-family: 'Satoshi', sans-serif;
    }

    .post--navy {
      background: linear-gradient(160deg, #163667 0%, #0f2548 100%);
      color: #fff;
    }

    .post--midnight {
      background: linear-gradient(160deg, #0f2548 0%, #0b1a33 100%);
      color: #fff;
    }

    .post--ice {
      background: linear-gradient(160deg, #e8f4f8 0%, #a8d8ea 100%);
      color: #0f2548;
    }

    .post--aqua {
      background: linear-gradient(160deg, #0088b3 0%, #00698d 55%, #163667 100%);
      color: #fff;
    }

    .post--quote {
      --quote-ink: #0F2548;
      --quote-muted: rgba(15, 37, 72, 0.55);
      --quote-accent: #0088B3;
      --quote-bg: #A8D8EA;
      --quote-wash: rgba(168, 216, 234, 0.62);
      background: var(--quote-bg);
      color: var(--quote-ink);
    }

    .post__photo {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      pointer-events: none;
      display: none;
    }

    .post--quote.has-photo .post__photo {
      display: block;
    }

    .post--quote.has-photo::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
      background: var(--quote-wash);
      pointer-events: none;
    }

    .post--quote.has-photo .post__top,
    .post--quote.has-photo .post__body,
    .post--quote.has-photo .post__foot {
      position: relative;
      z-index: 1;
    }

    .post--quote .post__logo--on-light,
    .post--quote .post__logo--on-dark {
      height: 128px;
      padding: 16px 22px;
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.95);
    }

    .post--quote .post__quote-icon {
      display: block;
      width: 72px;
      height: auto;
      margin: 0 auto 8px;
      color: var(--quote-accent);
      opacity: 0.9;
    }

    .post--quote .post__quote-icon--close {
      margin: 20px auto 0;
      transform: rotate(180deg);
    }

    .post--quote .post__quote-text {
      margin: 8px auto 0;
      max-width: 10ch;
      font-size: 96px;
      letter-spacing: -0.03em;
      line-height: 1.02;
      color: var(--quote-ink);
    }

    .post--quote .post__quote-attr {
      margin-top: 28px;
      font-size: 28px;
      color: var(--quote-muted);
    }

    .post--quote .post__foot {
      font-size: 36px;
      font-weight: 700;
      color: var(--quote-muted);
    }

    /* 6 tonos — blanco + arcoíris Unicornio Azul */
    .post--tone-white {
      --quote-bg: #FFFFFF;
      --quote-wash: rgba(255, 255, 255, 0.55);
      --quote-ink: #0F2548;
      --quote-muted: rgba(15, 37, 72, 0.55);
      --quote-accent: #0088B3;
    }

    .post--tone-ice {
      --quote-bg: #A8D8EA;
      --quote-wash: rgba(168, 216, 234, 0.58);
      --quote-ink: #0F2548;
      --quote-muted: rgba(15, 37, 72, 0.58);
      --quote-accent: #00698D;
    }

    .post--tone-sky {
      --quote-bg: #0088B3;
      --quote-wash: rgba(0, 136, 179, 0.58);
      --quote-ink: #FFFFFF;
      --quote-muted: rgba(255, 255, 255, 0.78);
      --quote-accent: #A8D8EA;
    }

    .post--tone-aqua {
      --quote-bg: #00698D;
      --quote-wash: rgba(0, 105, 141, 0.6);
      --quote-ink: #FFFFFF;
      --quote-muted: rgba(255, 255, 255, 0.78);
      --quote-accent: #A8D8EA;
    }

    .post--tone-navy {
      --quote-bg: #163667;
      --quote-wash: rgba(22, 54, 103, 0.62);
      --quote-ink: #FFFFFF;
      --quote-muted: rgba(255, 255, 255, 0.75);
      --quote-accent: #A8D8EA;
    }

    .post--tone-midnight {
      --quote-bg: #0F2548;
      --quote-wash: rgba(15, 37, 72, 0.65);
      --quote-ink: #FFFFFF;
      --quote-muted: rgba(255, 255, 255, 0.72);
      --quote-accent: #0088B3;
    }

    .post--navy::after,
    .post--midnight::after,
    .post--aqua::after {
      content: '';
      position: absolute;
      width: 640px;
      height: 640px;
      border-radius: 50%;
      right: -220px;
      bottom: -260px;
      background: radial-gradient(circle, rgba(168, 216, 234, 0.22) 0%, transparent 68%);
      pointer-events: none;
    }

    .post__top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      z-index: 1;
    }

    .post__logo {
      height: 56px;
      width: auto;
    }

    .post__logo--dark {
      background: rgba(255, 255, 255, 0.95);
      border-radius: 8px;
      padding: 8px 12px;
      height: 64px;
    }

    .post__tag {
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #a8d8ea;
      border: 1.5px solid rgba(168, 216, 234, 0.45);
      padding: 10px 16px;
      border-radius: 999px;
    }

    .post__tag--dark {
      color: #163667;
      border-color: rgba(22, 54, 103, 0.35);
    }

    .post__body {
      position: relative;
      z-index: 1;
      max-width: 16ch;
    }

    .post__body--center {
      max-width: none;
      text-align: center;
      margin: 0 auto;
    }

    .post__h {
      margin: 0 0 28px;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 92px;
      font-weight: 700;
      letter-spacing: -0.045em;
      line-height: 0.95;
      color: #fff;
    }

    .post__h--dark {
      color: #0f2548;
    }

    .post__p {
      margin: 0;
      font-size: 28px;
      line-height: 1.35;
      color: rgba(255, 255, 255, 0.78);
      max-width: 22ch;
    }

    .post__p--dark {
      color: rgba(15, 37, 72, 0.75);
    }

    .post__quote-mark {
      margin: 0;
      font-family: 'Cormorant Garamond', serif;
      font-size: 160px;
      line-height: 0.6;
      color: #163667;
      opacity: 0.35;
    }

    .post__quote-text {
      margin: 12px auto 28px;
      max-width: 12ch;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 64px;
      font-weight: 700;
      letter-spacing: -0.035em;
      line-height: 1.05;
      color: #0f2548;
    }

    .post__quote-attr {
      margin: 0;
      font-size: 22px;
      color: rgba(15, 37, 72, 0.55);
    }

    .post__foot {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      font-size: 20px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.7);
    }

    .post__foot--dark {
      color: rgba(15, 37, 72, 0.65);
    }

    .post__pill {
      font-size: 16px;
      font-weight: 700;
      letter-spacing: 0.04em;
      padding: 10px 16px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.12);
      color: #fff;
    }

    .post__pill--dark {
      background: rgba(22, 54, 103, 0.12);
      color: #163667;
    }
  </style>

  <script>
    import { toJpeg } from 'html-to-image';

    const VERSION = document.querySelector('.studio')?.getAttribute('data-version') || 'v310';

    async function waitFonts() {
      if (document.fonts?.ready) await document.fonts.ready;
    }

    async function withExportScale(el: HTMLElement, run: () => Promise<string>) {
      const prev = el.style.transform;
      el.classList.add('is-exporting');
      el.style.transform = 'scale(1)';
      try {
        await waitFonts();
        await new Promise((r) => requestAnimationFrame(() => r(undefined)));
        return await run();
      } finally {
        el.style.transform = prev;
        el.classList.remove('is-exporting');
      }
    }

    function triggerDownload(dataUrl: string, filename: string) {
      const a = document.createElement('a');
      a.href = dataUrl;
      a.download = filename;
      a.click();
    }

    async function descargarArte(id: string, filename: string) {
      const el = document.getElementById(id);
      if (!el) throw new Error(`No existe #${id}`);

      const dataUrl = await withExportScale(el, async () =>
        toJpeg(el, {
          cacheBust: true,
          quality: 0.95,
          pixelRatio: 1,
          width: el.offsetWidth,
          height: el.offsetHeight,
          backgroundColor: '#ffffff',
        }),
      );

      triggerDownload(dataUrl, filename);
    }

    function initQuoteBgUpload() {
      const input = document.getElementById('quote-bg-input') as HTMLInputElement | null;
      const clearBtn = document.getElementById('quote-bg-clear');
      if (!input) return;

      const posts = () => document.querySelectorAll<HTMLElement>('.post--quote');

      const ensurePhotoLayer = (post: HTMLElement) => {
        let layer = post.querySelector<HTMLElement>('.post__photo');
        if (!layer) {
          layer = document.createElement('div');
          layer.className = 'post__photo';
          layer.setAttribute('aria-hidden', 'true');
          post.insertBefore(layer, post.firstChild);
        }
        return layer;
      };

      const applyPhoto = (dataUrl: string | null) => {
        posts().forEach((post) => {
          const layer = ensurePhotoLayer(post);
          if (dataUrl) {
            layer.style.backgroundImage = `url("${dataUrl}")`;
            post.classList.add('has-photo');
          } else {
            layer.style.backgroundImage = '';
            post.classList.remove('has-photo');
          }
        });
      };

      input.addEventListener('change', () => {
        const file = input.files?.[0];
        if (!file) return;
        if (!file.type.startsWith('image/')) {
          alert('Sube un archivo de imagen (JPG, PNG, WebP…).');
          input.value = '';
          return;
        }
        const reader = new FileReader();
        reader.onload = () => {
          if (typeof reader.result === 'string') applyPhoto(reader.result);
        };
        reader.onerror = () => {
          alert('No se pudo leer la imagen.');
        };
        reader.readAsDataURL(file);
      });

      clearBtn?.addEventListener('click', () => {
        applyPhoto(null);
        input.value = '';
      });
    }

    function initQuoteEditor() {
      const form = document.getElementById('quote-editor') as HTMLFormElement | null;
      if (!form) return;

      const sync = () => {
        const data = new FormData(form);
        const quote = String(data.get('quote') ?? '');
        const attr = String(data.get('attr') ?? '');
        const foot = String(data.get('foot') ?? '');

        document.querySelectorAll('[data-quote-text]').forEach((el) => {
          el.textContent = quote;
        });
        document.querySelectorAll('[data-quote-attr]').forEach((el) => {
          el.textContent = attr;
        });
        document.querySelectorAll('[data-quote-foot]').forEach((el) => {
          el.textContent = foot;
        });
      };

      form.addEventListener('input', sync);
      form.addEventListener('submit', (e) => e.preventDefault());
      sync();
    }

    function syncQuotePreviewScales() {
      document.querySelectorAll<HTMLElement>('.quote-preview').forEach((shell) => {
        const arte = shell.querySelector<HTMLElement>('.arte');
        if (!arte || arte.classList.contains('is-exporting')) return;
        const scale = shell.clientWidth / 1080;
        arte.style.transform = `scale(${scale})`;
      });
    }

    function initQuotePreviewScales() {
      const shells = document.querySelectorAll('.quote-preview');
      if (!shells.length) return;

      syncQuotePreviewScales();
      const ro = new ResizeObserver(() => syncQuotePreviewScales());
      shells.forEach((shell) => ro.observe(shell));
      window.addEventListener('resize', syncQuotePreviewScales);
    }

    document.querySelectorAll<HTMLButtonElement>('.btn-dl[data-dl]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.dl;
        const file = btn.dataset.file;
        if (!id || !file) return;
        const label = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Generando…';
        try {
          await descargarArte(id, file);
        } catch (err) {
          console.error(err);
          alert('No se pudo exportar. Revisa la consola.');
        } finally {
          btn.disabled = false;
          btn.textContent = label;
        }
      });
    });

    initQuoteEditor();
    initQuoteBgUpload();
    initQuotePreviewScales();

    (window as unknown as { descargarArte: (id: string) => Promise<void> }).descargarArte = async (id: string) => {
      const file =
        id === 'banner-linkedin'
          ? `${VERSION}-banner-linkedin.jpg`
          : `${VERSION}-${id}.jpg`;
      await descargarArte(id, file);
    };
  </script>
</BaseLayout>
