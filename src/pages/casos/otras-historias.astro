---
import BaseLayout from '@layouts/BaseLayout.astro';

const accent = '#00C8C4';
const ink = '#0B1220';

const vehicleScope = [
  'Coches',
  'Motocicletas',
  'Quads',
  'Embarcaciones',
  'Maquinaria de obra',
];

const scopeColors = ['#0B1220', '#0E6E6B', '#00A8A4', '#00C8C4', '#6FE3E1'];

const vehicleMarkets = [
  ['EE. UU.', 'Inicio en subastas, costa a costa.'],
  ['Asia', 'Japón, China y Taiwán.'],
  ['Europa', 'Alemania y Bélgica.'],
];

const musicLines = [
  'Música para empresas y jingles para campañas',
  'Marketing musical y distribución en plataformas de streaming',
  'Embajadores digitales e integración de agentes de IA',
];
---

<BaseLayout
  title="Otras historias: SmartWatch Pádel y más — Caso | Unicornio Azul"
  description="Casos adicionales de Unicornio Azul: SmartWatch Pádel, importación de vehículos desde 1994 y música / marketing digital. Más allá de los casos principales."
  image="/images/og-otras-historias.jpg"
  imageAlt="Otras historias: SmartWatch Pádel, vehículos y música | Unicornio Azul"
  showHeader={true}
>

<div class="otras-page overflow-x-clip">

<!-- HERO -->
<section class="relative md:min-h-[100svh] flex items-center overflow-hidden" style={`background:${accent};`}>
  <div class="w-full max-w-6xl mx-auto px-6 md:px-12 pt-10 md:pt-0 pb-8 md:pb-0">
    <div class="flex flex-col md:grid md:grid-cols-2 md:gap-10 lg:gap-16 md:items-center gap-6">
      <div data-reveal>
        <h1 class="reveal-item font-bold tracking-tight leading-[0.95] mb-4 md:mb-5 text-balance" style={`--i:0;font-family:'Space Grotesk',sans-serif;color:${ink};font-size:clamp(2.8rem,10vw,5.75rem);letter-spacing:-0.03em;`}>
          Otras historias
        </h1>
        <p class="reveal-item text-lg md:text-xl max-w-[40ch] leading-relaxed mb-0 md:mb-10" style={`--i:1;font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.72);`}>
          SmartWatch Pádel, importación de vehículos y una capa de música y marketing digital.
        </p>
        <!-- CTA — desktop -->
        <div class="reveal-item hidden md:flex flex-row flex-wrap items-center gap-x-5 gap-y-3" style="--i:2">
          <a href="/empezar" class="animated-btn animated-btn--otras" style={`position:relative;display:inline-flex;align-items:center;justify-content:center;height:52px;padding:0 48px 0 32px;font-size:15px;background-color:${ink};border-radius:4px;font-weight:600;font-family:'Satoshi',sans-serif;cursor:pointer;overflow:hidden;text-decoration:none;box-shadow:0 0.625em 1em 0 rgba(11,18,32,0.25);`}>
            <span class="text" style="position:relative;z-index:2;color:#FFFFFF;transition:transform 0.8s cubic-bezier(0.23,1,0.32,1),color 0.4s ease;">Cuéntanos tu proyecto</span>
            <svg class="arr-1" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;right:20px;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#FFFFFF" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <svg class="arr-2" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;left:-25%;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#FFFFFF" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <span class="circle" style={`position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:20px;height:20px;background-color:${accent};border-radius:50%;opacity:0;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);`}></span>
          </a>
          <nav class="flex flex-wrap items-center gap-x-5 gap-y-2" aria-label="Ir a cada historia">
            {[
              ['#smartwatch-padel', 'SmartWatch'],
              ['#vehiculos', 'Vehículos'],
              ['#musica', 'Música'],
            ].map(([href, label]) => (
              <a href={href} class="text-sm font-semibold no-underline" style={`font-family:'Satoshi',sans-serif;color:${ink};border-bottom:2px solid ${ink};padding-bottom:2px;`}>{label}</a>
            ))}
          </nav>
        </div>
      </div>

      <div class="relative flex items-center justify-center md:justify-end" data-reveal="side" data-reveal-from="right">
        <img
          src="/images/smartwatch-padelnof.png"
          alt="SmartWatch para pádel — pantalla de marcador"
          class="w-full max-w-[300px] md:max-w-[420px] h-auto object-contain mx-auto"
        />
      </div>

      <!-- CTA — mobile -->
      <div class="md:hidden flex flex-col items-stretch gap-4">
        <a href="/empezar" class="animated-btn animated-btn--otras" style={`position:relative;display:inline-flex;align-items:center;justify-content:center;height:60px;padding:0 56px 0 40px;font-size:17px;background-color:${ink};border-radius:4px;font-weight:600;font-family:'Satoshi',sans-serif;cursor:pointer;overflow:hidden;text-decoration:none;box-shadow:0 0.625em 1em 0 rgba(11,18,32,0.25);`}>
          <span class="text" style="position:relative;z-index:2;color:#FFFFFF;transition:transform 0.8s cubic-bezier(0.23,1,0.32,1),color 0.4s ease;">Cuéntanos tu proyecto</span>
          <svg class="arr-1" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;right:26px;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#FFFFFF" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <svg class="arr-2" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;left:-25%;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#FFFFFF" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <span class="circle" style={`position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:20px;height:20px;background-color:${accent};border-radius:50%;opacity:0;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);`}></span>
        </a>
        <nav class="flex flex-wrap gap-x-5 gap-y-3" aria-label="Ir a cada historia">
          {[
            ['#smartwatch-padel', 'SmartWatch'],
            ['#vehiculos', 'Vehículos'],
            ['#musica', 'Música'],
          ].map(([href, label]) => (
            <a href={href} class="text-base font-semibold no-underline" style={`font-family:'Satoshi',sans-serif;color:${ink};border-bottom:2px solid ${ink};padding-bottom:2px;`}>{label}</a>
          ))}
        </nav>
      </div>
    </div>
  </div>
</section>

<!-- SMARTWATCH PÁDEL -->
<article id="smartwatch-padel" class="padel-caso relative overflow-hidden" style="background:#FFFFFF;">
  <div class="relative z-10 max-w-6xl mx-auto px-6 md:px-12 py-14 md:py-24">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-stretch">

      <div data-reveal>
        <h2 class="reveal-item font-bold tracking-tight leading-[1.05] mb-8 md:mb-10 text-balance" style={`--i:0;font-family:'Space Grotesk',sans-serif;color:${ink};font-size:clamp(2.5rem,4vw,3rem);letter-spacing:-0.03em;`}>
          Del prototipo a la feria
        </h2>

        <div class="reveal-item space-y-6 md:space-y-7 max-w-[44ch]" style="--i:1">
          <div>
            <p class="text-xs font-semibold tracking-[0.14em] uppercase mb-1.5" style={`font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.45);`}>Reto</p>
            <p class="text-lg md:text-base leading-relaxed m-0" style={`font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.78);`}>
              Una empresa de desarrollo de prototipos para inventos nos contactó para ayudar en el desarrollo de un smartwatch para jugar al pádel. Por confidencialidad no aportamos mucho detalle.
            </p>
          </div>
          <div>
            <p class="text-xs font-semibold tracking-[0.14em] uppercase mb-1.5" style={`font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.45);`}>Qué hicimos</p>
            <p class="text-lg md:text-base leading-relaxed m-0" style={`font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.78);`}>
              Análisis para reducir costes de fabricación aprovechando desarrollos del mercado, filtrado de proveedores, negociación de la industrialización del prototipo y optimización de logística e importación.
            </p>
          </div>
          <div>
            <p class="text-xs font-semibold tracking-[0.14em] uppercase mb-1.5" style={`font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.45);`}>Resultado</p>
            <p class="text-lg md:text-base leading-relaxed m-0" style={`font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.78);`}>
              Producto presentado en la feria de Pádel de Barcelona. Actualmente en fase de test de prototipos de industrialización.
            </p>
          </div>
        </div>
      </div>

      <dl class="m-0 flex flex-col lg:h-full w-full max-w-[440px] mx-auto lg:mx-0 lg:ml-auto" aria-hidden="true" data-reveal>
        {[
          ['Proyecto', 'Smartwatch'],
          ['Trabajo', 'Industrialización'],
          ['Cadena', 'Importación'],
          ['Estado', 'En test'],
        ].map(([k, v], i) => (
          <div
            class="reveal-item flex-1 flex flex-col justify-center gap-2 py-5 md:py-6"
            style={`--i:${i};border-top:${i === 0 ? '2px' : '0'} solid rgba(11,18,32,0.14);border-bottom:2px ${i === 3 ? 'solid' : 'dotted'} rgba(11,18,32,0.14);`}
          >
            <dt class="m-0 text-xs font-semibold tracking-[0.14em] uppercase" style="font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.45);">{k}</dt>
            <dd class="m-0 font-bold tracking-tight leading-none" style={`font-family:'Space Grotesk',sans-serif;color:${ink};font-size:clamp(1.75rem,4vw,2.5rem);letter-spacing:-0.03em;`}>{v}</dd>
          </div>
        ))}
      </dl>

    </div>
  </div>
</article>

<!-- CORTE: hechos del caso -->
<section class="relative overflow-hidden" style={`background:${accent};`}>
  <div class="max-w-6xl mx-auto px-6 md:px-12 py-10 md:py-14" data-reveal>
    <div class="reveal-item grid md:grid-cols-2 gap-8 md:gap-12" style="--i:0">
      <div>
        <p class="m-0 mb-2 text-xs font-semibold tracking-[0.14em] uppercase" style={`font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.5);`}>Feria</p>
        <p class="m-0 text-xl md:text-2xl font-bold tracking-tight leading-snug" style={`font-family:'Space Grotesk',sans-serif;color:${ink};letter-spacing:-0.02em;`}>
          Presentado en la feria de Pádel de Barcelona
        </p>
      </div>
      <div>
        <p class="m-0 mb-2 text-xs font-semibold tracking-[0.14em] uppercase" style={`font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.5);`}>Ahora</p>
        <p class="m-0 text-xl md:text-2xl font-bold tracking-tight leading-snug" style={`font-family:'Space Grotesk',sans-serif;color:${ink};letter-spacing:-0.02em;`}>
          Fase de test de prototipos de industrialización
        </p>
      </div>
    </div>
  </div>
</section>

<!-- VEHÍCULOS -->
<section id="vehiculos" class="relative overflow-hidden" style="background:#FFFFFF;">
  <div class="max-w-6xl mx-auto px-6 md:px-12 pt-14 md:pt-24 pb-4 md:pb-5">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center mb-12 md:mb-16">
      <div data-reveal>
        <h2 class="reveal-item font-bold tracking-tight leading-[1.05] mb-4 max-w-[18ch] text-balance" style={`--i:0;font-family:'Space Grotesk',sans-serif;color:${ink};font-size:clamp(2.5rem,4vw,3.25rem);letter-spacing:-0.03em;`}>
          Importación de vehículos
        </h2>
        <p class="reveal-item text-lg max-w-[44ch] leading-relaxed mb-8 md:mb-10" style={`--i:1;font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.72);`}>
          Importación y gestión de compra internacional: logística, homologación y adaptación a normativa europea.
        </p>
        <div class="reveal-item space-y-6 max-w-[44ch]" style="--i:2">
          <div>
            <p class="text-xs font-semibold tracking-[0.14em] uppercase mb-1.5" style="font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.45);">Inicio</p>
            <p class="text-lg leading-relaxed m-0" style={`font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.78);`}>
              Septiembre de 1994: compra de 2 vehículos en EE. UU., aprendiendo logística, importación y lo más crítico — homologación y adaptación en España.
            </p>
          </div>
          <div>
            <p class="text-xs font-semibold tracking-[0.14em] uppercase mb-1.5" style="font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.45);">Base Miami</p>
            <p class="text-lg leading-relaxed m-0" style={`font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.78);`}>
              Desde 2002, base de operaciones en Miami con equipo de verificación, compra, consolidación y logística.
            </p>
          </div>
          <div>
            <p class="text-xs font-semibold tracking-[0.14em] uppercase mb-1.5" style="font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.45);">Homologación</p>
            <p class="text-lg leading-relaxed m-0" style={`font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.78);`}>
              Soluciones completas: conversión americana–europea de luces y adaptación a normativa europea para superar homologación e ITV.
            </p>
          </div>
        </div>
      </div>

      <div class="relative w-full max-w-[360px] md:max-w-[480px] mx-auto lg:ml-auto lg:mr-0" data-reveal="side" data-reveal-from="right">
        <img
          src="/images/vehiculos/1.png"
          alt="Vehículo importado — ejemplo de la actividad"
          class="w-full h-auto object-contain"
          loading="lazy"
        />
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-start" data-reveal>
      <div class="reveal-item" style="--i:0">
        <p class="text-xs font-semibold tracking-[0.14em] uppercase mb-4" style="font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.45);">Mercados</p>
        <ul class="m-0 p-0 list-none border-t" style="border-color:rgba(11,18,32,0.14);">
          {vehicleMarkets.map(([title, detail]) => (
            <li class="py-4 border-b" style="border-color:rgba(11,18,32,0.14);">
              <span class="block text-xl font-bold tracking-tight mb-1" style={`font-family:'Space Grotesk',sans-serif;color:${ink};`}>{title}</span>
              <span class="text-lg md:text-base" style="font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.65);">{detail}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal-item" style="--i:1">
        <p class="text-xs font-semibold tracking-[0.14em] uppercase mb-4" style="font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.45);">Alcance</p>

        <div class="flex flex-col items-center sm:items-start sm:flex-row sm:items-center gap-6 md:gap-8">
          <div class="relative shrink-0 w-[160px] h-[160px] md:w-[180px] md:h-[180px]" aria-hidden="true">
            <svg viewBox="0 0 200 200" class="w-full h-full" style="transform:rotate(-90deg);">
              <circle cx="100" cy="100" r="70" fill="none" stroke="rgba(11,18,32,0.08)" stroke-width="18" />
              {scopeColors.map((c, i) => (
                <circle
                  class="dial-arc"
                  cx="100"
                  cy="100"
                  r="70"
                  fill="none"
                  stroke={c}
                  stroke-width="18"
                  stroke-dasharray="76 364"
                  stroke-dashoffset={`${-88 * i}`}
                  style={`--i:${i};`}
                />
              ))}
            </svg>
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="font-bold tracking-tight" style={`font-family:'Space Grotesk',sans-serif;color:${ink};font-size:2.25rem;letter-spacing:-0.03em;`}>5</span>
            </div>
          </div>

          <ul class="m-0 p-0 list-none flex flex-col gap-2.5 w-full sm:w-auto">
            {vehicleScope.map((label, i) => (
              <li class="flex items-center gap-3 text-lg md:text-base font-semibold" style={`font-family:'Satoshi',sans-serif;color:${ink};`}>
                <span class="shrink-0" style={`width:12px;height:12px;background:${scopeColors[i]};display:inline-block;`}></span>
                {label}
              </li>
            ))}
          </ul>
        </div>

        <p class="mt-6 text-lg md:text-base leading-relaxed m-0 max-w-[36ch]" style="font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.65);">
          En la fase inicial, viajes mensuales a EE. UU. para comprar en subastas; después ampliación a Asia y a la UE.
        </p>
      </div>
    </div>
  </div>

  <!-- Galería vehículos — marquee en ciclo continuo -->
  <div class="w-full overflow-hidden pb-14 md:pb-24">
    <div class="vehicle-marquee flex w-max" aria-hidden="true">
      {[0, 1].map(() => (
        <div class="vehicle-marquee__set flex shrink-0">
          {[2, 3, 4, 5, 6, 7, 8, 9, 10].map((n) => (
            <img
              src={`/images/vehiculos/${n}.png`}
              alt=""
              class="vehicle-marquee__img shrink-0 object-cover"
              loading="eager"
              decoding="async"
              draggable="false"
            />
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- MÚSICA -->
<section id="musica" class="relative overflow-hidden" style={`background:${ink};`}>
  <div class="max-w-6xl mx-auto px-6 md:px-12 py-14 md:py-24" data-reveal>
    <div class="reveal-item flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16" style="--i:0">
      <h2 class="font-bold tracking-tight leading-[1.05] m-0 max-w-[14ch] text-balance" style={`font-family:'Space Grotesk',sans-serif;color:#FFFFFF;font-size:clamp(2.5rem,4vw,3.25rem);letter-spacing:-0.03em;`}>
        Música y capa digital
      </h2>
      <p class="text-lg max-w-[32ch] leading-relaxed m-0 md:text-right" style="font-family:'Satoshi',sans-serif;color:rgba(255,255,255,0.55);">
        Además del producto físico: música para empresas, marketing musical y embajadores digitales.
      </p>
    </div>
    <div class="reveal-item grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10" style="--i:1">
      {musicLines.map((line, i) => (
        <div class="border-t pt-5" style="border-color:rgba(255,255,255,0.14);">
          <p class="m-0 mb-3 text-sm font-semibold tabular-nums" style={`font-family:'Satoshi',sans-serif;color:${accent};`}>{String(i + 1).padStart(2, '0')}</p>
          <p class="m-0 text-xl md:text-2xl font-bold tracking-tight leading-snug" style="font-family:'Space Grotesk',sans-serif;color:#FFFFFF;">{line}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CIERRE -->
<section id="cierre" class="relative overflow-hidden" style={`background:${accent};`}>
  <div class="max-w-6xl mx-auto px-6 md:px-12 py-14 md:py-24" data-reveal>
    <h2 class="reveal-item font-bold tracking-tight leading-[0.95] mb-8 md:mb-10 text-balance" style={`--i:0;font-family:'Space Grotesk',sans-serif;color:${ink};font-size:clamp(2.8rem,12vw,5rem);letter-spacing:-0.04em;`}>
      Otras historias
    </h2>
    <div class="reveal-item grid md:grid-cols-2 gap-8 md:gap-16 items-end border-t pt-8 md:pt-10" style={`--i:1;border-color:rgba(11,18,32,0.2);`}>
      <p class="text-lg md:text-xl leading-relaxed m-0 max-w-[36ch]" style={`font-family:'Satoshi',sans-serif;color:rgba(11,18,32,0.72);`}>
        ¿Tu proyecto encaja aquí o con un caso principal? Cuéntanoslo.
      </p>
      <!-- CTA desktop -->
      <div class="hidden md:flex flex-row justify-end items-start">
        <a href="/empezar" class="animated-btn animated-btn--otras" style={`position:relative;display:inline-flex;align-items:center;justify-content:center;height:52px;padding:0 48px 0 32px;font-size:15px;background-color:${ink};border-radius:4px;font-weight:600;font-family:'Satoshi',sans-serif;cursor:pointer;overflow:hidden;text-decoration:none;box-shadow:0 0.625em 1em 0 rgba(11,18,32,0.25);`}>
          <span class="text" style="position:relative;z-index:2;color:#FFFFFF;transition:transform 0.8s cubic-bezier(0.23,1,0.32,1),color 0.4s ease;">Cuéntanos tu proyecto</span>
          <svg class="arr-1" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;right:20px;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#FFFFFF" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <svg class="arr-2" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;left:-25%;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#FFFFFF" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <span class="circle" style={`position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:20px;height:20px;background-color:${accent};border-radius:50%;opacity:0;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);`}></span>
        </a>
      </div>
      <!-- CTA mobile -->
      <div class="md:hidden flex flex-col items-stretch">
