---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Casos de éxito — Unicornio Azul"
  description="Proyectos reales de desarrollo de negocio, creación de marcas propias y escalado digital. Resultados, no promesas."
  showHeader={true}
>

<!-- ═════════════════════════════════════════
HERO — limpio, sin decoración
═════════════════════════════════════════ -->
<section class="text-center px-6 md:px-12 pt-20 pb-10 md:pt-32 md:pb-16" style="background:#FFFFFF;">
  <h1 class="leading-[0.92] tracking-tight mb-4" style="color:#1A1A1A;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(2.6rem,7vw,5rem);">
    Casos de éxito
  </h1>
  <p class="text-lg max-w-[38ch] mx-auto leading-relaxed" style="color:#6B7280;font-family:'Satoshi',sans-serif;">
    No contamos lo que hacemos.<br>Mostramos lo que hemos conseguido.
  </p>
</section>

<!-- ═════════════════════════════════════════
CASO 01 — Número gigante de fondo + tarjeta
═════════════════════════════════════════ -->
<section class="relative px-6 md:px-12 py-16 md:py-28" style="background:#0A1628;">

  <span class="absolute select-none pointer-events-none z-0" style="top:-0.15em;left:0;font-family:'Space Grotesk',sans-serif;font-weight:900;font-size:clamp(14rem,28vw,26rem);line-height:1;color:rgba(255,255,255,0.02);">01</span>

  <div class="relative z-10 max-w-3xl mx-auto">
    <span class="inline-block text-xs font-semibold tracking-[0.15em] uppercase px-3 py-1.5 rounded-full mb-6" style="background:rgba(15,37,72,0.5);color:#A8D8EA;font-family:'Satoshi',sans-serif;">Desarrollo de negocio</span>

    <div class="flex items-baseline gap-4 mb-6">
      <span class="text-5xl md:text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:#A8D8EA;">3×</span>
      <span class="text-base md:text-lg leading-snug" style="color:rgba(255,255,255,0.5);font-family:'Satoshi',sans-serif;">retorno sobre<br>la inversión</span>
    </div>

    <h3 class="text-xl md:text-2xl font-bold mb-8 leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#ffffff;">
      De una idea en servilleta a una marca vendiendo en Amazon Europa
    </h3>

    <div class="grid md:grid-cols-3 gap-6">
      <div>
        <p class="text-xs font-semibold tracking-[0.12em] uppercase mb-2" style="color:rgba(255,255,255,0.35);font-family:'Satoshi',sans-serif;">Problema</p>
        <p class="text-sm leading-relaxed" style="color:rgba(255,255,255,0.55);font-family:'Satoshi',sans-serif;">Emprendedor con idea de producto para el hogar, sin experiencia en fabricación ni venta online. No sabía por dónde empezar.</p>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-[0.12em] uppercase mb-2" style="color:rgba(255,255,255,0.35);font-family:'Satoshi',sans-serif;">Solución</p>
        <p class="text-sm leading-relaxed" style="color:rgba(255,255,255,0.55);font-family:'Satoshi',sans-serif;">Validación de mercado, fabricante en Asia, desarrollo de producto, marca desde cero y lanzamiento en Amazon ES, DE y FR.</p>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-[0.12em] uppercase mb-2" style="color:rgba(255,255,255,0.35);font-family:'Satoshi',sans-serif;">Resultado</p>
        <p class="text-sm leading-relaxed" style="color:rgba(255,255,255,0.55);font-family:'Satoshi',sans-serif;">Marca en 3 mercados europeos. Rentable desde el sexto mes. +200K€ en ventas el primer año.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═════════════════════════════════════════
CASO 02
═════════════════════════════════════════ -->
<section class="relative px-6 md:px-12 py-16 md:py-28" style="background:#FFFFFF;">

  <span class="absolute select-none pointer-events-none z-0" style="top:-0.15em;right:0;font-family:'Space Grotesk',sans-serif;font-weight:900;font-size:clamp(14rem,28vw,26rem);line-height:1;color:rgba(22,54,103,0.03);">02</span>

  <div class="relative z-10 max-w-3xl mx-auto">
    <span class="inline-block text-xs font-semibold tracking-[0.15em] uppercase px-3 py-1.5 rounded-full mb-6" style="background:rgba(0,105,141,0.1);color:#00698D;font-family:'Satoshi',sans-serif;">Producto y compras</span>

    <div class="flex items-baseline gap-4 mb-6">
      <span class="text-5xl md:text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:#00698D;">+240%</span>
      <span class="text-base md:text-lg leading-snug" style="color:#6B7280;font-family:'Satoshi',sans-serif;">incremento en<br>margen neto</span>
    </div>

    <h3 class="text-xl md:text-2xl font-bold mb-8 leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
      Relocalización de fabricación y optimización de costes para marca de cosmética
    </h3>

    <div class="grid md:grid-cols-3 gap-6">
      <div>
        <p class="text-xs font-semibold tracking-[0.12em] uppercase mb-2" style="color:rgba(0,0,0,0.3);font-family:'Satoshi',sans-serif;">Problema</p>
        <p class="text-sm leading-relaxed" style="color:#6B7280;font-family:'Satoshi',sans-serif;">Marca española de cosmética natural con márgenes ajustados por un único proveedor caro que bloqueaba el crecimiento.</p>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-[0.12em] uppercase mb-2" style="color:rgba(0,0,0,0.3);font-family:'Satoshi',sans-serif;">Solución</p>
        <p class="text-sm leading-relaxed" style="color:#6B7280;font-family:'Satoshi',sans-serif;">Sourcing de 3 fabricantes en Asia, negociación, supervisión de producción, control de calidad y certificaciones CE.</p>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-[0.12em] uppercase mb-2" style="color:rgba(0,0,0,0.3);font-family:'Satoshi',sans-serif;">Resultado</p>
        <p class="text-sm leading-relaxed" style="color:#6B7280;font-family:'Satoshi',sans-serif;">−40% coste unitario. Margen neto del 22% al 53%. Escalaron producción sin perder calidad.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═════════════════════════════════════════
CASO 03
═════════════════════════════════════════ -->
<section class="relative px-6 md:px-12 py-16 md:py-28" style="background:#F2F5F8;">

  <span class="absolute select-none pointer-events-none z-0" style="top:-0.15em;left:0;font-family:'Space Grotesk',sans-serif;font-weight:900;font-size:clamp(14rem,28vw,26rem);line-height:1;color:rgba(22,54,103,0.04);">03</span>

  <div class="relative z-10 max-w-3xl mx-auto">
    <span class="inline-block text-xs font-semibold tracking-[0.15em] uppercase px-3 py-1.5 rounded-full mb-6" style="background:rgba(0,136,179,0.1);color:#0088B3;font-family:'Satoshi',sans-serif;">Canales digitales y escalado</span>

    <div class="flex items-baseline gap-4 mb-6">
      <span class="text-5xl md:text-6xl font-black leading-none tracking-tighter" style="font-family:'Space Grotesk',sans-serif;color:#0088B3;">500K</span>
      <span class="text-base md:text-lg leading-snug" style="color:#6B7280;font-family:'Satoshi',sans-serif;">€ en ventas<br>primer año</span>
    </div>

    <h3 class="text-xl md:text-2xl font-bold mb-8 leading-tight" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">
      Expansión de marca de accesorios a 5 marketplaces europeos
    </h3>

    <div class="grid md:grid-cols-3 gap-6">
      <div>
        <p class="text-xs font-semibold tracking-[0.12em] uppercase mb-2" style="color:rgba(0,0,0,0.3);font-family:'Satoshi',sans-serif;">Problema</p>
        <p class="text-sm leading-relaxed" style="color:#6B7280;font-family:'Satoshi',sans-serif;">Marca de accesorios de moda vendiendo solo en España vía web propia. Quería Europa pero no sabía cómo.</p>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-[0.12em] uppercase mb-2" style="color:rgba(0,0,0,0.3);font-family:'Satoshi',sans-serif;">Solución</p>
        <p class="text-sm leading-relaxed" style="color:#6B7280;font-family:'Satoshi',sans-serif;">Amazon Seller Central en ES, DE, FR, IT y UK. Listings, A+ Content, Brand Registry y campañas.</p>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-[0.12em] uppercase mb-2" style="color:rgba(0,0,0,0.3);font-family:'Satoshi',sans-serif;">Resultado</p>
        <p class="text-sm leading-relaxed" style="color:#6B7280;font-family:'Satoshi',sans-serif;">+500K€ primer año. 5 marketplaces con FBA. Marca registrada en Amazon Brand Registry.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═════════════════════════════════════════
CTA FINAL — mismo que index, solo cambia el copy
═════════════════════════════════════════ -->
<section class="relative flex flex-col md:flex-row items-center justify-center gap-12 md:gap-20 px-6 md:px-12 py-12 md:py-32" style="background:#FFFFFF;">
  <div class="text-center md:text-left max-w-lg">
    <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.05]" style="font-family:'Space Grotesk',sans-serif;color:#1A1A1A;">Cada caso empieza<br>con una<br>conversación</h2>
    <p class="mt-6 text-base md:text-lg leading-relaxed" style="color:#6B7280;font-family:'Satoshi',sans-serif;">Si tienes un proyecto, una idea o un negocio que quieres llevar al siguiente nivel, hablemos. Sin compromiso.</p>
    <div class="mt-8">
      <a href="/empezar" class="animated-btn" style="position:relative;display:inline-flex;align-items:center;justify-content:center;height:56px;padding:0 52px 0 36px;font-size:16px;background-color:#0F2548;border-radius:4px;font-weight:600;font-family:'Satoshi',sans-serif;color:#ffffff;cursor:pointer;overflow:hidden;text-decoration:none;box-shadow:0 0.625em 1.2em 0 rgba(15,37,72,0.2);">
        <span class="text" style="position:relative;z-index:2;transition:transform 0.8s cubic-bezier(0.23,1,0.32,1);">Cuéntanos tu proyecto</span>
        <svg class="arr-1" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;right:22px;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#ffffff" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        <svg class="arr-2" style="position:absolute;top:50%;margin-top:-10px;width:20px;height:20px;z-index:2;left:-25%;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);" fill="none" stroke="#ffffff" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        <span class="circle" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:20px;height:20px;background-color:#00698D;border-radius:50%;opacity:0;transition:all 0.8s cubic-bezier(0.23,1,0.32,1);"></span>
      </a>
    </div>
  </div>
  <div class="grid grid-cols-2 gap-6 md:gap-8 shrink-0">
    <svg viewBox="0 0 100 100" class="w-20 h-20 md:w-24 md:h-24"><path d="M50 8 Q50 50 92 50 Q50 50 50 92 Q50 50 8 50 Q50 50 50 8Z" fill="#0F2548" opacity="0.8"/></svg>
    <svg viewBox="0 0 100 100" class="w-20 h-20 md:w-24 md:h-24"><rect x="8" y="8" width="84" height="84" rx="3" fill="#163667" opacity="0.8"/></svg>
    <svg viewBox="0 0 100 100" class="w-20 h-20 md:w-24 md:h-24"><circle cx="50" cy="50" r="42" fill="#0B4F7A" opacity="0.8"/></svg>
    <svg viewBox="0 0 100 100" class="w-20 h-20 md:w-24 md:h-24"><polygon points="50,4 96,96 4,96" fill="#00698D" opacity="0.8"/></svg>
  </div>
</section>

<!-- ═════════════════════════════════════════
FOOTER
═════════════════════════════════════════ -->
<footer style="background:#0F2548;font-family:'Satoshi',sans-serif;">
  <div class="max-w-6xl mx-auto px-6 md:px-12 py-14 md:py-20">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
      <div class="col-span-2 md:col-span-1 flex flex-col gap-4">
        <div class="bg-white rounded-xl p-3 inline-flex"><img src="/images/logo-marino.png" alt="Unicornio Azul" class="h-6 w-auto" /></div>
        <p class="text-sm leading-relaxed" style="color:rgba(255,255,255,0.5);">Soluciones reales para ideas extraordinarias.</p>
        <a href="mailto:hola@unicornioazul.com" class="text-sm font-medium hover:underline" style="color:rgba(255,255,255,0.65);">hola@unicornioazul.com</a>
        <div class="flex gap-4">
          <a href="https://linkedin.com" target="_blank" rel="noopener" class="text-sm font-medium hover:underline" style="color:rgba(255,255,255,0.55);">LinkedIn</a>
          <a href="https://instagram.com" target="_blank" rel="noopener" class="text-sm font-medium hover:underline" style="color:rgba(255,255,255,0.55);">Instagram</a>
        </div>
      </div>
      <div class="flex flex-col gap-3">
        <p class="text-sm font-semibold tracking-tight mb-1" style="color:rgba(255,255,255,0.8);">Qué hacemos</p>
        <a href="/que-hacemos/desarrollo-de-negocios" class="text-sm hover:underline" style="color:rgba(255,255,255,0.5);">Desarrollo de negocio</a>
        <a href="/que-hacemos/producto-compras-internacionales" class="text-sm hover:underline" style="color:rgba(255,255,255,0.5);">Producto y compras</a>
        <a href="/que-hacemos/marketing-digital" class="text-sm hover:underline" style="color:rgba(255,255,255,0.5);">Marketing digital</a>
        <a href="/que-hacemos/canales-digitales-escalado" class="text-sm hover:underline" style="color:rgba(255,255,255,0.5);">Canales y escalado</a>
      </div>
      <div class="flex flex-col gap-3">
        <p class="text-sm font-semibold tracking-tight mb-1" style="color:rgba(255,255,255,0.8);">Cómo trabajamos</p>
        <a href="/como-trabajamos#proceso" class="text-sm hover:underline" style="color:rgba(255,255,255,0.5);">Proceso 5 pasos</a>
        <a href="/metodologia-sorie" class="text-sm hover:underline" style="color:rgba(255,255,255,0.5);">Metodología SORIE&trade;</a>
        <a href="/casos" class="text-sm hover:underline" style="color:rgba(255,255,255,0.5);">Casos de éxito</a>
      </div>
      <div class="flex flex-col gap-3">
        <p class="text-sm font-semibold tracking-tight mb-1" style="color:rgba(255,255,255,0.8);">Sobre nosotros</p>
        <a href="/sobre-nosotros" class="text-sm hover:underline" style="color:rgba(255,255,255,0.5);">Quiénes somos</a>
        <a href="/contacto" class="text-sm hover:underline" style="color:rgba(255,255,255,0.5);">Contacto</a>
      </div>
    </div>
    <div class="mt-12 pt-8 border-t flex flex-col md:flex-row justify-between gap-4" style="border-color:rgba(255,255,255,0.08);">
      <p class="text-xs" style="color:rgba(255,255,255,0.35);">&copy; 2026 Unicornio Azul. Todos los derechos reservados.</p>
      <p class="text-xs" style="color:rgba(255,255,255,0.25);">Madrid, España</p>
    </div>
  </div>
</footer>

</BaseLayout>
