<style>
  .caso-bg-num {
    position: absolute;
    z-index: 0;
    top: -0.15em;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 900;
    font-size: clamp(14rem, 28vw, 26rem);
    line-height: 1;
  }
  .caso-bg-num--left { left: 0; }
  .caso-bg-num--right { right: 0; }

  .caso-link {
    transition: opacity 0.25s ease, gap 0.25s ease;
  }
  .caso-link:hover {
    opacity: 0.7;
    gap: 0.65rem;
  }

  /* Vertical pipeline diagram — scroll fill */
  .pipeline {
    position: relative;
  }
  .pipeline-track {
    position: absolute;
    left: 16px;
    top: calc(1.45rem + 16px);
    bottom: calc(1.45rem + 16px);
    width: 3px;
    background: rgba(15, 37, 72, 0.08);
    transform: translateX(-50%);
    z-index: 0;
  }
  .pipeline-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform-origin: top;
    transform: scaleY(0);
    background: linear-gradient(to bottom, #0F2548, #163667, #0B4F7A, #00698D, #0088B3);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pipeline-step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.45rem 0;
    list-style: none;
    z-index: 1;
  }
  .pipeline-dot {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    flex-shrink: 0;
    border: 3px solid var(--c);
    background: #FFFFFF;
    box-sizing: border-box;
    transition: background 0.45s ease, border-color 0.45s ease;
  }
  .pipeline-label {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--c);
  }

  /* Ascending stair diagram (padel) — bar grows from the right */
  .stair {
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: flex-end;
  }
  .stair-step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    width: var(--w);
    min-height: 4.25rem;
    padding: 1rem 1.35rem;
    background: transparent;
    list-style: none;
    isolation: isolate;
  }
  .stair-step::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--c);
    transform-origin: right center;
    z-index: -1;
  }
  .stair-num {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.45);
    flex-shrink: 0;
  }
  .stair-label {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(1.2rem, 2.8vw, 1.55rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: #ffffff;
  }

  .caso-block { transform: none; }
  @media (prefers-reduced-motion: no-preference) {
    .caso-block {
      transform: translateY(20px);
      transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .caso-block.is-in { transform: translateY(0); }

    .pipeline-step {
      opacity: 1;
      transform: none;
    }

    .stair-step::before {
      transform: scaleX(0.22);
      transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: calc(var(--i, 0) * 120ms);
    }
    .stair-step .stair-num,
    .stair-step .stair-label {
      opacity: 0;
      transform: translateX(12px);
      transition:
        opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: calc(var(--i, 0) * 120ms + 200ms);
    }
    .stair-step.is-on::before,
    .caso-block.is-in .stair-step::before {
      transform: scaleX(1);
    }
    .stair-step.is-on .stair-num,
    .stair-step.is-on .stair-label,
    .caso-block.is-in .stair-step .stair-num,
    .caso-block.is-in .stair-step .stair-label {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stair-step::before { transform: none; background: var(--c); }
  }

  /* Caso 02 — aranceles + SORIE */
  .arancel-stat,
  .arancel-arrow,
  .sorie-letter,
  .arancel-caption {
    transition:
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (prefers-reduced-motion: no-preference) {
    .arancel-stat {
      opacity: 0;
      transform: translateY(16px);
      transition-delay: calc(var(--i, 0) * 120ms);
    }
    .arancel-arrow {
      opacity: 0;
      transform: translateX(-10px);
      transition-delay: 0.18s;
    }
    .arancel-arrow svg path {
      stroke-dasharray: 60;
      stroke-dashoffset: 60;
      transition: stroke-dashoffset 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.28s;
    }
    .arancel-label {
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: calc(var(--i, 0) * 120ms + 0.35s);
    }
    .sorie-letter {
      opacity: 0;
      transform: translateY(18px);
      transition-delay: calc(0.55s + var(--i, 0) * 90ms);
    }
    .arancel-caption {
      opacity: 0;
      transform: translateY(8px);
      transition-delay: 1.05s;
    }
    .arancel-sorie.is-on .arancel-stat,
    .arancel-sorie.is-on .arancel-arrow,
    .arancel-sorie.is-on .arancel-label,
    .arancel-sorie.is-on .sorie-letter,
    .arancel-sorie.is-on .arancel-caption {
      opacity: 1;
      transform: none;
    }
    .arancel-sorie.is-on .arancel-arrow {
      opacity: 0.5;
    }
    .arancel-sorie.is-on .arancel-arrow svg path {
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  (function () {
    const blocks = document.querySelectorAll('.caso-block');
    const stairs = document.querySelectorAll('[data-stair-step]');
    const arancelBlocks = document.querySelectorAll('[data-arancel-sorie]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function easeOutCubic(t) {
      return 1 - Math.pow(1 - t, 3);
    }

    function animateCount(el, to, suffix, duration) {
      const start = performance.now();
      function frame(now) {
        const t = Math.min(1, (now - start) / duration);
        const value = Math.round(easeOutCubic(t) * to);
        el.textContent = value + suffix;
        if (t < 1) requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    }

    function runArancel(root) {
      root.classList.add('is-on');
      if (reduce) {
        root.querySelectorAll('[data-count-to]').forEach((el) => {
          el.textContent = el.dataset.countTo + (el.dataset.countSuffix || '');
        });
        return;
      }
      root.querySelectorAll('[data-count-to]').forEach((el, i) => {
        const to = Number(el.dataset.countTo) || 0;
        const suffix = el.dataset.countSuffix || '';
        setTimeout(() => animateCount(el, to, suffix, i === 0 ? 700 : 1100), i === 0 ? 80 : 220);
      });
    }

    if (reduce) {
      blocks.forEach((el) => el.classList.add('is-in'));
      stairs.forEach((el) => el.classList.add('is-on'));
      arancelBlocks.forEach((el) => runArancel(el));
      return;
    }

    if (blocks.length) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );
      blocks.forEach((el) => io.observe(el));
    }

    if (stairs.length) {
      const stairIo = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-on');
              stairIo.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.35, rootMargin: '0px 0px -12% 0px' }
      );
      stairs.forEach((el) => stairIo.observe(el));
    }

    if (arancelBlocks.length) {
      const arancelIo = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              runArancel(entry.target);
              arancelIo.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.35, rootMargin: '0px 0px -10% 0px' }
      );
      arancelBlocks.forEach((el) => arancelIo.observe(el));
    }
  })();
</script>

