<style>
  .caso-bg-num {
    position: absolute;
    z-index: 0;
    top: -0.15em;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 900;
    font-size: clamp(14rem, 28vw, 26rem);
    line-height: 1;
  }
  .caso-bg-num--left { left: 0; }
  .caso-bg-num--right { right: 0; }

  .caso-link {
    transition: opacity 0.25s ease, gap 0.25s ease;
  }
  .caso-link:hover {
    opacity: 0.7;
    gap: 0.65rem;
  }

  /* Vertical pipeline diagram */
  .pipeline-step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.45rem 0;
    list-style: none;
  }
  .pipeline-step:not(.pipeline-step--last)::after {
    content: '';
    position: absolute;
    left: 15px;
    top: calc(50% + 18px);
    bottom: -18px;
    width: 3px;
    background: var(--c);
  }
  .pipeline-dot {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--c);
  }
  .pipeline-label {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--c);
  }

  /* Ascending stair diagram (padel) */
  .stair {
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: flex-end;
  }
  .stair-step {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: var(--w);
    min-height: 4.25rem;
    padding: 1rem 1.35rem;
    background: var(--c);
    list-style: none;
  }
  .stair-num {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.45);
    flex-shrink: 0;
  }
  .stair-label {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(1.2rem, 2.8vw, 1.55rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: #ffffff;
  }

  .caso-block { transform: none; }
  @media (prefers-reduced-motion: no-preference) {
    .caso-block {
      transform: translateY(20px);
      transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .caso-block.is-in { transform: translateY(0); }

    .pipeline-step {
      opacity: 0.35;
      transform: translateX(12px);
      transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .caso-block.is-in .pipeline-step {
      opacity: 1;
      transform: translateX(0);
    }
    .caso-block.is-in .pipeline-step:nth-child(1) { transition-delay: 0.08s; }
    .caso-block.is-in .pipeline-step:nth-child(2) { transition-delay: 0.16s; }
    .caso-block.is-in .pipeline-step:nth-child(3) { transition-delay: 0.24s; }
    .caso-block.is-in .pipeline-step:nth-child(4) { transition-delay: 0.32s; }
    .caso-block.is-in .pipeline-step:nth-child(5) { transition-delay: 0.4s; }

    .stair-step {
      opacity: 0.35;
      transform: translateX(16px);
      transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .caso-block.is-in .stair-step {
      opacity: 1;
      transform: translateX(0);
    }
    .caso-block.is-in .stair-step:nth-child(1) { transition-delay: 0.08s; }
    .caso-block.is-in .stair-step:nth-child(2) { transition-delay: 0.16s; }
    .caso-block.is-in .stair-step:nth-child(3) { transition-delay: 0.24s; }
    .caso-block.is-in .stair-step:nth-child(4) { transition-delay: 0.32s; }
  }
</style>

<script>
  (function () {
    const blocks = document.querySelectorAll('.caso-block');
    if (!blocks.length) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      blocks.forEach((el) => el.classList.add('is-in'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );
    blocks.forEach((el) => io.observe(el));
  })();
</script>

