---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Así es como trabajamos — Unicornio Azul"
  description="No trabajamos con promesas ni fórmulas milagro. En Unicornio Azul seguimos un proceso claro de 5 pasos: análisis, producto, marca, ventas y escalado."
  showHeader={true}
>

<!-- ═════════════════════════════════════════
HERO — Cómo trabajamos
midnight #0A1628 · proceso editorial
═════════════════════════════════════════ -->
<section class="relative overflow-hidden md:min-h-[60dvh] flex items-center" style="background: linear-gradient(to right, #0F2548 0%, #0F2548 20%, #163667 20%, #163667 40%, #0B4F7A 40%, #0B4F7A 60%, #00698D 60%, #00698D 80%, #0088B3 80%, #0088B3 100%);">

  <!-- Fondo geométrico — líneas y puntos conectados (proceso / ruta) -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none z-0" viewBox="0 0 1440 700" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <!-- Línea horizontal punteada — como un timeline -->
    <line x1="120" y1="350" x2="1320" y2="350" stroke="#ffffff" stroke-width="1" stroke-dasharray="4,12" opacity="0.08"/>
    <!-- Nodos en la línea -->
    <circle cx="120" cy="350" r="4" fill="#ffffff" opacity="0.12"/>
    <circle cx="420" cy="350" r="4" fill="#ffffff" opacity="0.12"/>
    <circle cx="720" cy="350" r="4" fill="#ffffff" opacity="0.12"/>
    <circle cx="1020" cy="350" r="4" fill="#ffffff" opacity="0.12"/>
    <circle cx="1320" cy="350" r="4" fill="#ffffff" opacity="0.12"/>
    <!-- Estrella decorativa top-right -->
    <g transform="translate(1340, 80) scale(1.2)" opacity="0.06">
      <path d="M0 -20 Q0 0 20 0 Q0 0 0 20 Q0 0 -20 0 Q0 0 0 -20Z" fill="#ffffff"/>
    </g>
  </svg>

  <div class="relative z-10 w-full max-w-4xl mx-auto px-6 md:px-12 py-20 md:py-28 text-center">
    <h1 class="leading-[0.92] tracking-tight mb-6" style="color:#ffffff;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(2.8rem,8vw,5.5rem);">
      Así es como<br>trabajamos
    </h1>
    <p class="text-lg md:text-xl max-w-[48ch] mx-auto leading-relaxed" style="color:rgba(255,255,255,0.5);font-family:'Satoshi',sans-serif;">
      No trabajamos con promesas ni fórmulas milagro. Trabajamos con procesos claros, experiencia real y visión a medio y largo plazo.
    </p>
  </div>
</section>

<!-- ═════════════════════════════════════════
PROCESO — 5 pasos · Timeline vertical
═════════════════════════════════════════ -->
