        </div>
        <div class="absolute left-1/2 -translate-x-1/2 mt-2">
          <div class="nodo-paso w-4 h-4 rounded-full border-2 transition-colors duration-500" data-paso="1" style="background:#FFFFFF;border-color:#163667;"></div>
