<!-- Timeline scroll animation — círculos se llenan + línea crece / decrece -->
<script>
  (function () {
    const nodos = document.querySelectorAll('.nodo-paso');
    const contenedores = document.querySelectorAll('.paso-container');
    const linea = document.getElementById('linea-relleno');
    if (!nodos.length || !linea) return;

    const activos = new Set<number>();

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const idx = Number((entry.target as HTMLElement).dataset.paso);
        if (entry.isIntersecting) {
          activos.add(idx);
        } else {
          activos.delete(idx);
        }
      }
      const maxActivo = activos.size > 0 ? Math.max(...activos) : 0;

      nodos.forEach((n, i) => {
        const paso = i + 1;
        if (paso <= maxActivo) {
          (n as HTMLElement).style.background = '#163667';
          (n as HTMLElement).style.borderColor = '#163667';
        } else {
          (n as HTMLElement).style.background = '#FFFFFF';
          (n as HTMLElement).style.borderColor = '#163667';
        }
      });
      linea.style.height = ((maxActivo / nodos.length) * 100) + '%';
    }, { threshold: 0, rootMargin: "-30% 0px -30% 0px" });

    contenedores.forEach(c => observer.observe(c));
  })();
</script>

<!-- Mobile scroll indicator script -->
<script>
  (function () {
    const scroller = document.querySelector('.overflow-x-auto');
    const dots = document.querySelectorAll('#proceso-dots span');
    if (scroller && dots.length) {
      scroller.addEventListener('scroll', () => {
        const step = (scroller.scrollWidth - scroller.clientWidth) / (dots.length - 1);
        const idx = Math.round(scroller.scrollLeft / (step || 1));
        const clamped = Math.min(idx, dots.length - 1);
        dots.forEach((d, i) => {
          (d as HTMLElement).style.background = i === clamped ? '#163667' : 'rgba(22,54,103,0.2)';
        });
      }, { passive: true });
    }
  })();
</script>

